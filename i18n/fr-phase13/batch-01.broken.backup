    {
      "id": "ai-tool-validation-for-education",
      "canonicalUri": "https://id.i2idl.org/concepts/ai-tool-validation-for-education",
      "en": {
        "prefLabel": "AI tool validation for education",
        "definition": "The systematic evaluation of an AI system or tool before educational adoption to determine whether it is sufficiently reliable, trustworthy, safe, ethically compliant, age-appropriate, and pedagogically suitable."
      },
      "fr": {
        "prefLabel": "Validation des outils d’IA pour l’éducation",
        "definition": "Évaluation systématique d’un système ou d’un outil d’IA avant son adoption en éducation, visant à déterminer s’il est suffisamment fiable, digne de confiance, sûr, conforme aux exigences éthiques, adapté à l’âge des utilisateurs et pertinent sur le plan pédagogique.",
        "altLabels": []
      },
      "status": "draft",
      "reviewNotes": ""
    },
    {
      "id": "ai-assisted-teaching",
      "canonicalUri": "https://id.i2idl.org/concepts/ai-assisted-teaching",
      "en": {
        "prefLabel": "AI-assisted teaching",
        "definition": "Teaching in which educators identify and use appropriate AI tools to support activities such as lesson planning, instruction, assessment, and learner support while mitigating associated risks."
      },
      "fr": {
        "prefLabel": "Enseignement assisté par l’IA",
        "definition": "Enseignement dans lequel les éducateurs identifient et utilisent des outils d’IA appropriés pour soutenir des activités telles que la planification des cours, l’enseignement, l’évaluation et l’accompagnement des apprenants, tout en atténuant les risques associés.",
        "altLabels": []
      },
      "status": "draft",
