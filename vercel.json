{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/developers",
      "destination": "/developers.html"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/api/docs",
      "destination": "/api/docs.html"
    },
    {
      "source": "/api/v1/concepts/:id/relationships",
      "destination": "/api/v1-graph?route=relationships&id=:id"
    },
    {
      "source": "/api/v1/concepts/:id/versions",
      "destination": "/api/v1-graph?route=versions&id=:id"
    },
    {
      "source": "/api/v1/collections/:type/:id",
      "destination": "/api/v1-graph?route=collection&type=:type&id=:id"
    },
    {
      "source": "/api/v1/collections",
      "destination": "/api/v1-graph?route=collections"
    },
    {
      "source": "/api/v1/sources/:id",
      "destination": "/api/v1-graph?route=source&id=:id"
    },
    {
      "source": "/api/v1/sources",
      "destination": "/api/v1-graph?route=sources"
    },
    {
      "source": "/api/v1/concepts/:id/context",
      "destination": "/api/v1-context?id=:id"
    },
    {
      "source": "/api/v1/concepts/:id",
      "destination": "/api/v1?route=concept&id=:id"
    },
    {
      "source": "/api/v1/concepts",
      "destination": "/api/v1?route=concepts"
    },
    {
      "source": "/concepts/:id/versions/:revision.jsonld",
      "destination": "/api/version-history?kind=revision&id=:id&revision=:revision&format=jsonld"
    },
    {
      "source": "/concepts/:id/versions/:revision.ttl",
      "destination": "/api/version-history?kind=revision&id=:id&revision=:revision&format=ttl"
    },
    {
      "source": "/concepts/:id/versions/:revision.nq",
      "destination": "/api/version-history?kind=revision&id=:id&revision=:revision&format=nq"
    },
    {
      "source": "/concepts/:id/versions/:revision",
      "destination": "/api/version-history?kind=revision&id=:id&revision=:revision"
    },
    {
      "source": "/concepts/:id/versions",
      "destination": "/api/version-history?kind=history&id=:id"
    },
    {
      "source": "/explore",
      "destination": "/graph.html"
    },
    {
      "source": "/activity",
      "destination": "/activity.html"
    },
    {
      "source": "/sparql",
      "destination": "/api/sparql"
    },
    {
      "source": "/glossary.ttl",
      "destination": "/api/resolve?kind=glossary&format=ttl"
    },
    {
      "source": "/glossary",
      "destination": "/api/resolve?kind=glossary"
    },
    {
      "source": "/scheme.jsonld",
      "destination": "/api/resolve?kind=scheme&format=jsonld"
    },
    {
      "source": "/scheme.ttl",
      "destination": "/api/resolve?kind=scheme&format=ttl"
    },
    {
      "source": "/scheme",
      "destination": "/api/resolve?kind=scheme"
    },
    {
      "source": "/concepts/:id.jsonld",
      "destination": "/api/resolve?kind=concept&id=:id&format=jsonld"
    },
    {
      "source": "/concepts/:id.ttl",
      "destination": "/api/resolve?kind=concept&id=:id&format=ttl"
    },
    {
      "source": "/concepts/:id",
      "destination": "/api/resolve?kind=concept&id=:id"
    },
    {
      "source": "/definitions/:id.jsonld",
      "destination": "/api/resolve?kind=definition&id=:id&format=jsonld"
    },
    {
      "source": "/definitions/:id.ttl",
      "destination": "/api/resolve?kind=definition&id=:id&format=ttl"
    },
    {
      "source": "/definitions/:id",
      "destination": "/api/resolve?kind=definition&id=:id"
    },
    {
      "source": "/sources/:id.jsonld",
      "destination": "/api/resolve?kind=source&id=:id&format=jsonld"
    },
    {
      "source": "/sources/:id.ttl",
      "destination": "/api/resolve?kind=source&id=:id&format=ttl"
    },
    {
      "source": "/sources/:id",
      "destination": "/api/resolve?kind=source&id=:id"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/sparql",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'none'; img-src 'none'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'none'; img-src 'none'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/glossary.jsonld",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/ld+json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/explore",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/graph.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/glossary-core.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/glossary-details.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/activity",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/activity.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "functions": {
    "api/resolve.mjs": {
      "includeFiles": "public/glossary.jsonld"
    },
    "api/version-history.mjs": {
      "includeFiles": "versioning/**"
    }
  }
}
