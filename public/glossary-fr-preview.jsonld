{
  "@context": {
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "gs": "https://glossarystudio.app/ns/"
  },
  "@graph": [
    {
      "@id": "https://id.i2idl.org/concepts/a-b-testing",
      "skos:prefLabel": {
        "@value": "Test A/B",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/a-b-testing-1",
      "rdf:value": {
        "@value": "Comparaison contrôlée dans laquelle deux versions d’une expérience d’apprentissage, d’une interface, d’un message ou d’une intervention sont présentées à des groupes différents afin de comparer leurs effets.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/about-resource",
      "skos:prefLabel": {
        "@value": "About Resource",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Ressource About",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/about-resource-1",
      "rdf:value": {
        "@value": "Ressource xAPI accessible à l’adresse /about qui renvoie des informations de base sur un Learning Record Store (LRS), notamment les versions de xAPI prises en charge et les extensions facultatives.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/accessibility",
      "skos:prefLabel": {
        "@value": "Accessibilité",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/accessibility-1",
      "rdf:value": {
        "@value": "Pratique consistant à concevoir des technologies d’apprentissage, des contenus et des interactions de manière à ce que des personnes ayant des capacités diverses puissent les percevoir, les faire fonctionner, les comprendre et les utiliser.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/accessibility-and-inclusivity-testing",
      "skos:prefLabel": {
        "@value": "Tests d’accessibilité et d’inclusivité",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/accessibility-and-inclusivity-testing-1",
      "rdf:value": {
        "@value": "Tests visant à vérifier si une solution d’apprentissage peut être utilisée par des personnes ayant des capacités, des besoins d’accès, des contextes et des contraintes différents.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/account-object",
      "skos:prefLabel": {
        "@value": "Account Object",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Objet Account",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/account-object-1",
      "rdf:value": {
        "@value": "Structure d’identité xAPI qui représente un Agent ou un Groupe au moyen d’un compte sur un système existant, en utilisant l’adresse de la page d’accueil du système de comptes et un nom de compte unique.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/acquire-ai-competency-level",
      "skos:prefLabel": {
        "@value": "Acquérir (niveau de compétence en IA)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/acquire-ai-competency-level-1",
      "rdf:value": {
        "@value": "Niveau fondamental de compétence en intelligence artificielle dans lequel les enseignants développent les connaissances essentielles, la conscience des enjeux éthiques et les compétences pratiques nécessaires pour évaluer, sélectionner et utiliser les outils d’IA de manière appropriée.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/activity",
      "skos:prefLabel": {
        "@value": "Activity",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Activité",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/activity-1",
      "rdf:value": {
        "@value": "Dans xAPI, une activité est un élément avec lequel un acteur interagit ou dont il fait l’expérience, et qui peut constituer l’objet d’une déclaration suivie. Les activités peuvent représenter un enseignement, une performance, des expériences, des ressources, des événements, voire des objets physiques ou virtuels.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/activity-definition",
      "skos:prefLabel": {
        "@value": "Activity Definition",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Activity Definition",
          "@language": "fr"
        },
        {
          "@value": "Définition d’activité",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/activity-definition-1",
      "rdf:value": {
        "@value": "Objet de métadonnées facultatif au sein d’une activité xAPI qui peut en décrire le nom lisible par une personne, la description, le type, l’emplacement d’informations complémentaires, les détails d’interaction et les extensions.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/activity-profile-resource",
      "skos:prefLabel": {
        "@value": "Activity Profile Resource",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Ressource de profil d’activité",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/activity-profile-resource-1",
      "rdf:value": {
        "@value": "Ressource xAPI accessible à l’adresse /activities/profile, destinée à stocker et à récupérer des documents de profil génériques associés à une activité.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/actor",
      "skos:prefLabel": {
        "@value": "Actor",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Actor",
          "@language": "fr"
        },
        {
          "@value": "Acteur",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/actor-1",
      "rdf:value": {
        "@value": "Personne ou groupe représenté dans une déclaration xAPI comme accomplissant l’action décrite par cette déclaration.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/adaptive-hypermedia",
      "skos:prefLabel": {
        "@value": "Hypermédia adaptatif",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/adaptive-hypermedia-1",
      "rdf:value": {
        "@value": "Système hypermédia qui construit un modèle de l’utilisateur et modifie les informations, les liens ou la présentation qui lui sont proposés, plutôt que d’offrir la même expérience à tout le monde.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/adaptive-instructional-system",
      "skos:prefLabel": {
        "@value": "Système pédagogique adaptatif",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/adaptive-instructional-system-1",
      "rdf:value": {
        "@value": "Système d’apprentissage qui modifie les contenus, leur séquencement, le soutien apporté, la rétroaction ou le niveau de difficulté en fonction d’informations concernant un apprenant ou le contexte.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/administrative-data",
      "skos:prefLabel": {
        "@value": "Données administratives",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/administrative-data-1",
      "rdf:value": {
        "@value": "Données produites dans le cadre de l’administration et de la gestion courantes d’un système éducatif, généralement au moyen de systèmes d’information de gestion de l’éducation et de dossiers administratifs publics connexes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/affective-computing",
      "skos:prefLabel": {
        "@value": "Informatique affective",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/affective-computing-1",
      "rdf:value": {
        "@value": "Domaine de l’informatique consacré à la reconnaissance, à la modélisation ou à la prise en compte des états émotionnels humains et, dans certains cas, à la simulation de comportements affectifs par des machines.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/agent-profile-resource",
      "skos:prefLabel": {
        "@value": "Agent Profile Resource",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Ressource de profil d’agent",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/agent-profile-resource-1",
      "rdf:value": {
        "@value": "Ressource xAPI accessible à l’adresse /agents/profile, destinée à stocker et à récupérer des documents de profil génériques associés à un agent ou à un groupe identifié, indépendamment d’une activité ou d’un enregistrement particulier.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/agile-development",
      "skos:prefLabel": {
        "@value": "Développement agile",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/agile-development-1",
      "rdf:value": {
        "@value": "Approche itérative de création de solutions par petits incréments, qui s’appuie sur les retours d’expérience et adapte les plans à l’évolution des conditions.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ai-competency-framework-for-teachers-ai-cft",
      "skos:prefLabel": {
        "@value": "Cadre de compétences en IA pour les enseignants",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Référentiel de compétences en IA pour les enseignants (AI CFT)",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/ai-competency-framework-for-teachers-ai-cft-1",
      "rdf:value": {
        "@value": "Cadre de référence décrivant les connaissances, les compétences, les valeurs et les attitudes dont les enseignants ont besoin pour utiliser l’intelligence artificielle de manière sûre, efficace et éthique, tout en préservant une éducation centrée sur l’humain.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ai-competency-progression",
      "skos:prefLabel": {
        "@value": "Progression des compétences en IA",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ai-competency-progression-1",
      "rdf:value": {
        "@value": "Parcours de référence structuré en paliers pour développer les compétences en IA à des niveaux de capacité croissants, sans supposer que cette progression est strictement linéaire ni identique dans tous les domaines de compétence.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ai-explainability-in-education",
      "skos:prefLabel": {
        "@value": "Explicabilité de l’IA en éducation",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ai-explainability-in-education-1",
      "rdf:value": {
        "@value": "Degré auquel les éducateurs peuvent comprendre et examiner de manière critique la façon dont un système d’IA produit ses résultats ou ses conclusions, suffisamment pour évaluer son utilisation et intervenir si nécessaire.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ai-for-professional-development",
      "skos:prefLabel": {
        "@value": "IA pour le développement professionnel",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "IA pour l’apprentissage professionnel",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/ai-for-professional-development-1",
      "rdf:value": {
        "@value": "Utilisation de l’IA pour soutenir la formation professionnelle continue des enseignants, le développement collaboratif, la réflexion sur la pratique, l’évaluation des besoins d’apprentissage et la transformation des pratiques professionnelles.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ai-foundations-and-applications",
      "skos:prefLabel": {
        "@value": "Fondements et applications de l’IA",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ai-foundations-and-applications-1",
      "rdf:value": {
        "@value": "Connaissances conceptuelles et compétences opérationnelles transférables nécessaires pour comprendre le fonctionnement de l’IA et pour évaluer, sélectionner, utiliser, adapter ou personnaliser des outils d’IA à des fins appropriées.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ai-literacy-for-teachers",
      "skos:prefLabel": {
        "@value": "Littératie en IA pour les enseignants",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ai-literacy-for-teachers-1",
      "rdf:value": {
        "@value": "Ensemble fondamental de compétences en IA dont les enseignants ont besoin pour comprendre que l’IA doit rester sous conduite humaine, reconnaître ses avantages et ses risques, appliquer des principes éthiques fondamentaux, comprendre les concepts de base de l’IA et utiliser des outils d’IA appropriés dans la pratique éducative.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ai-pedagogy",
      "skos:prefLabel": {
        "@value": "Pédagogie de l’IA",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Pédagogie intégrant l’IA",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/ai-pedagogy-1",
      "rdf:value": {
        "@value": "Compétences et pratiques liées à la sélection, à la validation et à l’intégration de l’IA aux méthodes pédagogiques pour soutenir l’enseignement, l’apprentissage, les interactions sociales, l’attention portée aux personnes et l’évaluation.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ai-tool-validation-for-education",
      "skos:prefLabel": {
        "@value": "Validation des outils d’IA pour l’éducation",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ai-tool-validation-for-education-1",
      "rdf:value": {
        "@value": "Évaluation systématique d’un système ou d’un outil d’IA avant son adoption en éducation, visant à déterminer s’il est suffisamment fiable, digne de confiance, sûr, conforme aux exigences éthiques, adapté à l’âge des utilisateurs et pertinent sur le plan pédagogique.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ai-assisted-teaching",
      "skos:prefLabel": {
        "@value": "Enseignement assisté par l’IA",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ai-assisted-teaching-1",
      "rdf:value": {
        "@value": "Enseignement dans lequel les éducateurs identifient et utilisent des outils d’IA appropriés pour soutenir des activités telles que la planification des cours, l’enseignement, l’évaluation et l’accompagnement des apprenants, tout en atténuant les risques associés.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ai-enhanced-pedagogical-innovation",
      "skos:prefLabel": {
        "@value": "Innovation pédagogique enrichie par l’IA",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ai-enhanced-pedagogical-innovation-1",
      "rdf:value": {
        "@value": "Utilisation critique et exploratoire de l’IA pour élaborer ou transformer des situations d’apprentissage, des approches pédagogiques, des modalités d’évaluation et des formes d’apprentissage centrées sur les élèves, tout en préservant les principes d’une éducation centrée sur l’humain.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ai-pedagogy-integration",
      "skos:prefLabel": {
        "@value": "Intégration de l’IA à la pédagogie",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ai-pedagogy-integration-1",
      "rdf:value": {
        "@value": "Intégration intentionnelle de l’IA à la conception et à l’accompagnement d’apprentissages centrés sur les élèves afin de favoriser l’engagement, la différenciation des apprentissages, les interactions entre enseignants et élèves, la pensée critique et la résolution de problèmes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/anonymous-group",
      "skos:prefLabel": {
        "@value": "Anonymous Group",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Anonymous Group",
          "@language": "fr"
        },
        {
          "@value": "Groupe anonyme",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/anonymous-group-1",
      "rdf:value": {
        "@value": "Groupe xAPI ne possédant pas son propre identifiant fonctionnel inverse et représenté par les agents qui figurent parmi ses membres.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/artificial-intelligence-ai",
      "skos:prefLabel": {
        "@value": "Intelligence artificielle (IA)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/artificial-intelligence-ai-1",
      "rdf:value": {
        "@value": "Ensemble étendu de techniques informatiques utilisées pour accomplir des tâches relevant de la perception, de la prédiction, de la classification, de la génération, de l’aide à la décision ou d’autres formes de comportement intelligent.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/assessment",
      "skos:prefLabel": {
        "@value": "Évaluation",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/assessment-1",
      "rdf:value": {
        "@value": "Collecte et interprétation d’éléments probants concernant les connaissances, les compétences, les performances, l’état d’un apprenant ou les résultats d’apprentissage.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/asset-model",
      "skos:prefLabel": {
        "@value": "Modèle axé sur les forces",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Approche fondée sur les acquis",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/asset-model-1",
      "rdf:value": {
        "@value": "Approche qui part des capacités et des points forts qu’un apprenant possède déjà et vise à développer de nouvelles capacités plutôt qu’à diagnostiquer principalement des déficits par rapport aux moyennes d’un groupe.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/asynchronous-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage asynchrone",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/asynchronous-learning-1",
      "rdf:value": {
        "@value": "Activité d’apprentissage pouvant se dérouler à des moments différents, permettant aux apprenants d’interagir avec des ressources ou de réaliser des tâches sans que tous participent simultanément.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/attachment",
      "skos:prefLabel": {
        "@value": "Attachment",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Attachment",
          "@language": "fr"
        },
        {
          "@value": "Pièce jointe",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/attachment-1",
      "rdf:value": {
        "@value": "Fichier ou autre ressource binaire associé logiquement à une déclaration xAPI, décrit par des métadonnées comprenant le type d’utilisation, le nom affiché, le type de contenu, la taille, l’empreinte SHA-2 et, facultativement, une URL de fichier.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/attention",
      "skos:prefLabel": {
        "@value": "Attention",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/attention-1",
      "rdf:value": {
        "@value": "Allocation sélective de ressources cognitives à des informations, à des tâches ou à des stimuli.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/unesco-basic-and-general-study-subjects",
      "skos:prefLabel": {
        "@value": "Matières de l’enseignement de base et général",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/unesco-basic-and-general-study-subjects-1",
      "rdf:value": {
        "@value": "Domaines d’études fondamentaux et généraux visant à développer les connaissances générales, les littératies, la compréhension culturelle et les compétences scolaires essentielles dans des domaines tels que les langues, les mathématiques, les sciences, les sciences humaines, les arts, la santé et l’éducation à la citoyenneté.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/behavioral-economics",
      "skos:prefLabel": {
        "@value": "Économie comportementale",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/behavioral-economics-1",
      "rdf:value": {
        "@value": "Domaine qui étudie les biais systématiques, les heuristiques et les schémas de décision qui conduisent les personnes à faire des choix s’écartant des modèles de rationalité pure.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/bias",
      "skos:prefLabel": {
        "@value": "Biais",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/bias-1",
      "rdf:value": {
        "@value": "Distorsion systématique dans les données, la mesure, l’analyse, les modèles, les processus ou les décisions, susceptible de produire des résultats injustes ou trompeurs.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/building-expertise",
      "skos:prefLabel": {
        "@value": "Développement de l’expertise",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/building-expertise-1",
      "rdf:value": {
        "@value": "Développement, au sein d’un domaine, de connaissances et de compétences de plus en plus organisées, faciles à mobiliser et utilisables, grâce à l’expérience et à la pratique.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/challenge-identification",
      "skos:prefLabel": {
        "@value": "Identification du défi",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/challenge-identification-1",
      "rdf:value": {
        "@value": "Étape de l’ingénierie de l’apprentissage au cours de laquelle une équipe définit le problème, le contexte, les parties prenantes, les contraintes et les éléments probants avant de concevoir une solution.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/cognitive-engagement",
      "skos:prefLabel": {
        "@value": "Engagement cognitif",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/cognitive-engagement-1",
      "rdf:value": {
        "@value": "Degré auquel un apprenant réfléchit activement aux connaissances, les applique, les analyse et établit des liens entre elles, plutôt que de se limiter à recevoir ou à mémoriser de l’information.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/cognitive-load",
      "skos:prefLabel": {
        "@value": "Charge cognitive",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/cognitive-load-1",
      "rdf:value": {
        "@value": "Effort mental nécessaire pour traiter de l’information dans la mémoire de travail au cours d’une tâche.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/cognitive-task-analysis",
      "skos:prefLabel": {
        "@value": "Analyse cognitive des tâches",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/cognitive-task-analysis-1",
      "rdf:value": {
        "@value": "Ensemble de méthodes permettant de déterminer les connaissances, les décisions, les indices, les stratégies et les processus mentaux mobilisés dans l’exécution de tâches complexes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/cognitive-walkthrough",
      "skos:prefLabel": {
        "@value": "Parcours cognitif",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Inspection cognitive pas à pas",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/cognitive-walkthrough-1",
      "rdf:value": {
        "@value": "Méthode d’inspection de l’utilisabilité dans laquelle des évaluateurs parcourent les étapes d’une tâche du point de vue d’un utilisateur et examinent si chaque action est compréhensible et facile à découvrir.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/community-of-practice",
      "skos:prefLabel": {
        "@value": "Communauté de pratique",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/community-of-practice-1",
      "rdf:value": {
        "@value": "Communauté au sein de laquelle les personnes apprennent par la participation sociale à une pratique commune, en développant leurs connaissances grâce aux interactions avec d’autres personnes engagées dans un travail ou une activité connexe.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/competency",
      "skos:prefLabel": {
        "@value": "Compétence",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/competency-1",
      "rdf:value": {
        "@value": "Capacité, aptitude, domaine de connaissances ou performance observable défini, pouvant être décrit, évalué, développé ou référencé dans différents systèmes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/competency-based-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage fondé sur les compétences",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Apprentissage par compétences",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/competency-based-learning-1",
      "rdf:value": {
        "@value": "Approche dans laquelle la progression est organisée autour de la maîtrise démontrée de compétences définies, plutôt que principalement autour du temps passé dans un cours ou un programme.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/computer-based-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage sur ordinateur",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Apprentissage sur ordinateur",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/computer-based-learning-1",
      "rdf:value": {
        "@value": "Utilisation d’ordinateurs pour accéder à une formation ou à un enseignement au moyen d’activités synchrones ou asynchrones proposées sur des systèmes en réseau ou autonomes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/concept-map",
      "skos:prefLabel": {
        "@value": "Carte conceptuelle",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/concept-map-1",
      "rdf:value": {
        "@value": "Représentation montrant les liens entre des concepts ou des idées abstraites.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/conceptual-knowledge",
      "skos:prefLabel": {
        "@value": "Connaissances conceptuelles",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/conceptual-knowledge-1",
      "rdf:value": {
        "@value": "Connaissance des idées, des relations et des raisons sous-jacentes expliquant le fonctionnement d’une procédure, d’un principe ou d’une solution.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/connectivism",
      "skos:prefLabel": {
        "@value": "Connectivisme",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/connectivism-1",
      "rdf:value": {
        "@value": "Théorie de l’apprentissage selon laquelle les connaissances sont réparties dans des réseaux de connexions, mettant l’accent sur l’apprentissage continu, l’actualité de l’information et la capacité à reconnaître des liens entre sources et domaines.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/connectivist-mooc-cmooc",
      "skos:prefLabel": {
        "@value": "MOOC connectiviste (cMOOC)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/connectivist-mooc-cmooc-1",
      "rdf:value": {
        "@value": "Cours en ligne ouvert et massif fondé sur les principes du connectivisme, privilégiant les réseaux, l’apprentissage social, la coopération et la construction collaborative des connaissances.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/context-activities",
      "skos:prefLabel": {
        "@value": "Activités de contexte",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/context-activities-1",
      "rdf:value": {
        "@value": "Références à des activités incluses dans le contexte d’une déclaration xAPI pour exprimer les liens entre l’expérience enregistrée et des activités plus larges ou associées.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/context-agent",
      "skos:prefLabel": {
        "@value": "Agent de contexte",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/context-agent-1",
      "rdf:value": {
        "@value": "Structure de contexte xAPI représentant une relation propre à une déclaration entre celle-ci et un agent pertinent, éventuellement caractérisée par un ou plusieurs IRI de type de relation.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/context-group",
      "skos:prefLabel": {
        "@value": "Groupe de contexte",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/context-group-1",
      "rdf:value": {
        "@value": "Structure de contexte xAPI représentant une relation propre à une déclaration entre celle-ci et un groupe pertinent, éventuellement caractérisée par un ou plusieurs IRI de type de relation.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/context-object",
      "skos:prefLabel": {
        "@value": "Objet de contexte",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/context-object-1",
      "rdf:value": {
        "@value": "Composant facultatif d’une déclaration xAPI ajoutant des renseignements contextuels sur une expérience, tels que l’inscription, les activités associées, les agents ou groupes pertinents, la langue, la plateforme, une autre déclaration ou des extensions.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/contextual-factor",
      "skos:prefLabel": {
        "@value": "Facteur contextuel",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/contextual-factor-1",
      "rdf:value": {
        "@value": "Condition entourant une conception, notamment les besoins des apprenants, le programme, les délais, les ressources ou les technologies, qui influe sur les possibilités et la pertinence des choix.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/continuous-improvement",
      "skos:prefLabel": {
        "@value": "Amélioration continue",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/continuous-improvement-1",
      "rdf:value": {
        "@value": "Pratique permanente consistant à utiliser les données probantes et la rétroaction pour perfectionner progressivement les expériences, systèmes, processus et opérations d’apprentissage.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/continuous-integration",
      "skos:prefLabel": {
        "@value": "Intégration continue",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/continuous-integration-1",
      "rdf:value": {
        "@value": "Pratique de développement logiciel consistant à intégrer et tester fréquemment les modifications plutôt qu’à les accumuler dans de rares livraisons volumineuses.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/control-theory",
      "skos:prefLabel": {
        "@value": "Théorie de la commande",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/control-theory-1",
      "rdf:value": {
        "@value": "Domaine de l’ingénierie qui étudie comment les systèmes utilisent la rétroaction pour réguler leur comportement et atteindre des états souhaités.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/controlled-vocabulary",
      "skos:prefLabel": {
        "@value": "Vocabulaire contrôlé",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/controlled-vocabulary-1",
      "rdf:value": {
        "@value": "Ensemble administré de termes définis et d’identifiants employés de façon cohérente dans un domaine afin que personnes et machines désignent les mêmes concepts de la même manière.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/create-ai-competency-level",
      "skos:prefLabel": {
        "@value": "Créer (niveau de compétence en IA)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/create-ai-competency-level-1",
      "rdf:value": {
        "@value": "Niveau avancé de compétence en IA où les enseignants configurent, adaptent ou coconçoivent, avec esprit critique et créativité, des approches, outils, politiques et pratiques pédagogiques mobilisant l’IA pour transformer l’éducation.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/creation-phase",
      "skos:prefLabel": {
        "@value": "Phase de création",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/creation-phase-1",
      "rdf:value": {
        "@value": "Étape du processus d’ingénierie de l’apprentissage où une équipe conçoit une solution à un défi d’apprentissage, planifie et instrumente les données nécessaires et fait évoluer la conception avec les apprenants et les parties prenantes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/cross-domain-collaboration",
      "skos:prefLabel": {
        "@value": "Collaboration interdisciplinaire",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/cross-domain-collaboration-1",
      "rdf:value": {
        "@value": "Collaboration entre personnes de différentes disciplines professionnelles apportant des expertises distinctes à un défi d’ingénierie de l’apprentissage.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/cross-national-assessment",
      "skos:prefLabel": {
        "@value": "Évaluation transnationale",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/cross-national-assessment-1",
      "rdf:value": {
        "@value": "Évaluation des apprentissages régionale ou internationale utilisant un cadre commun convenu et des procédures comparables entre systèmes participants afin de produire des données comparables sur les acquis.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/culture-change",
      "skos:prefLabel": {
        "@value": "Changement culturel",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/culture-change-1",
      "rdf:value": {
        "@value": "Effort délibéré visant à transformer les hypothèses, comportements, normes, incitations et façons de travailler partagés pour qu’une organisation adopte et pérennise un nouveau modèle d’apprentissage.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/unesco-curriculum",
      "skos:prefLabel": {
        "@value": "Programme d’études",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/unesco-curriculum-1",
      "rdf:value": {
        "@value": "Ensemble planifié des matières et contenus d’un programme éducatif, comprenant la répartition du temps d’enseignement et l’ordre des apprentissages.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/data-analysis",
      "skos:prefLabel": {
        "@value": "Analyse des données",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/data-analysis-1",
      "rdf:value": {
        "@value": "Interprétation de données visant à dégager des enseignements, identifier des tendances, évaluer des résultats, diagnostiquer leurs facteurs explicatifs et apprécier les effets des politiques.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/data-analytics",
      "skos:prefLabel": {
        "@value": "Analytique des données",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/data-analytics-1",
      "rdf:value": {
        "@value": "Emploi de méthodes et d’outils pour examiner des données, décrire des tendances, tester des hypothèses, repérer des relations ou éclairer des décisions.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/data-availability",
      "skos:prefLabel": {
        "@value": "Disponibilité des données",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/data-availability-1",
      "rdf:value": {
        "@value": "Situation dans laquelle les données existent et peuvent être consultées ou récupérées, indépendamment de leur publication officielle ou de leur qualité pour un usage particulier.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/data-culture",
      "skos:prefLabel": {
        "@value": "Culture des données",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/data-culture-1",
      "rdf:value": {
        "@value": "Environnement organisationnel et institutionnel dans lequel la transparence, la collaboration, la participation, l’ouverture, les définitions partagées et l’usage régulier de preuves soutiennent la prise de décision.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/data-instrumentation",
      "skos:prefLabel": {
        "@value": "Instrumentation des données",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/data-instrumentation-1",
      "rdf:value": {
        "@value": "Conception et mise en place intentionnelles de mécanismes capturant événements, états, contexte et autres données nécessaires à la compréhension d’un système d’apprentissage.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/data-mining",
      "skos:prefLabel": {
        "@value": "Fouille de données",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/data-mining-1",
      "rdf:value": {
        "@value": "Utilisation de méthodes informatiques pour découvrir des motifs, structures, associations ou relations prédictives dans de grands ensembles de données.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/data-ownership",
      "skos:prefLabel": {
        "@value": "Propriété et contrôle des données",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/data-ownership-1",
      "rdf:value": {
        "@value": "Droits, responsabilités et enjeux de gouvernance liés au contrôle des données produites ou utilisées au sein des systèmes éducatifs.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/data-pipeline",
      "skos:prefLabel": {
        "@value": "Pipeline de données",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/data-pipeline-1",
      "rdf:value": {
        "@value": "Suite de processus qui transportent, valident, transforment, enrichissent, stockent ou acheminent des données depuis des systèmes sources vers leurs destinations.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/data-privacy",
      "skos:prefLabel": {
        "@value": "Protection des données personnelles",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/data-privacy-1",
      "rdf:value": {
        "@value": "Principes et pratiques régissant la collecte, l’utilisation, le partage, la conservation, la protection et la suppression des informations concernant les personnes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/data-quality",
      "skos:prefLabel": {
        "@value": "Qualité des données",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/data-quality-1",
      "rdf:value": {
        "@value": "Degré d’exactitude, d’exhaustivité, de cohérence, d’actualité, de validité et d’adéquation des données à leur usage prévu.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/data-reporting",
      "skos:prefLabel": {
        "@value": "Communication officielle des données",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/data-reporting-1",
      "rdf:value": {
        "@value": "Diffusion officielle de données disponibles auprès du public, d’organisations internationales ou d’autres parties prenantes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/data-security",
      "skos:prefLabel": {
        "@value": "Sécurité des données",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/data-security-1",
      "rdf:value": {
        "@value": "Pratiques et mesures de contrôle protégeant les données d’apprentissage, systèmes, interfaces, stockages et communications contre les accès non autorisés, altérations, pertes ou perturbations.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/data-silo",
      "skos:prefLabel": {
        "@value": "Silo de données",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/data-silo-1",
      "rdf:value": {
        "@value": "Réservoir de données isolé qui échange difficilement des renseignements avec d’autres applications, systèmes ou sources de données organisationnelles.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/data-stewardship",
      "skos:prefLabel": {
        "@value": "Intendance des données",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/data-stewardship-1",
      "rdf:value": {
        "@value": "Responsabilité organisationnelle de gouverner la détention, la protection, l’accès, le partage, la maintenance et l’utilisation des données tout au long de leur cycle de vie.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/data-use",
      "skos:prefLabel": {
        "@value": "Utilisation des données",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/data-use-1",
      "rdf:value": {
        "@value": "Application de données et de résultats analytiques à l’élaboration de politiques et programmes, à l’allocation des ressources, à la planification, à la mise en œuvre et à d’autres décisions visant à améliorer l’éducation.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/data-informed-decision-making",
      "skos:prefLabel": {
        "@value": "Prise de décision éclairée par les données",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/data-informed-decision-making-1",
      "rdf:value": {
        "@value": "Processus décisionnel utilisant les données pertinentes comme éléments probants tout en tenant compte du contexte, de l’expertise, des objectifs et des contraintes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/decision-support",
      "skos:prefLabel": {
        "@value": "Aide à la décision",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/decision-support-1",
      "rdf:value": {
        "@value": "Emploi de données, d’analyses, de modèles ou de logiciels pour aider les personnes à prendre des décisions éclairées sans nécessairement automatiser la décision elle-même.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/decision-tracking",
      "skos:prefLabel": {
        "@value": "Suivi des décisions",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/decision-tracking-1",
      "rdf:value": {
        "@value": "Pratique consistant à consigner les décisions de conception, leurs justifications, leurs influences et leurs révisions pendant toute la durée d’un projet.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/deepen-ai-competency-level",
      "skos:prefLabel": {
        "@value": "Approfondir (niveau de compétence en IA)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/deepen-ai-competency-level-1",
      "rdf:value": {
        "@value": "Niveau intermédiaire de compétence en IA où les enseignants intègrent l’IA à la pratique éducative en accordant davantage d’attention à la responsabilité humaine, à l’utilisation sûre et responsable, à l’évaluation éthique et à la conception pédagogique.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/design-decision",
      "skos:prefLabel": {
        "@value": "Décision de conception",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/design-decision-1",
      "rdf:value": {
        "@value": "Choix portant sur les éléments à inclure dans une conception pédagogique et leur mise en œuvre, en fonction des objectifs, des données probantes, de l’expérience, des contraintes et du contexte.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/design-decision-making",
      "skos:prefLabel": {
        "@value": "Processus décisionnel en conception",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/design-decision-making-1",
      "rdf:value": {
        "@value": "Processus consistant à formuler, appliquer, communiquer, réexaminer et parfois réviser des choix de conception pédagogique en tenant compte des apprenants, parties prenantes, données, technologies et contextes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/design-judgment",
      "skos:prefLabel": {
        "@value": "Jugement de conception",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/design-judgment-1",
      "rdf:value": {
        "@value": "Raisonnement permettant de déterminer pourquoi un choix de conception convient à une situation donnée, en mobilisant connaissances, expérience, théorie et facteurs contextuels.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/design-justification",
      "skos:prefLabel": {
        "@value": "Justification de conception",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/design-justification-1",
      "rdf:value": {
        "@value": "Raison, preuve ou source d’influence consignée expliquant pourquoi une décision de conception a été prise ou révisée.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/design-pattern",
      "skos:prefLabel": {
        "@value": "Patron de conception",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/design-pattern-1",
      "rdf:value": {
        "@value": "Description réutilisable d’un problème de conception récurrent et d’une manière éprouvée ou généralement utile d’y répondre.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/design-revision",
      "skos:prefLabel": {
        "@value": "Révision de conception",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/design-revision-1",
      "rdf:value": {
        "@value": "Modification d’une décision antérieure ou d’un élément existant d’une conception pédagogique.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/design-build-cycle",
      "skos:prefLabel": {
        "@value": "Cycle conception-réalisation",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/design-build-cycle-1",
      "rdf:value": {
        "@value": "Cycle itératif dans lequel une solution d’apprentissage est conçue, réalisée, essayée avec des apprenants ou parties prenantes, examinée à l’aide de preuves puis révisée, plutôt que considérée comme achevée après une seule conception.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/digital-credential",
      "skos:prefLabel": {
        "@value": "Justificatif numérique",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Attestation numérique",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/digital-credential-1",
      "rdf:value": {
        "@value": "Assertion représentée numériquement concernant une réalisation, qualification, compétence, identité, participation ou autorisation, pouvant être émise et vérifiée par voie électronique.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/digital-divide",
      "skos:prefLabel": {
        "@value": "Fracture numérique",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/digital-divide-1",
      "rdf:value": {
        "@value": "Inégalité d’accès aux infrastructures technologiques et aux compétences nécessaires pour tirer parti des technologies numériques.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/digital-engineering-for-learning-systems",
      "skos:prefLabel": {
        "@value": "Ingénierie numérique des systèmes d’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/digital-engineering-for-learning-systems-1",
      "rdf:value": {
        "@value": "Application de méthodes, modèles, interfaces et approches de cycle de vie de l’ingénierie numérique à la conception et au fonctionnement des systèmes d’apprentissage.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/digital-footprint",
      "skos:prefLabel": {
        "@value": "Empreinte numérique",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/digital-footprint-1",
      "rdf:value": {
        "@value": "Données produites par l’utilisation des technologies dans l’enseignement et l’apprentissage, qui peuvent être recueillies, analysées et partagées.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/digital-global-public-goods",
      "skos:prefLabel": {
        "@value": "Biens publics numériques mondiaux",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/digital-global-public-goods-1",
      "rdf:value": {
        "@value": "Ressources numériques réutilisables destinées à l’intérêt général, notamment recherches, ressources et applications numériques, bases de données, dépôts, normes, algorithmes et plateformes adaptables à différents contextes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/digital-learning-materials",
      "skos:prefLabel": {
        "@value": "Ressources pédagogiques numériques",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/digital-learning-materials-1",
      "rdf:value": {
        "@value": "Contenus et ressources numériques soutenant l’enseignement et l’apprentissage, dont manuels numériques, simulations, jeux, contenus créés par les utilisateurs et ressources éducatives libres.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/digital-literacies",
      "skos:prefLabel": {
        "@value": "Littératie numérique",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/digital-literacies-1",
      "rdf:value": {
        "@value": "Capacités nécessaires pour bénéficier des technologies numériques et les utiliser efficacement pour enseigner et apprendre, y compris les pédagogies numériques au-delà du simple usage technique.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/digital-security",
      "skos:prefLabel": {
        "@value": "Sécurité numérique",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/digital-security-1",
      "rdf:value": {
        "@value": "Protection des systèmes numériques et des données éducatives contre les risques compromettant confidentialité, intégrité, disponibilité ou sécurité d’utilisation.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/digital-skills",
      "skos:prefLabel": {
        "@value": "Compétences numériques",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/digital-skills-1",
      "rdf:value": {
        "@value": "Compétences permettant d’utiliser les technologies numériques, des capacités techniques élémentaires aux compétences avancées telles que programmation, pensée informatique et éthique.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/distributed-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage distribué",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/distributed-learning-1",
      "rdf:value": {
        "@value": "Apprentissage dispensé au-delà d’une salle de classe unique au moyen de technologies et environnements distribués, dont formation à distance, apprentissage en ligne, simulations, apprentissage mobile et autres expériences en réseau.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/distributed-simulation",
      "skos:prefLabel": {
        "@value": "Simulation distribuée",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/distributed-simulation-1",
      "rdf:value": {
        "@value": "Simulation réalisée sur des systèmes en réseau permettant à plusieurs participants ou entités simulées d’interagir dans un scénario ou environnement synthétique partagé.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/document-profile-resource",
      "skos:prefLabel": {
        "@value": "Ressource de profil documentaire",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/document-profile-resource-1",
      "rdf:value": {
        "@value": "Structure xAPI stockant des informations de type document sur un agent ou une activité sous forme de paires nom-document utiles à un composant du système pédagogique, distincte d’un profil xAPI.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/edtech-ecosystem",
      "skos:prefLabel": {
        "@value": "Écosystème des technologies éducatives",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/edtech-ecosystem-1",
      "rdf:value": {
        "@value": "Réseau d’acteurs publics, privés, universitaires, associatifs, donateurs, scolaires, familiaux et apprenants participant au développement, à la fourniture, à la gouvernance et à l’utilisation des technologies éducatives.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/unesco-education-domain",
      "skos:prefLabel": {
        "@value": "Éducation",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/unesco-education-domain-1",
      "rdf:value": {
        "@value": "Processus par lequel les personnes développent des aptitudes, attitudes, connaissances et comportements valorisés par la société où elles vivent.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/education-data-cycle",
      "skos:prefLabel": {
        "@value": "Cycle des données éducatives",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/education-data-cycle-1",
      "rdf:value": {
        "@value": "Séquence récurrente où les données éducatives sont produites et rendues disponibles, communiquées et partagées, analysées puis utilisées pour éclairer les décisions et les besoins ultérieurs en données.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/education-data-ecosystem",
      "skos:prefLabel": {
        "@value": "Écosystème des données éducatives",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/education-data-ecosystem-1",
      "rdf:value": {
        "@value": "Ensemble interconnecté de sources de données, processus de production et de diffusion, pratiques analytiques, institutions et usages appuyant la prise de décision fondée sur des preuves dans un système éducatif.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/education-data-integration",
      "skos:prefLabel": {
        "@value": "Intégration des données éducatives",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/education-data-integration-1",
      "rdf:value": {
        "@value": "Combinaison et mise en relation de données provenant de différentes sources éducatives ou connexes pour obtenir une vision plus cohérente, combler des lacunes et permettre des analyses impossibles à partir d’une seule source.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/education-expenditure-data",
      "skos:prefLabel": {
        "@value": "Données sur les dépenses d’éducation",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/education-expenditure-data-1",
      "rdf:value": {
        "@value": "Données financières sur les recettes et dépenses éducatives de sources publiques, privées, ménagères et autres, comprenant infrastructures, personnel et autres coûts éducatifs.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/education-management-information-system",
      "skos:prefLabel": {
        "@value": "Système d’information pour la gestion de l’éducation (SIGE)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/education-management-information-system-1",
      "rdf:value": {
        "@value": "Système utilisé par les autorités éducatives pour recueillir, traiter, analyser, suivre et diffuser des données administratives aux fins de la gestion et de la planification de l’éducation.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/education-statistical-capacity",
      "skos:prefLabel": {
        "@value": "Capacité statistique en éducation",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/education-statistical-capacity-1",
      "rdf:value": {
        "@value": "Capacité d’un système éducatif à produire, communiquer, évaluer et utiliser des données suffisamment complètes et fiables pour établir des indicateurs et soutenir politiques et gouvernance.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/education-technology-edtech",
      "skos:prefLabel": {
        "@value": "Technologies éducatives (EdTech)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/education-technology-edtech-1",
      "rdf:value": {
        "@value": "Utilisation de matériels, logiciels, contenus numériques, données et systèmes d’information dans l’éducation pour soutenir enseignement, apprentissage, gestion et prestation des services éducatifs.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/unesco-educational-administration",
      "skos:prefLabel": {
        "@value": "Administration de l’éducation",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/unesco-educational-administration-1",
      "rdf:value": {
        "@value": "Organisation et administration d’une partie ou de la totalité d’un système éducatif, y compris les structures et processus de coordination, réglementation, supervision et soutien des activités éducatives.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/unesco-educational-evaluation",
      "skos:prefLabel": {
        "@value": "Évaluation éducative",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/unesco-educational-evaluation-1",
      "rdf:value": {
        "@value": "Appréciation systématique des performances ou de la qualité de l’éducation, y compris l’évaluation des apprenants, enseignants, programmes, acquis antérieurs, établissements et résultats éducatifs.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/unesco-educational-facilities",
      "skos:prefLabel": {
        "@value": "Installations éducatives",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/unesco-educational-facilities-1",
      "rdf:value": {
        "@value": "Ressources physiques et matérielles soutenant l’éducation, notamment bâtiments, équipements, supports d’apprentissage, terrains de jeu et autres installations scolaires ou universitaires.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/unesco-educational-institutions",
      "skos:prefLabel": {
        "@value": "Établissements d’enseignement",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/unesco-educational-institutions-1",
      "rdf:value": {
        "@value": "Organisations et structures dispensant l’éducation, notamment écoles, établissements supérieurs, centres de formation, établissements d’éducation des adultes et autres lieux d’apprentissage organisé.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/unesco-educational-management",
      "skos:prefLabel": {
        "@value": "Gestion des établissements d’enseignement",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/unesco-educational-management-1",
      "rdf:value": {
        "@value": "Gestion des établissements éducatifs et de leurs activités pédagogiques, opérationnelles, humaines, matérielles, financières, administratives et de suivi de l’assiduité.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/unesco-educational-planning",
      "skos:prefLabel": {
        "@value": "Planification de l’éducation",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/unesco-educational-planning-1",
      "rdf:value": {
        "@value": "Processus systématique d’analyse des besoins éducatifs, de définition des objectifs et priorités, d’anticipation des besoins futurs et d’organisation des ressources et actions pour améliorer un système éducatif.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/unesco-educational-policy",
      "skos:prefLabel": {
        "@value": "Politique éducative",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/unesco-educational-policy-1",
      "rdf:value": {
        "@value": "Ensemble des objectifs, principes et orientations officielles guidant un système éducatif et les décisions relatives à l’accès, aux droits, aux priorités, aux normes, aux ressources et aux réformes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/unesco-educational-population",
      "skos:prefLabel": {
        "@value": "Population éducative",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/unesco-educational-population-1",
      "rdf:value": {
        "@value": "Personnes participant aux systèmes éducatifs et les soutenant, notamment apprenants, enseignants, administrateurs, conseillers, planificateurs, personnel de soutien et autres professionnels de l’éducation.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/unesco-educational-sciences-and-environment",
      "skos:prefLabel": {
        "@value": "Sciences de l’éducation et milieu éducatif",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/unesco-educational-sciences-and-environment-1",
      "rdf:value": {
        "@value": "Étude interdisciplinaire de l’éducation et des milieux dans lesquels se déroulent l’enseignement et l’apprentissage, intégrant les influences pédagogiques, psychologiques, sociales, historiques, philosophiques, culturelles et contextuelles.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/unesco-educational-systems-and-levels",
      "skos:prefLabel": {
        "@value": "Systèmes et niveaux d’enseignement",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/unesco-educational-systems-and-levels-1",
      "rdf:value": {
        "@value": "Structures organisées de l’éducation formelle et non formelle, comprenant établissements, programmes, parcours et étapes ou niveaux successifs constituant un système éducatif.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/empathy",
      "skos:prefLabel": {
        "@value": "Empathie",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/empathy-1",
      "rdf:value": {
        "@value": "Effort pour comprendre les besoins, expériences, contraintes, motivations et contextes des utilisateurs de leur propre point de vue.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/empathy-mapping",
      "skos:prefLabel": {
        "@value": "Carte d’empathie",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/empathy-mapping-1",
      "rdf:value": {
        "@value": "Technique structurée organisant les observations sur ce que les utilisateurs disent, font, pensent, ressentent, nécessitent ou vivent.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/endpoint",
      "skos:prefLabel": {
        "@value": "Point de terminaison",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/endpoint-1",
      "rdf:value": {
        "@value": "Point d’entrée permettant de communiquer avec un service. Dans xAPI, les ressources sont accessibles par des IRI ou URL rattachés au point de terminaison d’un LRS.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/engineering-design",
      "skos:prefLabel": {
        "@value": "Conception en ingénierie",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/engineering-design-1",
      "rdf:value": {
        "@value": "Processus de résolution de problèmes élaborant et évaluant des solutions au regard des exigences, données probantes, contraintes, interfaces et compromis.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/enterprise-learner-record",
      "skos:prefLabel": {
        "@value": "Dossier d’apprentissage d’entreprise",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/enterprise-learner-record-1",
      "rdf:value": {
        "@value": "Dossier organisationnel intégrant les données sur un apprenant à travers différentes expériences, systèmes, programmes ou périodes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/equity",
      "skos:prefLabel": {
        "@value": "Équité",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/equity-1",
      "rdf:value": {
        "@value": "Examen de la manière dont les occasions d’apprentissage, technologies, processus et résultats tiennent équitablement compte de besoins et conditions différents.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ethics-by-design",
      "skos:prefLabel": {
        "@value": "Éthique dès la conception",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ethics-by-design-1",
      "rdf:value": {
        "@value": "Approche intégrant délibérément les exigences éthiques dans la conception et la validation des systèmes d’IA, plutôt que seulement après leur déploiement.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ethics-of-ai",
      "skos:prefLabel": {
        "@value": "Éthique de l’IA",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ethics-of-ai-1",
      "rdf:value": {
        "@value": "Ensemble de valeurs, principes, réglementations, règles institutionnelles et orientations pratiques servant à évaluer et gouverner la conception et l’usage de l’intelligence artificielle.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/evidence-based-decision-making",
      "skos:prefLabel": {
        "@value": "Prise de décision fondée sur des données probantes",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/evidence-based-decision-making-1",
      "rdf:value": {
        "@value": "Utilisation de données et de preuves pour éclairer les décisions relatives à l’enseignement, à l’apprentissage, aux programmes, aux politiques et à la gestion des systèmes éducatifs.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/evidence-based-practice",
      "skos:prefLabel": {
        "@value": "Pratique fondée sur des données probantes",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/evidence-based-practice-1",
      "rdf:value": {
        "@value": "Utilisation de recherches crédibles et de preuves empiriques pour guider la conception, la mise en œuvre et l’amélioration des expériences et systèmes d’apprentissage.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/experience-api-xapi",
      "skos:prefLabel": {
        "@value": "Experience API (xAPI)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/experience-api-xapi-1",
      "rdf:value": {
        "@value": "Spécification de technologies d’apprentissage normalisée dans la famille IEEE 9274, servant à représenter et à échanger des enregistrements d’expériences d’apprentissage et de performance.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/experience-design",
      "skos:prefLabel": {
        "@value": "Conception d’expérience",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/experience-design-1",
      "rdf:value": {
        "@value": "Pratique de conception visant à façonner les qualités sensorielles, émotionnelles, cognitives, comportementales et sociales d’une expérience pour la rendre plus significative et mémorable.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/experiential-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage expérientiel",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/experiential-learning-1",
      "rdf:value": {
        "@value": "Apprentissage où les connaissances se construisent par l’expérience et la réflexion, souvent décrit comme un processus récursif d’expérience, réflexion, conceptualisation et action.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/extended-mooc-xmooc",
      "skos:prefLabel": {
        "@value": "MOOC transmissif (xMOOC)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/extended-mooc-xmooc-1",
      "rdf:value": {
        "@value": "Modèle de cours en ligne ouvert à grande échelle conservant libre accès et participation massive tout en adoptant généralement des structures pédagogiques instructivistes plus traditionnelles.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/external-representation",
      "skos:prefLabel": {
        "@value": "Représentation externe",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/external-representation-1",
      "rdf:value": {
        "@value": "Objet concret, tel qu’un croquis, modèle, carte conceptuelle ou prototype, qui rend visible le raisonnement de conception pour soutenir réflexion, communication, collaboration et itération.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/extraneous-cognitive-load",
      "skos:prefLabel": {
        "@value": "Charge cognitive extrinsèque",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/extraneous-cognitive-load-1",
      "rdf:value": {
        "@value": "Effort mental provoqué par des caractéristiques de la tâche ou de sa présentation ne contribuant pas directement à l’objectif d’apprentissage.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/fairness",
      "skos:prefLabel": {
        "@value": "Équité de traitement",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/fairness-1",
      "rdf:value": {
        "@value": "Évaluation visant à déterminer si données, modèles, évaluations, processus ou décisions traitent les personnes et groupes de façon appropriée selon des critères pertinents.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/feedback-loop",
      "skos:prefLabel": {
        "@value": "Boucle de rétroaction",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/feedback-loop-1",
      "rdf:value": {
        "@value": "Cycle où les informations sur les résultats ou le comportement du système sont transmises aux apprenants, enseignants, concepteurs ou systèmes pour influencer les actions suivantes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/flipped-classroom",
      "skos:prefLabel": {
        "@value": "Classe inversée",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/flipped-classroom-1",
      "rdf:value": {
        "@value": "Approche pédagogique déplaçant la transmission directe des contenus hors du temps de classe et consacrant les rencontres en présence à des activités d’apprentissage plus interactives.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/flow",
      "skos:prefLabel": {
        "@value": "État de flux",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/flow-1",
      "rdf:value": {
        "@value": "État d’engagement profond où défi et compétences sont bien ajustés et où l’attention se concentre fortement sur l’activité.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/formative-assessment",
      "skos:prefLabel": {
        "@value": "Évaluation formative des apprentissages",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/formative-assessment-1",
      "rdf:value": {
        "@value": "Évaluation réalisée pendant l’apprentissage pour recueillir des informations guidant l’amélioration, la rétroaction, l’enseignement ou les étapes suivantes, plutôt que de seulement certifier un résultat final.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/future-learning-ecosystem",
      "skos:prefLabel": {
        "@value": "Écosystème d’apprentissage du futur",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/future-learning-ecosystem-1",
      "rdf:value": {
        "@value": "Vision de l’apprentissage comme continuum connecté tout au long de la vie, plutôt qu’une succession d’épisodes isolés, avec des expériences adaptées aux individus à travers lieux, médias, organisations et périodes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/growth-mindset",
      "skos:prefLabel": {
        "@value": "État d’esprit de développement",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/growth-mindset-1",
      "rdf:value": {
        "@value": "Conviction que les capacités peuvent se développer au fil du temps grâce aux efforts, stratégies efficaces, rétroactions et apprentissages.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/human-accountability-in-ai",
      "skos:prefLabel": {
        "@value": "Responsabilité humaine en matière d’IA",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/human-accountability-in-ai-1",
      "rdf:value": {
        "@value": "Principe selon lequel les personnes restent responsables des décisions et résultats des boucles décisionnelles humain-IA et ne peuvent transférer cette responsabilité à un système d’IA.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/human-agency-in-ai",
      "skos:prefLabel": {
        "@value": "Pouvoir d’agir humain face à l’IA",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/human-agency-in-ai-1",
      "rdf:value": {
        "@value": "Capacité des personnes à conserver une autonomie, un jugement et une maîtrise réels dans l’évaluation et l’utilisation des systèmes d’IA, sans laisser l’IA remplacer les décisions humaines.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/human-support-system",
      "skos:prefLabel": {
        "@value": "Système de soutien humain",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/human-support-system-1",
      "rdf:value": {
        "@value": "Ensemble de personnes, rôles, pratiques et structures organisationnelles offrant conseils, accompagnement, enseignement, facilitation ou autres formes de soutien aux apprenants.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/human-centered-design",
      "skos:prefLabel": {
        "@value": "Conception centrée sur l’humain",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/human-centered-design-1",
      "rdf:value": {
        "@value": "Approche de conception fondée sur la compréhension des personnes, de leurs objectifs, de leurs contextes, de leurs contraintes et de leurs expériences, à travers une démarche itérative de recherche et d’essai.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/human-centered-education",
      "skos:prefLabel": {
        "@value": "Éducation centrée sur l’humain",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/human-centered-education-1",
      "rdf:value": {
        "@value": "Approche considérant l’apprentissage comme une activité profondément humaine et sociale et utilisant la technologie pour soutenir les relations entre apprenants, éducateurs et communautés.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/human-centred-approach-to-ai",
      "skos:prefLabel": {
        "@value": "Approche de l’IA centrée sur l’humain",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/human-centred-approach-to-ai-1",
      "rdf:value": {
        "@value": "Approche plaçant capacités et droits humains, inclusion, sécurité, responsabilité et développement durable au cœur de la conception, sélection, utilisation et surveillance des systèmes d’IA.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/human-centred-mindset",
      "skos:prefLabel": {
        "@value": "État d’esprit centré sur l’humain",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/human-centred-mindset-1",
      "rdf:value": {
        "@value": "Orientation fondée sur des valeurs et attitudes envers l’interaction humain-IA, maintenant droits, épanouissement, pouvoir d’agir et responsabilité humains au centre de l’usage de l’IA.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/human-controlled-ai-in-education",
      "skos:prefLabel": {
        "@value": "IA sous contrôle humain dans l’éducation",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/human-controlled-ai-in-education-1",
      "rdf:value": {
        "@value": "Principe selon lequel la sélection, l’utilisation, la surveillance et les décisions importantes impliquant l’IA restent soumises à un contrôle et à une responsabilité humains effectifs.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/human-systems-integration-hsi",
      "skos:prefLabel": {
        "@value": "Intégration humain-systèmes (HSI)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/human-systems-integration-hsi-1",
      "rdf:value": {
        "@value": "Philosophie et ensemble de processus traitant de la performance humaine au niveau du système pendant sa conception, son développement, son exploitation et son cycle de vie élargi.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/identified-group",
      "skos:prefLabel": {
        "@value": "Groupe identifié",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/identified-group-1",
      "rdf:value": {
        "@value": "Groupe xAPI possédant son propre identifiant fonctionnel inverse, permettant de le reconnaître indépendamment de sa liste actuelle de membres.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ieee-1484-11-1-2022-content-object-communication",
      "skos:prefLabel": {
        "@value": "IEEE 1484.11.1-2022 — Data Model for Content Object Communication",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ieee-1484-11-1-2022-content-object-communication-1",
      "rdf:value": {
        "@value": "Norme IEEE définissant le modèle de données pour échanger des renseignements sur apprenant, interactions, objectifs, statut, temps, préférences et résultats entre un objet de contenu pédagogique et un service d’exécution, généralement au sein d’un LMS.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ieee-1484-11-2-2020-ecmascript-runtime-api",
      "skos:prefLabel": {
        "@value": "IEEE 1484.11.2-2020 — ECMAScript API for Content-to-Runtime Communication",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ieee-1484-11-2-2020-ecmascript-runtime-api-1",
      "rdf:value": {
        "@value": "Norme IEEE définissant une interface de programmation ECMAScript entre contenu pédagogique et service d’exécution, généralement fourni par un LMS, et normalisant les services d’API pour l’échange de données d’apprentissage en cours d’exécution.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ieee-1484-12-1-2020-learning-object-metadata",
      "skos:prefLabel": {
        "@value": "IEEE 1484.12.1-2020 — Learning Object Metadata",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ieee-1484-12-1-2020-learning-object-metadata-1",
      "rdf:value": {
        "@value": "Norme IEEE définissant le schéma conceptuel des métadonnées décrivant les objets pédagogiques, notamment cycle de vie, usage éducatif, exigences techniques, droits, relations, annotations et classifications.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ieee-1484-12-3-2020-xml-binding-learning-object-metadata",
      "skos:prefLabel": {
        "@value": "IEEE 1484.12.3-2020 — XML Binding for Learning Object Metadata",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ieee-1484-12-3-2020-xml-binding-learning-object-metadata-1",
      "rdf:value": {
        "@value": "Norme IEEE définissant une liaison de schéma XML du W3C pour le modèle LOM afin d’encoder les instances de métadonnées en XML et de les échanger de façon cohérente entre systèmes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ieee-1484-13-3-2014-mpeg21-mapping",
      "skos:prefLabel": {
        "@value": "IEEE 1484.13.3-2014 — MPEG-21 Digital Item Declaration Mapping",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ieee-1484-13-3-2014-mpeg21-mapping-1",
      "rdf:value": {
        "@value": "Pratique recommandée IEEE reliant éléments et attributs du modèle MPEG-21 Digital Item Declaration au modèle conceptuel IEEE d’agrégation de ressources d’apprentissage, d’éducation et de formation.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ieee-1484-13-4-2016-ims-content-packaging-mapping",
      "skos:prefLabel": {
        "@value": "IEEE 1484.13.4-2016 — IMS Content Packaging Mapping",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ieee-1484-13-4-2016-ims-content-packaging-mapping-1",
      "rdf:value": {
        "@value": "Pratique recommandée IEEE reliant les éléments et attributs du modèle d’information IMS Content Packaging version 1.2 au modèle conceptuel IEEE d’agrégation de ressources éducatives et de formation.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ieee-1484-13-6-2015-oai-ore-mapping",
      "skos:prefLabel": {
        "@value": "IEEE 1484.13.6-2015 — OAI-ORE Resource Aggregation Mapping",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ieee-1484-13-6-2015-oai-ore-mapping-1",
      "rdf:value": {
        "@value": "Pratique recommandée IEEE reliant le modèle abstrait OAI-ORE et sa représentation de carte de ressources RDF/XML au modèle conceptuel IEEE d’agrégation de ressources.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ieee-1484-2-2024-learning-employment-record-ecosystems",
      "skos:prefLabel": {
        "@value": "IEEE 1484.2-2024 — Learning and Employment Record Ecosystems",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ieee-1484-2-2024-learning-employment-record-ecosystems-1",
      "rdf:value": {
        "@value": "Pratique recommandée IEEE pour les systèmes à l’échelle d’un écosystème émettant, conservant, présentant et échangeant des dossiers d’apprentissage et d’emploi (LER) à l’aide d’attestations numériques interopérables et de services partagés.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ieee-1484-20-2-2022-defining-competencies",
      "skos:prefLabel": {
        "@value": "IEEE 1484.20.2-2022 — Defining Competencies",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ieee-1484-20-2-2022-defining-competencies-1",
      "rdf:value": {
        "@value": "Pratique recommandée IEEE pour définir compétences et référentiels, incluant les informations décrivant savoir-faire, connaissances, capacités, attitudes, habitudes professionnelles, comportements et acquis d’apprentissage favorisant l’interopérabilité des données.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ieee-1484-20-3-2022-shareable-competency-definitions",
      "skos:prefLabel": {
        "@value": "IEEE 1484.20.3-2022 — Shareable Competency Definitions",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ieee-1484-20-3-2022-shareable-competency-definitions-1",
      "rdf:value": {
        "@value": "Norme IEEE définissant un modèle de données pour décrire, référencer et partager définitions et référentiels de compétences ainsi que rubriques d’évaluation entre systèmes d’apprentissage, de certification, de main-d’œuvre et d’emploi.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ieee-1589-2020-ar-learning-experience-model",
      "skos:prefLabel": {
        "@value": "IEEE 1589-2020 — Augmented Reality Learning Experience Model",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ieee-1589-2020-ar-learning-experience-model-1",
      "rdf:value": {
        "@value": "Norme IEEE pour des systèmes interopérables d’apprentissage en réalité augmentée, définissant les liens entre monde physique, apprenant, informations numériques, activités et environnement, ainsi que des modèles de données et liaisons XML/JSON représentant activités et contexte.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ieee-2881-2025-learning-metadata-terms",
      "skos:prefLabel": {
        "@value": "IEEE 2881-2025 — Learning Metadata Terms",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ieee-2881-2025-learning-metadata-terms-1",
      "rdf:value": {
        "@value": "Norme IEEE définissant des classes et propriétés de métadonnées extensibles pour décrire ressources et événements d’apprentissage, compatibles avec les approches RDF et représentables notamment sous forme de graphes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ieee-2955-2025-self-learning-tutorials-side-by-side-learning",
      "skos:prefLabel": {
        "@value": "IEEE 2955-2025 — Self-Learning Tutorials and Side-by-Side Learning",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ieee-2955-2025-self-learning-tutorials-side-by-side-learning-1",
      "rdf:value": {
        "@value": "Pratique recommandée IEEE décrivant des méthodes de création de tutoriels d’autoformation, notamment par captures vidéo commentées ou narration orale, et des techniques d’apprentissage côte à côte.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ieee-3527-1-2020-digital-intelligence-framework",
      "skos:prefLabel": {
        "@value": "IEEE 3527.1-2020 — Digital Intelligence (DQ) Framework",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ieee-3527-1-2020-digital-intelligence-framework-1",
      "rdf:value": {
        "@value": "Norme IEEE définissant un référentiel d’intelligence numérique, dont littératie, compétences et préparation numériques, dans huit domaines : identité, utilisation, sûreté, sécurité, intelligence émotionnelle, littératie, communication et droits, selon les niveaux de citoyenneté, créativité et compétitivité.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ieee-9274-1-1-2023-xapi",
      "skos:prefLabel": {
        "@value": "IEEE 9274.1.1-2023 — Experience API (xAPI)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ieee-9274-1-1-2023-xapi-1",
      "rdf:value": {
        "@value": "Norme IEEE définissant le modèle de données xAPI et le service web REST permettant de communiquer les données d’expériences d’apprentissage et de performance humaine entre activités et Learning Record Store (LRS), selon un modèle JSON et des comportements dérivés de xAPI 1.0.3.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ieee-learning-technology-standards-committee-ltsc",
      "skos:prefLabel": {
        "@value": "IEEE Learning Technology Standards Committee (LTSC)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ieee-learning-technology-standards-committee-ltsc-1",
      "rdf:value": {
        "@value": "Comité de normalisation IEEE élaborant et maintenant les normes relatives aux technologies d’apprentissage et à l’interopérabilité des données associées.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/implementation",
      "skos:prefLabel": {
        "@value": "Mise en œuvre",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/implementation-1",
      "rdf:value": {
        "@value": "Étape où une solution d’apprentissage est déployée dans son environnement prévu, surveillée, soutenue et ajustée selon les données probantes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/inference-modeling",
      "skos:prefLabel": {
        "@value": "Modélisation des inférences",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/inference-modeling-1",
      "rdf:value": {
        "@value": "Utilisation de modèles pour inférer des états latents, relations ou explications à partir de données observées.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/instructional-designer",
      "skos:prefLabel": {
        "@value": "Concepteur pédagogique",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/instructional-designer-1",
      "rdf:value": {
        "@value": "Professionnel analysant les besoins d’apprentissage et concevant, développant, mettant en œuvre et évaluant enseignement, expériences pédagogiques, supports et systèmes connexes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/instructor-facilitated-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage accompagné par un formateur",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/instructor-facilitated-learning-1",
      "rdf:value": {
        "@value": "Apprentissage où un formateur guide, structure, soutient les apprenants ou répond à leurs besoins pendant leurs activités.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/instrumentation",
      "skos:prefLabel": {
        "@value": "Instrumentation",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/instrumentation-1",
      "rdf:value": {
        "@value": "Capteurs, logiciels, schémas, définitions d’événements, identifiants et processus permettant d’observer et de consigner ce qui se passe dans un système.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/intelligent-tutoring-system",
      "skos:prefLabel": {
        "@value": "Système tutoriel intelligent",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/intelligent-tutoring-system-1",
      "rdf:value": {
        "@value": "Système pédagogique informatisé utilisant des procédures automatisées pour guider les apprenants dans la résolution de problèmes, fournir des indices et des rétroactions et adapter le soutien à leurs performances.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/interaction-activity",
      "skos:prefLabel": {
        "@value": "Interaction Activity",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Activité d’interaction",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/interaction-activity-1",
      "rdf:value": {
        "@value": "Définition d’activité xAPI décrivant une interaction, par exemple vrai-faux, choix, réponse à compléter, association, performance, mise en ordre, échelle de Likert ou réponse numérique.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/internationalized-resource-identifier-iri",
      "skos:prefLabel": {
        "@value": "Identifiant internationalisé de ressource (IRI)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/internationalized-resource-identifier-iri-1",
      "rdf:value": {
        "@value": "Format d’identifiant globalement unique utilisé dans xAPI pour identifier verbes, activités, types d’activités, extensions et concepts de vocabulaire ; les IRI peuvent contenir des caractères internationaux et comprennent un schéma.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/internationalized-resource-locator-irl",
      "skos:prefLabel": {
        "@value": "Internationalized Resource Locator (IRL)",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Localisateur internationalisé de ressource (IRL)",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/internationalized-resource-locator-irl-1",
      "rdf:value": {
        "@value": "Dans la norme xAPI, IRI pouvant être converti en URI ayant la fonction d’une URL.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/interoperability",
      "skos:prefLabel": {
        "@value": "Interopérabilité",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/interoperability-1",
      "rdf:value": {
        "@value": "Capacité de systèmes, de services et de données à fonctionner ensemble grâce à des interfaces, des formats, des sémantiques et des attentes partagés.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/inverse-functional-identifier-ifi",
      "skos:prefLabel": {
        "@value": "Identifiant fonctionnel inverse (IFI)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/inverse-functional-identifier-ifi-1",
      "rdf:value": {
        "@value": "Identifiant utilisé par xAPI pour identifier de manière unique une persona d’agent ou un groupe, comme une adresse électronique, son empreinte, un OpenID ou un compte.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/investigation-phase",
      "skos:prefLabel": {
        "@value": "Phase d’investigation",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/investigation-phase-1",
      "rdf:value": {
        "@value": "Étape du processus d’ingénierie de l’apprentissage où les données recueillies sont analysées pour examiner les résultats et déterminer dans quelle mesure une solution répond au défi d’apprentissage.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/iterative-design",
      "skos:prefLabel": {
        "@value": "Conception itérative",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/iterative-design-1",
      "rdf:value": {
        "@value": "Approche de conception dans laquelle les solutions sont créées, testées, évaluées et améliorées de façon répétée.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/json",
      "skos:prefLabel": {
        "@value": "JSON",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/json-1",
      "rdf:value": {
        "@value": "Format textuel léger représentant des données structurées au moyen d’objets, de tableaux, de noms et de valeurs.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/json-ld",
      "skos:prefLabel": {
        "@value": "JSON-LD",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/json-ld-1",
      "rdf:value": {
        "@value": "Format de données liées fondé sur JSON, associant les structures JSON habituelles à des identifiants et relations sémantiques interprétables en RDF.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/kanban",
      "skos:prefLabel": {
        "@value": "Kanban",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/kanban-1",
      "rdf:value": {
        "@value": "Méthode de gestion des flux de travail qui visualise les tâches, limite le travail en cours et favorise un flux continu.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/knowledge-retention",
      "skos:prefLabel": {
        "@value": "Rétention des connaissances",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/knowledge-retention-1",
      "rdf:value": {
        "@value": "Persistance des connaissances ou compétences acquises dans le temps afin de pouvoir les retrouver et les utiliser ultérieurement.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/language-map",
      "skos:prefLabel": {
        "@value": "Language Map",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Carte linguistique",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/language-map-1",
      "rdf:value": {
        "@value": "Dictionnaire xAPI dont les clés sont des étiquettes de langue RFC 5646 et les valeurs des chaînes de caractères dans les langues correspondantes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/laser-national-education-statistical-capacity-assessment",
      "skos:prefLabel": {
        "@value": "LASER",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/laser-national-education-statistical-capacity-assessment-1",
      "rdf:value": {
        "@value": "Cadre d’évaluation de l’Institut de statistique de l’UNESCO permettant d’apprécier et de renforcer les écosystèmes nationaux de données éducatives : évaluations des acquis, données administratives, enquêtes, dépenses, examen et suivi.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/lean-agile",
      "skos:prefLabel": {
        "@value": "Approche lean-agile",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/lean-agile-1",
      "rdf:value": {
        "@value": "Famille d’approches associant développement itératif, fluidité, réduction des gaspillages, rétroaction rapide et création de valeur.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learner-agency",
      "skos:prefLabel": {
        "@value": "Pouvoir d’agir de l’apprenant",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learner-agency-1",
      "rdf:value": {
        "@value": "Capacité et possibilité pour les apprenants de faire des choix, d’exercer un contrôle et de participer activement à l’orientation de leur apprentissage.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learner-feedback-loop",
      "skos:prefLabel": {
        "@value": "Boucle de rétroaction de l’apprenant",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learner-feedback-loop-1",
      "rdf:value": {
        "@value": "Cycle dans lequel les données sur l’activité ou les résultats d’un apprenant éclairent les conseils, exercices, soutiens ou comportements ultérieurs du système.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learner-model",
      "skos:prefLabel": {
        "@value": "Modèle de l’apprenant",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learner-model-1",
      "rdf:value": {
        "@value": "Représentation de caractéristiques pertinentes d’un apprenant, comme connaissances, compétences, performances, préférences, objectifs, contexte ou états, utilisée pour guider l’enseignement ou la personnalisation.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learner-privacy",
      "skos:prefLabel": {
        "@value": "Protection de la vie privée des apprenants",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learner-privacy-1",
      "rdf:value": {
        "@value": "Protection et gestion des intérêts de confidentialité liés à la collecte, la modélisation, au partage, au stockage et à l’utilisation de données sur les apprenants et leurs activités.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-analytics",
      "skos:prefLabel": {
        "@value": "Analytique de l’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-analytics-1",
      "rdf:value": {
        "@value": "Analyse et utilisation des données d’environnements d’apprentissage pour comprendre et améliorer les expériences, stratégies pédagogiques et décisions connexes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-analytics-dashboard",
      "skos:prefLabel": {
        "@value": "Tableau de bord d’analytique de l’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-analytics-dashboard-1",
      "rdf:value": {
        "@value": "Interface visuelle présentant analyses d’apprentissage, profils d’activité, indicateurs de performance, relations ou interventions recommandées aux apprenants et autres parties prenantes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-assessment",
      "skos:prefLabel": {
        "@value": "Évaluation des acquis d’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-assessment-1",
      "rdf:value": {
        "@value": "Processus structuré mesurant connaissances et compétences des apprenants dans des matières définies à certains âges ou niveaux scolaires, souvent pour estimer les acquis d’un système éducatif plus large.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-community",
      "skos:prefLabel": {
        "@value": "Communauté d’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-community-1",
      "rdf:value": {
        "@value": "Groupe d’apprenants collaborant sur des problèmes ou objectifs dans des espaces physiques ou virtuels, avec des normes, processus et soutiens communs.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-design-practitioner",
      "skos:prefLabel": {
        "@value": "Professionnel de la conception d’apprentissage (LDP)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-design-practitioner-1",
      "rdf:value": {
        "@value": "Terme générique désignant les personnes qui conçoivent ressources ou expériences d’apprentissage, notamment concepteurs pédagogiques, ingénieurs de l’apprentissage et technologues de l’éducation.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-ecosystem-governance",
      "skos:prefLabel": {
        "@value": "Gouvernance de l’écosystème d’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-ecosystem-governance-1",
      "rdf:value": {
        "@value": "Structures et processus coordonnant autorités, politiques, ressources, normes, soutien, expérimentation et décisions à travers un écosystème d’apprentissage.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-engineer",
      "skos:prefLabel": {
        "@value": "Ingénieur de l’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-engineer-1",
      "rdf:value": {
        "@value": "Professionnel appliquant à grande échelle les preuves sur l’apprentissage et le développement humains pour créer des environnements d’apprentissage fiables, abordables et riches en données dans des contextes réels.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-engineering",
      "skos:prefLabel": {
        "@value": "Ingénierie de l’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-engineering-1",
      "rdf:value": {
        "@value": "Démarche qui mobilise les sciences de l’apprentissage, la conception centrée sur l’humain, les méthodes d’ingénierie et la prise de décision éclairée par les données pour soutenir les apprenants et leur développement.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/leed-tracker",
      "skos:prefLabel": {
        "@value": "Registre LEED des preuves et décisions en ingénierie de l’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/leed-tracker-1",
      "rdf:value": {
        "@value": "Structure documentaire consignant décisions de conception, justifications, sources d’influence et révisions dans le cadre du processus d’ingénierie de l’apprentissage.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-engineering-process",
      "skos:prefLabel": {
        "@value": "Processus d’ingénierie de l’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-engineering-process-1",
      "rdf:value": {
        "@value": "Processus itératif et mené de façon concomitante pour répondre à des défis d’apprentissage : définir le contexte et les parties prenantes, concevoir et instrumenter une solution, la mettre en œuvre dans des situations authentiques, étudier les résultats à l’aide de données et améliorer continuellement la démarche.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-engineering-team",
      "skos:prefLabel": {
        "@value": "Équipe d’ingénierie de l’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-engineering-team-1",
      "rdf:value": {
        "@value": "Personne ou groupe interdisciplinaire réuni pour répondre à un défi d’apprentissage, dont les compétences et connaissances dépendent du problème, du contexte, des apprenants, parties prenantes et besoins techniques.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-environment",
      "skos:prefLabel": {
        "@value": "Environnement d’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-environment-1",
      "rdf:value": {
        "@value": "Ensemble des conditions physiques, numériques, sociales, organisationnelles et pédagogiques dans lesquelles l’apprentissage se déroule.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-environment-engineering",
      "skos:prefLabel": {
        "@value": "Ingénierie des environnements d’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-environment-engineering-1",
      "rdf:value": {
        "@value": "Application de méthodes d’ingénierie et de systèmes à la conception, à l’intégration et à l’amélioration des environnements d’apprentissage.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-event",
      "skos:prefLabel": {
        "@value": "Événement d’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-event-1",
      "rdf:value": {
        "@value": "Occurrence ou interaction ponctuelle observable ou enregistrable dans le cadre d’une expérience d’apprentissage ou de performance.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-experience",
      "skos:prefLabel": {
        "@value": "Expérience d’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-experience-1",
      "rdf:value": {
        "@value": "Événement lié à l’apprentissage, incluant au sens large cours, lecture, terrain, travail autonome, obtention d’un certificat et autres expériences formelles ou informelles.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-experience-design-lxd",
      "skos:prefLabel": {
        "@value": "Conception d’expériences d’apprentissage (LXD)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-experience-design-lxd-1",
      "rdf:value": {
        "@value": "Conception d’expériences, environnements, interactions et soutiens destinés à aider les personnes à apprendre.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-metadata",
      "skos:prefLabel": {
        "@value": "Métadonnées d’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-metadata-1",
      "rdf:value": {
        "@value": "Informations descriptives structurées sur les ressources, activités, compétences ou autres entités liées à l’apprentissage.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-network",
      "skos:prefLabel": {
        "@value": "Réseau d’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-network-1",
      "rdf:value": {
        "@value": "Réseau de relations entre apprenants, enseignants, parents et communautés élargies favorisant enseignement et apprentissage au-delà des frontières institutionnelles.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-organization",
      "skos:prefLabel": {
        "@value": "Organisation apprenante",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-organization-1",
      "rdf:value": {
        "@value": "Organisation développant sa capacité à apprendre des preuves et expérimentations, à tester des solutions itératives et à adapter ses pratiques selon les enseignements tirés.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-poverty",
      "skos:prefLabel": {
        "@value": "Pauvreté des apprentissages",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-poverty-1",
      "rdf:value": {
        "@value": "Indicateur mesurant la proportion d’enfants de dix ans incapables de lire et comprendre une histoire simple.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-record",
      "skos:prefLabel": {
        "@value": "Enregistrement d’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-record-1",
      "rdf:value": {
        "@value": "Enregistrement lisible par machine représentant des éléments probants relatifs à un événement, à un état, à une étape ou à une réalisation en matière d’apprentissage, de formation ou de performance.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-record-consumer-lrc",
      "skos:prefLabel": {
        "@value": "Learning Record Consumer (LRC)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-record-consumer-lrc-1",
      "rdf:value": {
        "@value": "Client xAPI récupérant des enregistrements d’apprentissage auprès d’un ou plusieurs LRS pour les interpréter, analyser, traduire, diffuser ou agréger.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-record-provider-lrp",
      "skos:prefLabel": {
        "@value": "Learning Record Provider (LRP)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-record-provider-lrp-1",
      "rdf:value": {
        "@value": "Logiciel ou composant système observant des activités et envoyant à un LRS des enregistrements d’événements d’apprentissage conformes aux normes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-record-store-lrs",
      "skos:prefLabel": {
        "@value": "Learning Record Store (LRS)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-record-store-lrs-1",
      "rdf:value": {
        "@value": "Système qui reçoit, stocke et rend accessibles des enregistrements d’apprentissage conformes à xAPI.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-sciences",
      "skos:prefLabel": {
        "@value": "Sciences de l’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-sciences-1",
      "rdf:value": {
        "@value": "Champ interdisciplinaire qui étudie la manière dont les personnes apprennent et les moyens de soutenir l’apprentissage dans ses dimensions cognitives, sociales, motivationnelles, culturelles et contextuelles.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/lifelong-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage tout au long de la vie",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/lifelong-learning-1",
      "rdf:value": {
        "@value": "Vision de l’apprentissage comme activité continue durant toute l’existence et dans des contextes formels, non formels, informels, professionnels, communautaires et vécus.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/linked-data",
      "skos:prefLabel": {
        "@value": "Données liées",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/linked-data-1",
      "rdf:value": {
        "@value": "Méthode de publication et de connexion de données structurées sur le Web à l’aide d’identifiants persistants et de relations lisibles par machine, reliant l’information entre jeux de données et systèmes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/locus-of-control",
      "skos:prefLabel": {
        "@value": "Lieu de contrôle",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/locus-of-control-1",
      "rdf:value": {
        "@value": "Croyance selon laquelle les résultats dépendent principalement de ses propres actions ou de forces indépendantes de sa volonté.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/long-term-memory",
      "skos:prefLabel": {
        "@value": "Mémoire à long terme",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/long-term-memory-1",
      "rdf:value": {
        "@value": "Système de mémoire permettant le stockage durable puis la récupération de connaissances et de compétences sur des périodes prolongées.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/machine-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage automatique",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/machine-learning-1",
      "rdf:value": {
        "@value": "Méthodes informatiques apprenant des régularités à partir de données pour produire prédictions, classifications, recommandations ou autres résultats.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/massive-open-online-course-mooc",
      "skos:prefLabel": {
        "@value": "Cours en ligne ouvert et massif (MOOC)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/massive-open-online-course-mooc-1",
      "rdf:value": {
        "@value": "Cours en ligne conçu pour l’accès ouvert et la participation à grande échelle, souvent auprès d’apprenants de différents établissements et régions.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/mastery-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage de maîtrise",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/mastery-learning-1",
      "rdf:value": {
        "@value": "Approche pédagogique exigeant des apprenants la démonstration d’un niveau défini de maîtrise avant de passer à des contenus ou compétences plus avancés.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/maturity-model",
      "skos:prefLabel": {
        "@value": "Modèle de maturité",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/maturity-model-1",
      "rdf:value": {
        "@value": "Cadre par étapes servant à évaluer les capacités actuelles et orienter leur amélioration progressive, sans faire de la conformité au niveau maximal l’unique objectif.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/meaningful-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage significatif",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/meaningful-learning-1",
      "rdf:value": {
        "@value": "Apprentissage marqué par un engagement intentionnel, actif, constructif, authentique et coopératif permettant de relier les expériences et de construire des compréhensions utilisables.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/mentorship",
      "skos:prefLabel": {
        "@value": "Mentorat",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/mentorship-1",
      "rdf:value": {
        "@value": "Relation de développement où une personne expérimentée montre des connaissances ou compétences et propose progressivement à un apprenant des occasions plus complexes de participer à un travail authentique.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/meta-adaptation",
      "skos:prefLabel": {
        "@value": "Méta-adaptation",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/meta-adaptation-1",
      "rdf:value": {
        "@value": "Adaptation couvrant plusieurs systèmes ou ressources d’apprentissage, où un système utilise des données partagées pour recommander ou coordonner des interventions au-delà de son propre environnement pédagogique.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/metacognition",
      "skos:prefLabel": {
        "@value": "Métacognition",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/metacognition-1",
      "rdf:value": {
        "@value": "Conscience et régulation par l’apprenant de sa pensée, compréhension, de ses stratégies et processus d’apprentissage.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/metacognitive-monitoring",
      "skos:prefLabel": {
        "@value": "Surveillance métacognitive",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/metacognitive-monitoring-1",
      "rdf:value": {
        "@value": "Processus d’observation et d’évaluation de sa propre compréhension, performance, de ses stratégies et progrès pendant un apprentissage ou une tâche.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/metadata-consumer",
      "skos:prefLabel": {
        "@value": "Consommateur de métadonnées",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/metadata-consumer-1",
      "rdf:value": {
        "@value": "Personne, organisation, logiciel ou autre entité déterminant la signification d’un IRI ou récupérant des métadonnées à son sujet.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/metadata-provider",
      "skos:prefLabel": {
        "@value": "Fournisseur de métadonnées",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/metadata-provider-1",
      "rdf:value": {
        "@value": "Personne, organisation, logiciel ou autre entité créant des IRI destinés à xAPI ou hébergeant les métadonnées décrivant ces IRI.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/metadata-tagging",
      "skos:prefLabel": {
        "@value": "Étiquetage par métadonnées",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/metadata-tagging-1",
      "rdf:value": {
        "@value": "Pratique consistant à associer des termes descriptifs ou identifiants structurés à des ressources, événements, compétences ou autres entités d’apprentissage.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/micro-credential",
      "skos:prefLabel": {
        "@value": "Microcertification",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/micro-credential-1",
      "rdf:value": {
        "@value": "Attestation d’une réalisation démontrée dans une unité d’apprentissage ou compétence plus petite qu’un diplôme ou qualification majeure traditionnelle.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/microlearning",
      "skos:prefLabel": {
        "@value": "Microapprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/microlearning-1",
      "rdf:value": {
        "@value": "Apprentissage proposé en unités courtes et ciblées, souvent autonomes, souples et utilisables au moment du besoin.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/minimum-proficiency-level",
      "skos:prefLabel": {
        "@value": "Niveau de compétence minimal",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/minimum-proficiency-level-1",
      "rdf:value": {
        "@value": "Repère indiquant les connaissances ou compétences de base attendues dans un domaine, comme la lecture ou les mathématiques, à un âge ou niveau scolaire donné.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/mixed-reality",
      "skos:prefLabel": {
        "@value": "Réalité mixte",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/mixed-reality-1",
      "rdf:value": {
        "@value": "Continuum de technologies immersives comprenant réalité virtuelle et augmentée, combinant expériences physiques et numériques à différents degrés.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/mobile-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage mobile",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/mobile-learning-1",
      "rdf:value": {
        "@value": "Apprentissage dispensé ou soutenu par des appareils mobiles, permettant souvent un accès généralisé et adapté au contexte au moment du besoin.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/modeling-and-simulation",
      "skos:prefLabel": {
        "@value": "Modélisation et simulation",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/modeling-and-simulation-1",
      "rdf:value": {
        "@value": "Utilisation de représentations abstraites ou informatiques pour étudier le fonctionnement de systèmes, scénarios, comportements ou conceptions dans différentes conditions.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/motivation",
      "skos:prefLabel": {
        "@value": "Motivation",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/motivation-1",
      "rdf:value": {
        "@value": "Processus influençant le déclenchement, l’orientation, la persévérance et la valeur accordée par un apprenant à une activité.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/multi-channel-remote-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage à distance multicanal",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/multi-channel-remote-learning-1",
      "rdf:value": {
        "@value": "Apprentissage à distance utilisant plusieurs canaux, tels que radio, télévision, appareils mobiles et plateformes en ligne, pour atteindre les apprenants malgré des niveaux d’accès différents.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/multi-stakeholder-approach",
      "skos:prefLabel": {
        "@value": "Approche multipartite",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/multi-stakeholder-approach-1",
      "rdf:value": {
        "@value": "Approche réunissant des acteurs internes et externes au système éducatif pour concevoir et mettre en œuvre des programmes et politiques de technologies éducatives.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/multimedia-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage multimédia",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/multimedia-learning-1",
      "rdf:value": {
        "@value": "Apprentissage utilisant plusieurs modes de présentation, par exemple mots, narration, images, animations ou autres médias dans un environnement pédagogique.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/named-graph",
      "skos:prefLabel": {
        "@value": "Graphe nommé",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/named-graph-1",
      "rdf:value": {
        "@value": "Dans le modèle de serveur de profils xAPI, graphe RDF stockant une version de profil sous son URI afin qu’elle puisse être interrogée directement.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/national-sdg-4-benchmark",
      "skos:prefLabel": {
        "@value": "Valeur de référence nationale pour le SDG 4",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/national-sdg-4-benchmark-1",
      "rdf:value": {
        "@value": "Repère quantitatif défini nationalement traduisant les ambitions mondiales de l’ODD 4 en cibles adaptées au contexte pour le suivi des progrès, la responsabilité, la planification et le dialogue politique.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/nudge",
      "skos:prefLabel": {
        "@value": "Coup de pouce comportemental",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/nudge-1",
      "rdf:value": {
        "@value": "Intervention de conception discrète visant à orienter un comportement vers un choix souhaité sans supprimer d’options ni imposer de directive explicite.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/observational-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage par observation",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/observational-learning-1",
      "rdf:value": {
        "@value": "Apprentissage résultant de l’observation des comportements, stratégies, actions ou conséquences vécues par d’autres personnes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/online-learning-modality",
      "skos:prefLabel": {
        "@value": "Modalité d’apprentissage en ligne",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/online-learning-modality-1",
      "rdf:value": {
        "@value": "Mode d’apprentissage en ligne ou à distance caractérisable notamment par la participation synchrone ou asynchrone et par un accompagnement assuré par un formateur ou des ressources.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/open-educational-resources-oer",
      "skos:prefLabel": {
        "@value": "Ressources éducatives libres (REL)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/open-educational-resources-oer-1",
      "rdf:value": {
        "@value": "Ressources d’apprentissage mises à disposition librement pour être utilisées, partagées et souvent adaptées selon des licences ouvertes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/open-standards-and-architecture-for-interoperability",
      "skos:prefLabel": {
        "@value": "Normes ouvertes et architecture d’interopérabilité",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/open-standards-and-architecture-for-interoperability-1",
      "rdf:value": {
        "@value": "Utilisation de normes technologiques ouvertes et d’architectures interopérables pour partager les données entre applications, systèmes et organisations de façon efficace, appropriée et sûre.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/operational-feasibility",
      "skos:prefLabel": {
        "@value": "Faisabilité opérationnelle",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/operational-feasibility-1",
      "rdf:value": {
        "@value": "Degré auquel une solution d’apprentissage envisagée peut être mise en œuvre, soutenue, gouvernée, maintenue et pérennisée dans son environnement réel d’exploitation.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/organizational-leadership",
      "skos:prefLabel": {
        "@value": "Leadership organisationnel",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/organizational-leadership-1",
      "rdf:value": {
        "@value": "Pratique consistant à fixer une orientation, mobiliser les personnes et ressources, façonner la culture et permettre à une organisation d’atteindre des objectifs communs.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/pattern-validation",
      "skos:prefLabel": {
        "@value": "Validation des Patterns",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Validation des motifs",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/pattern-validation-1",
      "rdf:value": {
        "@value": "Processus de validation d’une série de déclarations partageant une inscription et, le cas échéant, une sous-inscription, afin de vérifier leur conformité à un motif de profil donné.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/pedagogical-agent",
      "skos:prefLabel": {
        "@value": "Agent pédagogique",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/pedagogical-agent-1",
      "rdf:value": {
        "@value": "Personnage animé ou informatique conçu pour jouer le rôle de tuteur, pair, guide ou autre présence sociale dans une technologie pédagogique.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/pedagogy",
      "skos:prefLabel": {
        "@value": "Pédagogie",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/pedagogy-1",
      "rdf:value": {
        "@value": "Théorie et pratique de l’enseignement, comprenant les choix de méthodes, progression, interaction, explication, exercices et soutien.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/person-object",
      "skos:prefLabel": {
        "@value": "Person Object",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Objet Person",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/person-object-1",
      "rdf:value": {
        "@value": "Objet de réponse xAPI combinant les identifiants connus d’un agent en tableaux de valeurs, présentant les données dans une perspective centrée sur la personne tout en restant distinct d’une persona d’agent.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/persona",
      "skos:prefLabel": {
        "@value": "Persona",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/persona-1",
      "rdf:value": {
        "@value": "Représentation d’un type d’utilisateur fondée sur la recherche, aidant les équipes à raisonner sur ses objectifs, comportements, contextes et besoins.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/personalization",
      "skos:prefLabel": {
        "@value": "Personnalisation",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/personalization-1",
      "rdf:value": {
        "@value": "Adaptation du contenu, de la progression, du soutien, de l’interface ou des objectifs d’apprentissage aux caractéristiques ou besoins d’un apprenant donné.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/personalized-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage personnalisé",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/personalized-learning-1",
      "rdf:value": {
        "@value": "Apprentissage conçu autour des besoins d’un élève et visant à offrir des possibilités adaptées dans les contextes scolaires et familiaux.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/predictive-modeling",
      "skos:prefLabel": {
        "@value": "Modélisation prédictive",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/predictive-modeling-1",
      "rdf:value": {
        "@value": "Utilisation de modèles statistiques ou d’apprentissage automatique pour estimer des résultats, probabilités ou comportements futurs à partir de données disponibles.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/prior-knowledge",
      "skos:prefLabel": {
        "@value": "Connaissances antérieures",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/prior-knowledge-1",
      "rdf:value": {
        "@value": "Connaissances et compréhension dont un apprenant dispose déjà et qu’il mobilise pour interpréter de nouvelles idées.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/privacy-by-design",
      "skos:prefLabel": {
        "@value": "Protection de la vie privée dès la conception",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/privacy-by-design-1",
      "rdf:value": {
        "@value": "Approche intégrant les protections de la vie privée dès l’architecture et le développement du système plutôt qu’après son déploiement.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/privacy-nudging",
      "skos:prefLabel": {
        "@value": "Incitation à la protection de la vie privée",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/privacy-nudging-1",
      "rdf:value": {
        "@value": "Utilisation d’indices d’interface, de paramètres par défaut, d’explications ou d’autres interventions de conception pour aider les utilisateurs à faire des choix de confidentialité mieux éclairés.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/problem-space",
      "skos:prefLabel": {
        "@value": "Espace du problème",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/problem-space-1",
      "rdf:value": {
        "@value": "Cadre contextuel d’un défi d’apprentissage, réunissant conditions, contraintes, apprenants, parties prenantes, systèmes et incertitudes façonnant les solutions possibles.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/procedural-knowledge",
      "skos:prefLabel": {
        "@value": "Connaissances procédurales",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/procedural-knowledge-1",
      "rdf:value": {
        "@value": "Connaissances permettant de suivre une procédure, d’exécuter une tâche ou de résoudre un problème.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/productive-mindset",
      "skos:prefLabel": {
        "@value": "État d’esprit productif",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/productive-mindset-1",
      "rdf:value": {
        "@value": "Ensemble de croyances et d’attitudes favorisant effort, persévérance, recours aux stratégies et engagement face aux défis d’apprentissage.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/profile-author",
      "skos:prefLabel": {
        "@value": "Auteur de profil",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/profile-author-1",
      "rdf:value": {
        "@value": "Personne ou groupe rédigeant un profil xAPI.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/profile-server",
      "skos:prefLabel": {
        "@value": "Serveur de profils",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/profile-server-1",
      "rdf:value": {
        "@value": "Service centralisé permettant de rechercher, consulter, interroger, stocker et gérer des profils xAPI, concepts de vocabulaire et métadonnées de profils associées.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/profile-validator",
      "skos:prefLabel": {
        "@value": "Validateur de profils",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/profile-validator-1",
      "rdf:value": {
        "@value": "Personne ou machine vérifiant qu’un ensemble donné de données xAPI respecte les règles d’un profil.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/profile-version",
      "skos:prefLabel": {
        "@value": "Version de profil",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/profile-version-1",
      "rdf:value": {
        "@value": "État d’un profil xAPI à un moment donné, avec un historique des versions conservable et interrogeable séparément.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/profile-based-statement-conformance",
      "skos:prefLabel": {
        "@value": "Conformité des déclarations à un profil",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/profile-based-statement-conformance-1",
      "rdf:value": {
        "@value": "Conformité selon laquelle les Statements respectent les Statement Templates et les Patterns applicables définis par une version d’un profil xAPI. Lorsqu’un Learning Record Provider indique cette version au moyen d’une category context activity, les Statements doivent respecter les exigences correspondantes. Les fournisseurs conformes devraient indiquer la version conforme la plus récente du profil lorsqu’ils produisent des Statements respectant ses modèles et motifs.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/project-management",
      "skos:prefLabel": {
        "@value": "Gestion de projet",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/project-management-1",
      "rdf:value": {
        "@value": "Discipline consistant à planifier, coordonner, suivre et maîtriser le travail pour atteindre des objectifs sous contraintes de portée, délais, coûts, qualité et ressources.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/prototype",
      "skos:prefLabel": {
        "@value": "Prototype",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/prototype-1",
      "rdf:value": {
        "@value": "Représentation préliminaire d’une solution envisagée servant à explorer des idées, tester des hypothèses, recueillir des avis ou réduire l’incertitude.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/rapid-prototyping",
      "skos:prefLabel": {
        "@value": "Prototypage rapide",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/rapid-prototyping-1",
      "rdf:value": {
        "@value": "Pratique de création rapide de versions limitées ou peu coûteuses d’une solution afin de les tester et de les modifier.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/reflective-design-documentation",
      "skos:prefLabel": {
        "@value": "Documentation réflexive de la conception",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/reflective-design-documentation-1",
      "rdf:value": {
        "@value": "Documentation utilisée pendant la conception pour expliciter les décisions, raisonnements et contextes afin de pouvoir réfléchir au travail et y revenir au fil de son évolution.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/registration",
      "skos:prefLabel": {
        "@value": "registration",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Inscription xAPI",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/registration-1",
      "rdf:value": {
        "@value": "Identifiant d’une occurrence dans laquelle un acteur fait l’expérience d’une activité particulière.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/remote-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage à distance",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/remote-learning-1",
      "rdf:value": {
        "@value": "Apprentissage où apprenants et enseignants peuvent être séparés dans le temps ou l’espace et interagissent au moyen d’ordinateurs ou de technologies de télécommunication.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/resource-allocation",
      "skos:prefLabel": {
        "@value": "Allocation des ressources",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/resource-allocation-1",
      "rdf:value": {
        "@value": "Affectation de personnes, budgets, temps, technologies et autres ressources à des travaux ou objectifs.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/resource-description-framework-rdf",
      "skos:prefLabel": {
        "@value": "Resource Description Framework (RDF)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/resource-description-framework-rdf-1",
      "rdf:value": {
        "@value": "Modèle de données sémantiques représentant l’information par des relations sujet-prédicat-objet, permettant de combiner identifiants et relations entre jeux de données.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/resource-facilitated-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage soutenu par des ressources",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/resource-facilitated-learning-1",
      "rdf:value": {
        "@value": "Apprentissage où ressources structurées, outils, contenus ou systèmes automatisés assurent une grande partie du soutien guidant l’activité des apprenants.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/responsible-ai",
      "skos:prefLabel": {
        "@value": "IA responsable",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/responsible-ai-1",
      "rdf:value": {
        "@value": "Conception, utilisation et gouvernance des systèmes d’IA tenant compte des données probantes, de la sécurité, de la protection de la vie privée, de l’équité, de la transparence, de la responsabilité et des conséquences pour les personnes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/rest-api",
      "skos:prefLabel": {
        "@value": "API REST",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/rest-api-1",
      "rdf:value": {
        "@value": "Style d’interface web où les logiciels échangent ressources et données au moyen des méthodes HTTP standard et conventions réseau.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/result-object",
      "skos:prefLabel": {
        "@value": "Result Object",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Objet de résultat",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/result-object-1",
      "rdf:value": {
        "@value": "Composant facultatif d’une déclaration xAPI représentant un résultat mesuré, notamment score, réussite, achèvement, réponse, durée ou extensions.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/retrieval-practice",
      "skos:prefLabel": {
        "@value": "Pratique de récupération en mémoire",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/retrieval-practice-1",
      "rdf:value": {
        "@value": "Stratégie d’apprentissage amenant les apprenants à se remémorer activement des informations plutôt qu’à simplement les relire ou les réviser.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/review-and-monitoring",
      "skos:prefLabel": {
        "@value": "Examen et suivi",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/review-and-monitoring-1",
      "rdf:value": {
        "@value": "Publication, examen et suivi systématiques des informations éducatives par rapport aux plans, indicateurs, cibles et valeurs de référence, afin de favoriser la transparence, la responsabilité et l’amélioration continue.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/safe-and-responsible-use-of-ai",
      "skos:prefLabel": {
        "@value": "Utilisation sûre et responsable de l’IA",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/safe-and-responsible-use-of-ai-1",
      "rdf:value": {
        "@value": "Utilisation de l’IA conformément aux règles éthiques et aux exigences juridiques applicables, dans le respect de la vie privée et de la propriété intellectuelle, en atténuant les biais et les préjudices et en préservant la responsabilité humaine.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/samr-model",
      "skos:prefLabel": {
        "@value": "Modèle SAMR",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/samr-model-1",
      "rdf:value": {
        "@value": "Cadre décrivant quatre niveaux d’utilisation des technologies dans l’apprentissage : substitution, augmentation, modification et redéfinition.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/scaffolding",
      "skos:prefLabel": {
        "@value": "Étayage pédagogique",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/scaffolding-1",
      "rdf:value": {
        "@value": "Soutien temporaire aidant les apprenants à réaliser des tâches ou comprendre des idées dépassant encore leurs capacités autonomes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/scalability",
      "skos:prefLabel": {
        "@value": "Passage à l’échelle",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/scalability-1",
      "rdf:value": {
        "@value": "Capacité d’une solution, d’un système ou d’un processus d’apprentissage à absorber une croissance des utilisateurs, données, complexité, portée ou demande sans dégradation inacceptable.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/scrum",
      "skos:prefLabel": {
        "@value": "Scrum",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/scrum-1",
      "rdf:value": {
        "@value": "Cadre agile organisant le travail en cycles courts avec des rôles définis, de la planification, des bilans et des adaptations.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/security",
      "skos:prefLabel": {
        "@value": "Sécurité",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/security-1",
      "rdf:value": {
        "@value": "Protection des systèmes et données contre les accès, modifications, divulgations, interruptions ou destructions non autorisés.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/self-efficacy",
      "skos:prefLabel": {
        "@value": "Sentiment d’efficacité personnelle",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/self-efficacy-1",
      "rdf:value": {
        "@value": "Conviction d’une personne quant à sa capacité à accomplir une tâche précise ou à réussir dans un contexte donné.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/self-monitoring",
      "skos:prefLabel": {
        "@value": "Autosurveillance",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/self-monitoring-1",
      "rdf:value": {
        "@value": "Observation continue par un apprenant de son temps, de ses tâches, de sa compréhension, de son stress, de ses progrès et de ses comportements afin d’identifier les ajustements nécessaires.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/self-regulated-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage autorégulé",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/self-regulated-learning-1",
      "rdf:value": {
        "@value": "Apprentissage où les personnes planifient, surveillent, évaluent et adaptent leurs objectifs, stratégies, efforts et comportements.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/semantic-interoperability",
      "skos:prefLabel": {
        "@value": "Interopérabilité sémantique",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/semantic-interoperability-1",
      "rdf:value": {
        "@value": "Capacité de systèmes développés indépendamment à échanger des données en préservant une signification commune, de sorte que des concepts équivalents et des descriptions d’activités puissent être interprétés de manière cohérente entre différentes mises en œuvre.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/sensemaking",
      "skos:prefLabel": {
        "@value": "Construction du sens",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/sensemaking-1",
      "rdf:value": {
        "@value": "Processus social et cognitif d’interprétation d’informations complexes ou ambiguës en reliant observations, expériences, récits et contexte partagé.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/sensor",
      "skos:prefLabel": {
        "@value": "Capteur",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/sensor-1",
      "rdf:value": {
        "@value": "Mécanisme matériel ou logiciel détectant un événement, état, signal ou condition et le rendant disponible pour enregistrement ou traitement.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/shareable-competency-definition-scd",
      "skos:prefLabel": {
        "@value": "Shareable Competency Definition (SCD)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/shareable-competency-definition-scd-1",
      "rdf:value": {
        "@value": "Représentation exploitable par machine permettant de définir et d’échanger des compétences conformément à la norme IEEE 1484.20.3.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/short-term-memory",
      "skos:prefLabel": {
        "@value": "Mémoire à court terme",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/short-term-memory-1",
      "rdf:value": {
        "@value": "Mémoire conservant temporairement une quantité limitée d’informations pour un usage immédiat.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/signed-statement",
      "skos:prefLabel": {
        "@value": "Déclaration signée",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/signed-statement-1",
      "rdf:value": {
        "@value": "Déclaration xAPI incluant une signature web JSON (JWS) en pièce jointe afin de vérifier l’authenticité et l’intégrité de sa sérialisation originale.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/simple-knowledge-organization-system-skos",
      "skos:prefLabel": {
        "@value": "Simple Knowledge Organization System (SKOS)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/simple-knowledge-organization-system-skos-1",
      "rdf:value": {
        "@value": "Vocabulaire du W3C représentant les concepts et leurs relations sémantiques sous une forme lisible par machine.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/simulation",
      "skos:prefLabel": {
        "@value": "Simulation",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/simulation-1",
      "rdf:value": {
        "@value": "Représentation d’un environnement, processus ou système réel ou imaginaire utilisée pour la pratique, l’expérimentation, l’analyse ou les essais.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/social-constructivism",
      "skos:prefLabel": {
        "@value": "Socioconstructivisme",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/social-constructivism-1",
      "rdf:value": {
        "@value": "Conception de l’apprentissage insistant sur le rôle de l’interaction, du langage, de la culture et de l’activité collective dans la construction des connaissances.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/social-hardening",
      "skos:prefLabel": {
        "@value": "Renforcement social de la sécurité",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/social-hardening-1",
      "rdf:value": {
        "@value": "Recours à la formation, aux exercices et à l’apprentissage organisationnel pour renforcer la capacité des personnes à reconnaître, prévenir, contenir et gérer les menaces de sécurité.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/social-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage social",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/social-learning-1",
      "rdf:value": {
        "@value": "Apprentissage se développant par l’interaction avec d’autres personnes et communautés, notamment observation, conversation, collaboration, participation et construction collective du sens.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/social-responsibility-in-ai-education",
      "skos:prefLabel": {
        "@value": "Responsabilité sociale dans l’éducation à l’IA",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/social-responsibility-in-ai-education-1",
      "rdf:value": {
        "@value": "Responsabilité de considérer les effets plus larges de l’IA sur le bien-être humain, l’inclusion, la justice sociale, la vie civique et l’environnement, et d’agir en conséquence.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/software-engineering",
      "skos:prefLabel": {
        "@value": "Génie logiciel",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/software-engineering-1",
      "rdf:value": {
        "@value": "Conception, développement, test, déploiement, maintenance et évolution systématiques des systèmes logiciels.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/source-of-influence",
      "skos:prefLabel": {
        "@value": "Source d’influence",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/source-of-influence-1",
      "rdf:value": {
        "@value": "Facteur cité pour éclairer ou justifier une décision de conception, tel que données, recherche, expérience, besoins des parties prenantes, technologies ou contexte.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/spaced-repetition",
      "skos:prefLabel": {
        "@value": "Répétition espacée",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/spaced-repetition-1",
      "rdf:value": {
        "@value": "Stratégie d’apprentissage réexaminant les informations à des intervalles croissants ou choisis stratégiquement plutôt que de concentrer les exercices en une seule séance.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/sparql",
      "skos:prefLabel": {
        "@value": "SPARQL",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/sparql-1",
      "rdf:value": {
        "@value": "Langage de requête pour données RDF permettant d’interroger des jeux de données sémantiques selon leurs entités, propriétés et relations.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/stakeholder-engagement",
      "skos:prefLabel": {
        "@value": "Mobilisation des parties prenantes",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/stakeholder-engagement-1",
      "rdf:value": {
        "@value": "Pratique associant les personnes touchées par un défi ou une solution d’apprentissage, qui en sont responsables ou peuvent les influencer.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/stakeholder-requirement",
      "skos:prefLabel": {
        "@value": "Exigence d’une partie prenante",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/stakeholder-requirement-1",
      "rdf:value": {
        "@value": "Objectif, exigence, recommandation ou idée exprimé par une partie prenante et influençant une décision de conception.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/standards-compliance",
      "skos:prefLabel": {
        "@value": "Conformité aux normes",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/standards-compliance-1",
      "rdf:value": {
        "@value": "Degré de respect des exigences d’une norme ou spécification publiée par un système, une mise en œuvre ou un jeu de données.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/state-resource",
      "skos:prefLabel": {
        "@value": "State Resource",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Ressource d’état",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/state-resource-1",
      "rdf:value": {
        "@value": "Ressource xAPI située à /activities/state pour stocker et récupérer des documents d’état associés à un agent ou groupe identifié dans une activité, éventuellement liés à une inscription.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/statement-immutability",
      "skos:prefLabel": {
        "@value": "Immutabilité des déclarations",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/statement-immutability-1",
      "rdf:value": {
        "@value": "Principe xAPI selon lequel les parties sémantiques essentielles d’une déclaration ne changent pas après stockage ; la norme distingue les propriétés immuables et celles qui peuvent varier sans en modifier le sens fondamental.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/statement-reference",
      "skos:prefLabel": {
        "@value": "Référence de déclaration",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/statement-reference-1",
      "rdf:value": {
        "@value": "Objet xAPI référençant une autre déclaration par son UUID et utilisant le type d’objet StatementRef.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/statement-resource",
      "skos:prefLabel": {
        "@value": "Ressource de déclarations",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/statement-resource-1",
      "rdf:value": {
        "@value": "Ressource LRS située à /statements pour stocker et récupérer des déclarations xAPI seules, en lots ou sous forme de résultats filtrés.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/statement-result",
      "skos:prefLabel": {
        "@value": "Résultat de requête de déclarations",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/statement-result-1",
      "rdf:value": {
        "@value": "Structure de réponse renvoyée lorsqu’une requête LRS récupère plusieurs déclarations, contenant ces déclarations et, si nécessaire, un lien vers la suite des résultats.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/statement-template",
      "skos:prefLabel": {
        "@value": "Modèle de déclaration",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/statement-template-1",
      "rdf:value": {
        "@value": "Ensemble de règles décrivant une structure possible des déclarations utilisant des concepts particuliers conformément à un profil.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/statement-template-rule",
      "skos:prefLabel": {
        "@value": "Règle de modèle de déclaration",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/statement-template-rule-1",
      "rdf:value": {
        "@value": "Restriction d’un modèle de déclaration désignant un ou plusieurs emplacements par JSONPath et limitant les valeurs ou leur présence à ces emplacements.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/statement-template-validation",
      "skos:prefLabel": {
        "@value": "Validation des modèles de déclaration",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/statement-template-validation-1",
      "rdf:value": {
        "@value": "Processus vérifiant une déclaration par rapport aux modèles de déclaration d’un profil pour déterminer les modèles correspondants et vérifier le respect de leurs règles.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/strategic-planning",
      "skos:prefLabel": {
        "@value": "Planification stratégique",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/strategic-planning-1",
      "rdf:value": {
        "@value": "Processus structuré définissant un état futur souhaité, analysant les conditions présentes, identifiant priorités et contraintes, puis organisant actions et ressources pour atteindre les objectifs organisationnels.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/streaming-learning-data",
      "skos:prefLabel": {
        "@value": "Flux continu de données d’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/streaming-learning-data-1",
      "rdf:value": {
        "@value": "Flux continu de données d’activités et d’événements générées quand les apprenants interagissent avec des systèmes, contenus, personnes et environnements numériques.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/subject-matter-expert-sme",
      "skos:prefLabel": {
        "@value": "Expert du domaine (SME)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/subject-matter-expert-sme-1",
      "rdf:value": {
        "@value": "Personne possédant des connaissances approfondies ou une expertise de performance dans le domaine auquel s’adresse une solution d’apprentissage.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/subregistration",
      "skos:prefLabel": {
        "@value": "subregistration",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Sous-inscription",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/subregistration-1",
      "rdf:value": {
        "@value": "Extension des profils xAPI distinguant plusieurs motifs suivis dans une même inscription xAPI.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/substatement",
      "skos:prefLabel": {
        "@value": "Sous-déclaration (SubStatement)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/substatement-1",
      "rdf:value": {
        "@value": "Objet xAPI semblable à une déclaration, intégré à une autre déclaration, contenant acteur, verbe et objet, éventuellement résultat, contexte, horodatage et pièces jointes, mais ne pouvant contenir une autre sous-déclaration.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/summative-assessment",
      "skos:prefLabel": {
        "@value": "Évaluation sommative",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/summative-assessment-1",
      "rdf:value": {
        "@value": "Évaluation utilisée pour juger ou documenter les acquis à la fin d’une période, d’un cours ou d’une séquence d’enseignement définie.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/survey-data",
      "skos:prefLabel": {
        "@value": "Données d’enquête",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/survey-data-1",
      "rdf:value": {
        "@value": "Données éducatives recueillies notamment par enquêtes auprès des ménages, enquêtes sur la population active et recensements, fournissant souvent des informations absentes des systèmes administratifs.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/synchronous-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage synchrone",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/synchronous-learning-1",
      "rdf:value": {
        "@value": "Activité d’apprentissage en temps réel où les participants interviennent simultanément, souvent dans un environnement physique ou virtuel partagé.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/system-of-systems",
      "skos:prefLabel": {
        "@value": "Système de systèmes",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/system-of-systems-1",
      "rdf:value": {
        "@value": "Capacité globale constituée de plusieurs systèmes indépendants ou semi-indépendants dont les interactions produisent des comportements et résultats à l’échelle de l’organisation.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/systems-thinking",
      "skos:prefLabel": {
        "@value": "Pensée systémique",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/systems-thinking-1",
      "rdf:value": {
        "@value": "Approche de compréhension des problèmes examinant composants, relations, rétroactions, frontières et comportements de l’ensemble du système.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/task-analysis",
      "skos:prefLabel": {
        "@value": "Analyse des tâches",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/task-analysis-1",
      "rdf:value": {
        "@value": "Méthode identifiant actions, connaissances, décisions, conditions, outils et exigences de performance nécessaires à l’exécution d’une tâche.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/unesco-teaching-and-training",
      "skos:prefLabel": {
        "@value": "Enseignement et formation",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/unesco-teaching-and-training-1",
      "rdf:value": {
        "@value": "Méthodes et processus organisés facilitant l’apprentissage et le développement de connaissances ou compétences par l’enseignement, la pratique, l’accompagnement et la formation.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/unesco-technical-and-vocational-study-subjects",
      "skos:prefLabel": {
        "@value": "Matières de l’enseignement technique et professionnel",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/unesco-technical-and-vocational-study-subjects-1",
      "rdf:value": {
        "@value": "Domaines d’études axés sur les connaissances et compétences techniques et professionnelles, y compris la préparation à des métiers qualifiés et à des professions spécifiques.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/technology-affordance",
      "skos:prefLabel": {
        "@value": "Possibilité offerte par une technologie",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/technology-affordance-1",
      "rdf:value": {
        "@value": "Fonction ou capacité d’une technologie mobilisable stratégiquement pour soutenir une décision de conception pédagogique.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/technology-constraint",
      "skos:prefLabel": {
        "@value": "Contrainte technologique",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/technology-constraint-1",
      "rdf:value": {
        "@value": "Limite d’une technologie ou plateforme restreignant ou délimitant un choix de conception.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/testing-for-learning-impact",
      "skos:prefLabel": {
        "@value": "Évaluation de l’impact sur les apprentissages",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/testing-for-learning-impact-1",
      "rdf:value": {
        "@value": "Évaluation cherchant à déterminer si une solution modifie apprentissage, rétention, transfert, performance ou autres résultats visés, au-delà de la seule utilisabilité ou satisfaction.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/total-cost-of-ownership-tco",
      "skos:prefLabel": {
        "@value": "Coût total de possession (CTP)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/total-cost-of-ownership-tco-1",
      "rdf:value": {
        "@value": "Coût sur l’ensemble du cycle de vie de l’acquisition, intégration, exploitation, soutien, modification et retrait d’une technologie ou d’un système.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/total-learning-architecture-tla",
      "skos:prefLabel": {
        "@value": "Total Learning Architecture (TLA)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/total-learning-architecture-tla-1",
      "rdf:value": {
        "@value": "Approche fondée sur des normes pour des écosystèmes d’apprentissage interopérables, reliant données d’activités, informations sur les apprenants, compétences, analyses et autres services entre systèmes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/trustworthy-ai-for-education",
      "skos:prefLabel": {
        "@value": "IA digne de confiance pour l’éducation",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/trustworthy-ai-for-education-1",
      "rdf:value": {
        "@value": "IA utilisée dans l’éducation qui soit fiable, sûre, résistante aux manipulations, protectrice de la vie privée et des données sensibles et adaptée à l’âge des apprenants et aux besoins pédagogiques.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/ubiquitous-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage ubiquitaire",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/ubiquitous-learning-1",
      "rdf:value": {
        "@value": "Vision de l’apprentissage présent dans de multiples lieux, moments, appareils et contextes, formels, non formels, informels, professionnels et quotidiens.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/usability-testing",
      "skos:prefLabel": {
        "@value": "Test d’utilisabilité",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/usability-testing-1",
      "rdf:value": {
        "@value": "Évaluation où des utilisateurs représentatifs accomplissent des tâches afin d’observer les réussites, incompréhensions et difficultés d’une interface ou expérience.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/user-testing",
      "skos:prefLabel": {
        "@value": "Test auprès des utilisateurs",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/user-testing-1",
      "rdf:value": {
        "@value": "Évaluation directe d’une conception ou d’un système avec ses utilisateurs prévus ou représentatifs.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/user-centered-design",
      "skos:prefLabel": {
        "@value": "Conception centrée sur l’utilisateur",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/user-centered-design-1",
      "rdf:value": {
        "@value": "Approche partant des besoins, contextes et expériences des utilisateurs finaux et parties prenantes pour concevoir des solutions souples et inclusives.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/user-tailored-privacy",
      "skos:prefLabel": {
        "@value": "Protection de la vie privée adaptée à l’utilisateur",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/user-tailored-privacy-1",
      "rdf:value": {
        "@value": "Approche de protection de la vie privée dans laquelle un système modélise les préoccupations d’un apprenant en la matière et adapte les informations, les recommandations ou l’aide à la décision à cet utilisateur.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/value-stream-mapping",
      "skos:prefLabel": {
        "@value": "Cartographie de la chaîne de valeur",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/value-stream-mapping-1",
      "rdf:value": {
        "@value": "Méthode lean visualisant le flux de travail pour repérer retards, transferts, goulets d’étranglement et activités sans valeur ajoutée.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/vendor-lock-in",
      "skos:prefLabel": {
        "@value": "Dépendance envers un fournisseur",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/vendor-lock-in-1",
      "rdf:value": {
        "@value": "Situation où des choix technologiques antérieurs limitent les décisions futures, car systèmes, données ou services sont difficiles à déplacer, remplacer ou intégrer.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/verb",
      "skos:prefLabel": {
        "@value": "Verb",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Verbe xAPI",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/verb-1",
      "rdf:value": {
        "@value": "Élément xAPI identifiant l’action d’un acteur, défini par un IRI ; une carte linguistique peut fournir un libellé lisible par les personnes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/verifiable-learning-and-employment-record",
      "skos:prefLabel": {
        "@value": "Dossier vérifiable d’apprentissage et d’emploi",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/verifiable-learning-and-employment-record-1",
      "rdf:value": {
        "@value": "Dossier contenant informations sur apprentissages, compétences, réalisations ou emploi, conçu pour que d’autres parties puissent vérifier les assertions.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/virtual-classroom",
      "skos:prefLabel": {
        "@value": "Classe virtuelle",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/virtual-classroom-1",
      "rdf:value": {
        "@value": "Environnement d’apprentissage collectif créé par logiciel et soutenu par des communications informatiques en réseau plutôt que par une salle physique partagée.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/virtual-world",
      "skos:prefLabel": {
        "@value": "Monde virtuel",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/virtual-world-1",
      "rdf:value": {
        "@value": "Environnement persistant en réseau où les personnes sont représentées par des avatars et interagissent entre elles et avec l’environnement par ordinateur.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/voided-statement",
      "skos:prefLabel": {
        "@value": "Déclaration invalidée",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/voided-statement-1",
      "rdf:value": {
        "@value": "Déclaration xAPI antérieure marquée comme invalide par une déclaration distincte d’invalidation qui la cible au moyen d’une référence de déclaration.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/whole-of-government-approach",
      "skos:prefLabel": {
        "@value": "Approche pangouvernementale",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/whole-of-government-approach-1",
      "rdf:value": {
        "@value": "Approche où plusieurs ministères et autorités coordonnent leurs actions face à une politique ou un défi de mise en œuvre commun, plutôt que de le confier à un seul organisme.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/whole-person-development",
      "skos:prefLabel": {
        "@value": "Développement global de la personne",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/whole-person-development-1",
      "rdf:value": {
        "@value": "Approche du développement considérant les capacités cognitives, sociales, émotionnelles et physiques comme des dimensions interdépendantes de l’apprentissage tout au long de la vie.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/worked-example",
      "skos:prefLabel": {
        "@value": "Exemple résolu",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/worked-example-1",
      "rdf:value": {
        "@value": "Démonstration détaillée des étapes d’une tâche ou résolution d’un problème, montrant aux apprenants comment construire une solution complète.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/working-memory",
      "skos:prefLabel": {
        "@value": "Mémoire de travail",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/working-memory-1",
      "rdf:value": {
        "@value": "Système de mémoire à capacité limitée dans lequel l’information est traitée consciemment avant une éventuelle consolidation dans la mémoire à long terme.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/x-experience-api-version",
      "skos:prefLabel": {
        "@value": "X-Experience-API-Version",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/x-experience-api-version-1",
      "rdf:value": {
        "@value": "En-tête HTTP utilisé dans les requêtes et réponses xAPI pour déclarer la version xAPI employée.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/xapi-agent",
      "skos:prefLabel": {
        "@value": "Agent xAPI",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/xapi-agent-1",
      "rdf:value": {
        "@value": "Représentation xAPI d’un acteur individuel, identifié par une propriété d’identité définie par la norme et éventuellement accompagné d’un nom.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/xapi-authority",
      "skos:prefLabel": {
        "@value": "Autorité xAPI",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/xapi-authority-1",
      "rdf:value": {
        "@value": "Agent ou groupe présenté dans une déclaration comme attestant sa véracité ; le LRS vérifie ou définit cette autorité selon l’authentification et les relations de confiance.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/xapi-client",
      "skos:prefLabel": {
        "@value": "Client xAPI",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/xapi-client-1",
      "rdf:value": {
        "@value": "Toute entité interagissant avec les services xAPI par des requêtes, notamment fournisseurs ou consommateurs d’enregistrements, LRS et autres systèmes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/xapi-concurrency-control",
      "skos:prefLabel": {
        "@value": "Contrôle de concurrence xAPI",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/xapi-concurrency-control-1",
      "rdf:value": {
        "@value": "Utilisation par xAPI des étiquettes d’entité HTTP (ETags) et des en-têtes de requête conditionnelle, notamment If-Match et If-None-Match, pour empêcher que des mises à jour ou des suppressions de ressources State, Agent Profile ou Activity Profile reposent sur des données périmées.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/xapi-document",
      "skos:prefLabel": {
        "@value": "Document xAPI",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/xapi-document-1",
      "rdf:value": {
        "@value": "Données documentaires stockées au moyen des ressources xAPI État, Profil d’agent ou Profil d’activité, sous forme générique liée à une activité, un agent ou groupe identifié et, pour l’état, éventuellement à une inscription.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/xapi-duration",
      "skos:prefLabel": {
        "@value": "Durée xAPI",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/xapi-duration-1",
      "rdf:value": {
        "@value": "Valeur représentant le temps écoulé d’une expérience ou d’un résultat, au format de durée ISO 8601 référencé par xAPI.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/xapi-extension",
      "skos:prefLabel": {
        "@value": "Extension xAPI",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/xapi-extension-1",
      "rdf:value": {
        "@value": "Propriété personnalisée d’une carte d’extensions xAPI utilisant un IRI comme clé et une valeur ou structure JSON quelconque comme valeur, pouvant figurer dans les définitions d’activité, contextes ou résultats de déclaration.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/xapi-group",
      "skos:prefLabel": {
        "@value": "Groupe xAPI",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/xapi-group-1",
      "rdf:value": {
        "@value": "Représentation xAPI d’un ensemble d’agents en tant qu’acteur ; le groupe peut disposer de son propre identifiant ou être anonyme et représenté par ses membres.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/xapi-pattern",
      "skos:prefLabel": {
        "@value": "Motif xAPI",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/xapi-pattern-1",
      "rdf:value": {
        "@value": "Description de groupes de déclarations xAPI correspondant à certains modèles de déclaration et organisées suivant des structures d’ordre définies.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/xapi-persona",
      "skos:prefLabel": {
        "@value": "Persona xAPI",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/xapi-persona-1",
      "rdf:value": {
        "@value": "Ensemble d’une ou plusieurs représentations d’identité décrivant de façon unique un acteur dans un contexte particulier, distinct de la personne réelle plus large.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/xapi-profile",
      "skos:prefLabel": {
        "@value": "Profil xAPI",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/xapi-profile-1",
      "rdf:value": {
        "@value": "Documentation lisible par des personnes et/ou des machines décrivant les concepts, les modèles de déclarations, les motifs et les extensions propres à une application, utilisés lors de la mise en œuvre de xAPI dans un contexte particulier.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/xapi-statement",
      "skos:prefLabel": {
        "@value": "Déclaration xAPI",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/xapi-statement-1",
      "rdf:value": {
        "@value": "Structure de données fondamentale de xAPI utilisée pour représenter une expérience, généralement autour d’un acteur, d’un verbe et d’un objet, avec, de façon facultative, un contexte, un résultat, une autorité et des pièces jointes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/xapi-timestamp",
      "skos:prefLabel": {
        "@value": "Horodatage xAPI",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/xapi-timestamp-1",
      "rdf:value": {
        "@value": "Moment où l’événement décrit par une déclaration s’est produit, représenté selon les règles d’horodatage xAPI, notamment les formats ISO 8601 et RFC 3339.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/yerkes-dodson-law",
      "skos:prefLabel": {
        "@value": "Loi de Yerkes-Dodson",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/yerkes-dodson-law-1",
      "rdf:value": {
        "@value": "Principe selon lequel la performance varie avec l’activation ou le stress, souvent représenté par une courbe en U inversé dont l’optimum dépend des caractéristiques de la tâche.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/exploratory-research",
      "skos:prefLabel": {
        "@value": "Recherche exploratoire",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/exploratory-research-1",
      "rdf:value": {
        "@value": "Recherche portant sur des questions ouvertes, des possibilités émergentes et des champs de conception incertains, où les questions, méthodes ou résultats évoluent à mesure que les preuves s’accumulent.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/interdisciplinary-exploratory-research",
      "skos:prefLabel": {
        "@value": "Recherche exploratoire interdisciplinaire",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/interdisciplinary-exploratory-research-1",
      "rdf:value": {
        "@value": "Recherche exploratoire réunissant expertises, méthodes et perspectives de plusieurs disciplines pour étudier des questions émergentes et élaborer des approches inédites.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/co-design",
      "skos:prefLabel": {
        "@value": "Co-conception",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/co-design-1",
      "rdf:value": {
        "@value": "Approche collaborative de conception dans laquelle des chercheurs ou des concepteurs travaillent avec des praticiens, des apprenants, des partenaires ou d’autres participants concernés afin de définir les questions, les technologies et les pratiques.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/equitable-co-design",
      "skos:prefLabel": {
        "@value": "Co-conception équitable",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/equitable-co-design-1",
      "rdf:value": {
        "@value": "Co-conception réduisant volontairement les obstacles à la participation, intégrant des perspectives sous-représentées et des identités et besoins croisés, et donnant aux praticiens ou utilisateurs une influence réelle sur les choix de conception.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/contextually-rich-learning-environment",
      "skos:prefLabel": {
        "@value": "Environnement d’apprentissage riche en contexte",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/contextually-rich-learning-environment-1",
      "rdf:value": {
        "@value": "Environnement d’apprentissage conçu en tenant compte des personnes, pratiques, technologies, contraintes et situations particulières dans lesquelles l’apprentissage se déroule.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learner-variability",
      "skos:prefLabel": {
        "@value": "Variabilité des apprenants",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learner-variability-1",
      "rdf:value": {
        "@value": "Différences entre apprenants concernant besoins, origines, capacités, contextes, expériences et manières d’interagir avec un système d’apprentissage ou de l’utiliser.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/user-directed-customization",
      "skos:prefLabel": {
        "@value": "Personnalisation pilotée par l’utilisateur",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/user-directed-customization-1",
      "rdf:value": {
        "@value": "Possibilité pour les utilisateurs d’adapter le comportement ou la configuration d’une technologie d’apprentissage selon leurs besoins, expérience, contexte ou niveau de soutien souhaité.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/practitioner-expertise",
      "skos:prefLabel": {
        "@value": "Expertise du praticien",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/practitioner-expertise-1",
      "rdf:value": {
        "@value": "Connaissances et jugement professionnel acquis par la pratique directe, notamment compréhension des apprenants, milieux, processus, contraintes et mises en œuvre.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/networked-community",
      "skos:prefLabel": {
        "@value": "Communauté en réseau",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/networked-community-1",
      "rdf:value": {
        "@value": "Communauté connectée de chercheurs, praticiens et autres participants partageant leurs expertises, tissant des relations, favorisant la collaboration et prolongeant les travaux entre projets et disciplines.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/emergent-impact",
      "skos:prefLabel": {
        "@value": "Impact émergent",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/emergent-impact-1",
      "rdf:value": {
        "@value": "Effets, usages, résultats ou prolongements de travaux exploratoires qui dépassent ce qui était prévu ou anticipé au début d’un projet.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/coordination-network",
      "skos:prefLabel": {
        "@value": "Réseau de coordination",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/coordination-network-1",
      "rdf:value": {
        "@value": "Réseau durable ou structure de coordination reliant les participants, facilitant les relations et le travail collectif, synthétisant les résultats et favorisant la circulation des connaissances entre projets et communautés.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/interdisciplinary-research-identity",
      "skos:prefLabel": {
        "@value": "Identité de recherche interdisciplinaire",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/interdisciplinary-research-identity-1",
      "rdf:value": {
        "@value": "Identité professionnelle par laquelle les chercheurs situent leurs travaux au-delà des frontières disciplinaires et participent à des collaborations, méthodes et communautés traversant les domaines établis.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/educational-attainment",
      "skos:prefLabel": {
        "@value": "Niveau d’instruction atteint",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/educational-attainment-1",
      "rdf:value": {
        "@value": "Niveau d’enseignement le plus élevé achevé avec succès par une personne.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/classroom-teacher",
      "skos:prefLabel": {
        "@value": "Enseignant en classe",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/classroom-teacher-1",
      "rdf:value": {
        "@value": "Personnel enseignant professionnel principalement chargé de planifier, d’organiser et d’animer des activités d’apprentissage en groupe qui orientent les expériences d’apprentissage des élèves.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/full-time-equivalent-teacher-fte",
      "skos:prefLabel": {
        "@value": "Enseignant en équivalent temps plein (ETP)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/full-time-equivalent-teacher-fte-1",
      "rdf:value": {
        "@value": "Mesure normalisée de la charge de travail d’un enseignant par rapport à un emploi à temps plein, rapportée aux heures de travail réglementaires habituelles de la période de référence.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/fully-qualified-teacher",
      "skos:prefLabel": {
        "@value": "Enseignant pleinement qualifié",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/fully-qualified-teacher-1",
      "rdf:value": {
        "@value": "Enseignant ayant satisfait toutes les exigences de formation et administratives prévues par la réglementation nationale pour enseigner à un niveau et dans une matière donnés.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/educational-institution",
      "skos:prefLabel": {
        "@value": "Établissement d’enseignement",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/educational-institution-1",
      "rdf:value": {
        "@value": "Entité dont l’objectif unique ou principal est de fournir des services d’enseignement ou des services connexes cliniques, communautaires ou de recherche.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/early-childhood-education-and-care-ecec",
      "skos:prefLabel": {
        "@value": "Éducation et protection de la petite enfance (EPPE)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/early-childhood-education-and-care-ecec-1",
      "rdf:value": {
        "@value": "Services et programmes soutenant l’éducation, le développement, le bien-être et la prise en charge des jeunes enfants avant l’enseignement primaire, y compris les programmes CITE 0 et les services de garde réglementés extérieurs à l’enseignement formel.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/early-childhood-education-ece",
      "skos:prefLabel": {
        "@value": "Éducation de la petite enfance (EPE)",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/early-childhood-education-ece-1",
      "rdf:value": {
        "@value": "Volet éducatif de l’éducation et de la protection de la petite enfance, comprenant les programmes de niveau 0 de la CITE et leurs activités d’apprentissage organisées et intentionnelles soutenant le développement cognitif, physique, social et émotionnel des enfants.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/childcare-gap",
      "skos:prefLabel": {
        "@value": "Période entre congé parental et droit d’accès à l’EPPE",
        "@language": "fr"
      },
      "skos:altLabel": [
        {
          "@value": "Déficit de couverture des services d’accueil de la petite enfance",
          "@language": "fr"
        },
        {
          "@value": "Période sans droit d’accès aux services d’accueil de la petite enfance",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/childcare-gap-1",
      "rdf:value": {
        "@value": "Période comprise entre la fin du congé parental rémunéré et l’âge auquel les enfants acquièrent légalement le droit d’accéder aux services d’éducation et d’accueil de la petite enfance.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/formative-evaluation",
      "skos:prefLabel": {
        "@value": "Évaluation formative",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/formative-evaluation-1",
      "rdf:value": {
        "@value": "Évaluation visant principalement à fournir une rétroaction utilisable pour améliorer l’enseignement, la gestion, la mise en œuvre ou l’efficacité scolaire.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/school-compliance-reporting",
      "skos:prefLabel": {
        "@value": "Rapports réglementaires des établissements scolaires",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/school-compliance-reporting-1",
      "rdf:value": {
        "@value": "Rapports et formulaires transmis aux autorités supérieures dans le cadre des obligations réglementaires de reddition de comptes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-management-systems",
      "skos:prefLabel": {
        "@value": "Systèmes de gestion de l’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-management-systems",
      "rdf:value": {
        "@value": "Plateformes logicielles utilisées pour administrer, diffuser, organiser et suivre les activités d’apprentissage et les cours, ainsi que pour produire des rapports sur ces activités et les résultats qui leur sont associés.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/technology-integration",
      "skos:prefLabel": {
        "@value": "Intégration des technologies",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/technology-integration",
      "rdf:value": {
        "@value": "Processus d’intégration d’outils et de services technologiques aux pratiques pédagogiques, aux programmes et à l’environnement éducatif.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/electronic-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage électronique",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/electronic-learning",
      "rdf:value": {
        "@value": "Apprentissage soutenu par des appareils électroniques, des logiciels ou des processus numériques, que sa mise en œuvre nécessite ou non une connexion à Internet.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/instructional-design",
      "skos:prefLabel": {
        "@value": "Conception pédagogique",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/instructional-design",
      "rdf:value": {
        "@value": "Analyse et conception systématiques d’expériences d’apprentissage, d’activités, de ressources et de démarches d’évaluation visant à soutenir l’atteinte des résultats attendus.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/instructional-systems",
      "skos:prefLabel": {
        "@value": "Systèmes pédagogiques",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/instructional-systems",
      "rdf:value": {
        "@value": "Ensembles coordonnés de personnes, de contenus, de processus, de ressources et de technologies qui soutiennent l’enseignement et ses objectifs visés.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-objectives",
      "skos:prefLabel": {
        "@value": "Objectifs d’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-objectives",
      "rdf:value": {
        "@value": "Énoncés décrivant les connaissances, les compétences ou les capacités que les apprenants sont censés acquérir ou démontrer dans le cadre d’une activité d’apprentissage.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-strategies",
      "skos:prefLabel": {
        "@value": "Stratégies d’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-strategies",
      "rdf:value": {
        "@value": "Approches, démarches ou techniques utilisées par les apprenants ou les éducateurs pour soutenir l’apprentissage dans différentes tâches et différents contextes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/blended-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage hybride",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/blended-learning",
      "rdf:value": {
        "@value": "Approche pédagogique combinant délibérément plusieurs modes de formation, notamment, mais pas exclusivement, des activités en présence et des activités soutenues par des technologies électroniques.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/gamification",
      "skos:prefLabel": {
        "@value": "Ludification",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/gamification",
      "rdf:value": {
        "@value": "Application d’éléments de conception de jeux, tels que des points, des défis ou des mécanismes de rétroaction, à des contextes qui ne sont pas eux-mêmes des jeux.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/game-based-learning",
      "skos:prefLabel": {
        "@value": "Apprentissage par le jeu",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/game-based-learning",
      "rdf:value": {
        "@value": "Approche dans laquelle la participation à des jeux ou à des activités de jeu sert à développer ou à appliquer des connaissances et des compétences.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/adaptive-testing",
      "skos:prefLabel": {
        "@value": "Évaluation adaptative",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/adaptive-testing",
      "rdf:value": {
        "@value": "Évaluation qui sélectionne ou adapte les questions suivantes en fonction des informations tirées des réponses précédentes de l’apprenant.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/assessment-literacy",
      "skos:prefLabel": {
        "@value": "Littératie en évaluation",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/assessment-literacy",
      "rdf:value": {
        "@value": "Connaissances et compétences nécessaires pour concevoir, sélectionner, interpréter et utiliser de manière appropriée les évaluations et leurs résultats dans la pratique éducative.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/performance-based-assessment",
      "skos:prefLabel": {
        "@value": "Évaluation fondée sur la performance",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/performance-based-assessment",
      "rdf:value": {
        "@value": "Évaluation demandant aux apprenants de démontrer leurs connaissances ou leurs compétences par la réalisation d’un travail ou l’accomplissement d’une tâche, le processus, le produit ou les deux faisant l’objet de l’évaluation.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-trajectories",
      "skos:prefLabel": {
        "@value": "Trajectoires d’apprentissage",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/learning-trajectories",
      "rdf:value": {
        "@value": "Descriptions de la manière dont les connaissances et les compétences peuvent se développer au fil d’étapes successives, utilisées pour éclairer les objectifs d’apprentissage, l’enseignement et l’évaluation.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/transfer-of-training",
      "skos:prefLabel": {
        "@value": "Transfert des acquis de formation",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/transfer-of-training",
      "rdf:value": {
        "@value": "Influence de connaissances ou de compétences acquises antérieurement sur l’apprentissage ou la réalisation d’une tâche dans un contexte ultérieur.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/assistive-technology",
      "skos:prefLabel": {
        "@value": "Technologies d’assistance",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/assistive-technology",
      "rdf:value": {
        "@value": "Appareils, équipements, logiciels ou systèmes adaptés qui soutiennent les capacités fonctionnelles et la participation des personnes en situation de handicap.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/access-to-internet",
      "skos:prefLabel": {
        "@value": "Accès à Internet",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/access-to-internet",
      "rdf:value": {
        "@value": "Disponibilité des moyens permettant aux personnes de se connecter à Internet et d’en utiliser les services, au moyen d’appareils adaptés et de services de réseau appropriés.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/information-literacy",
      "skos:prefLabel": {
        "@value": "Littératie informationnelle",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/information-literacy",
      "rdf:value": {
        "@value": "Capacité à repérer, évaluer, interpréter et utiliser l’information de manière appropriée, à partir de diverses sources et dans différents contextes.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/media-literacy",
      "skos:prefLabel": {
        "@value": "Littératie médiatique",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/media-literacy",
      "rdf:value": {
        "@value": "Capacité à accéder à des messages médiatiques, à les interpréter, à les évaluer et à en créer sous différentes formes de médias.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/technological-literacy",
      "skos:prefLabel": {
        "@value": "Culture technologique",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/technological-literacy",
      "rdf:value": {
        "@value": "Compréhension des technologies, de leurs usages et de leurs conséquences, ainsi que capacité à prendre des décisions éclairées quant à leur sélection et à leur utilisation.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/natural-language-processing",
      "skos:prefLabel": {
        "@value": "Traitement automatique des langues",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/natural-language-processing",
      "rdf:value": {
        "@value": "Méthodes informatiques permettant d’analyser, d’interpréter, de générer ou de traiter de toute autre manière le langage humain.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/instructional-effectiveness",
      "skos:prefLabel": {
        "@value": "Efficacité pédagogique",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/instructional-effectiveness",
      "rdf:value": {
        "@value": "Degré auquel l’enseignement, les ressources ou les programmes éducatifs soutiennent l’atteinte de leurs objectifs d’apprentissage visés.",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/concepts/educational-indicators",
      "skos:prefLabel": {
        "@value": "Indicateurs de l’éducation",
        "@language": "fr"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/educational-indicators",
      "rdf:value": {
        "@value": "Mesures utilisées pour décrire les conditions, les activités ou les résultats en éducation et pour éclairer l’évaluation, la comparaison et les décisions de politique éducative.",
        "@language": "fr"
      }
    }
  ]
}
