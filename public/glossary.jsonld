    {
      "@id": "https://id.i2idl.org/concepts/interdisciplinary-exploratory-research",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "interdisciplinary-exploratory-research",
      "skos:prefLabel": "Interdisciplinary exploratory research",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "Exploratory research that brings together expertise, methods, and perspectives from multiple disciplines to investigate emerging questions and develop novel approaches.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/interdisciplinary-exploratory-research-1"
      },
      "gs:editorialExplanation": "Learning technology problems often cross technical, educational, accessibility, and domain boundaries, so discovery can depend on collaboration that no single discipline can supply.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-engineering"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/practice"
      }
    },
