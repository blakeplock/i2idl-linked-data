    {
      "@id": "https://id.i2idl.org/concepts/accessibility",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "accessibility",
      "skos:prefLabel": "Accessibility",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The practice of designing learning technologies, content, and interactions so people with a wide range of abilities can perceive, operate, understand, and use them.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/accessibility-1"
      },
      "gs:editorialExplanation": "Accessibility broadens participation and is part of evaluating whether a learning solution works for the people it is meant to serve.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/human-centered-design"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/practice"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/accessibility-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "The practice of designing learning technologies, content, and interactions so people with a wide range of abilities can perceive, operate, understand, and use them.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
      "gs:editorialStatus": "approved",
      "gs:definitionSequence": 1,
      "gs:evidence": [
        {
          "@type": "gs:Evidence",
