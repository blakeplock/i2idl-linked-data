      },
      "skos:definition": "A design practice focused on shaping the sensory, emotional, cognitive, behavioral, and social qualities of an experience so it becomes more meaningful and memorable.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/experience-design-1"
      },
      "gs:editorialExplanation": "Learning experience design can borrow experience-design methods to account for motivation, emotion, context, identity, and social connection in addition to cognition.",
