    {
      "@id": "https://id.i2idl.org/concepts/internationalized-resource-locator-irl",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "internationalized-resource-locator-irl",
      "skos:prefLabel": "Internationalized Resource Locator (IRL)",
