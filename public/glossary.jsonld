    {
      "@id": "https://id.i2idl.org/concepts/decision-support",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "decision-support",
      "skos:prefLabel": "Decision support",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The use of data, analytics, models, or software to help people make informed decisions without necessarily automating the decision itself.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/decision-support-1"
      },
      "gs:editorialExplanation": "In learning engineering, decision support can help instructors, designers, administrators, and learners interpret evidence and choose actions.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-analytics"
      },
      "gs:typeCollection": {
