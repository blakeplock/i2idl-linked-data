      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The combined physical, digital, social, organizational, and instructional conditions in which learning occurs.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/learning-environment-1"
