      },
      "skos:definition": "An IEEE recommended practice mapping the Open Archives Initiative Object Reuse and Exchange (OAI-ORE) Abstract Model and its RDF/XML resource-map representation to the IEEE conceptual model for resource aggregation.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/ieee-1484-13-6-2015-oai-ore-mapping-1"
      },
      "gs:editorialExplanation": "It bridges a web-oriented resource aggregation model with the learning-technology resource model, helping preserve meaning when aggregated resources move across technical ecosystems.",
      "gs:fieldCollection": {
