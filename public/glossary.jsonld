    {
      "@id": "https://id.i2idl.org/concepts/technology-affordance",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "technology-affordance",
      "skos:prefLabel": "Technology affordance",
