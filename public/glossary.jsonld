        "@id": "https://www.i2idl.org/"
      },
      "gs:editorialStatus": "approved",
      "gs:definitionSequence": 1,
      "gs:evidence": [
        {
          "@type": "gs:Evidence",
          "dcterms:source": {
            "@id": "https://id.i2idl.org/sources/xapi-profiles-specification",
            "dcterms:title": "xAPI Profiles Specification"
          },
          "prov:wasDerivedFrom": {
            "@id": "https://id.i2idl.org/sources/xapi-profiles-specification"
          },
          "gs:sourceLabel": "xAPI Profiles Specification",
          "gs:evidenceRelation": "direct",
          "gs:citationDetail": "Part Three §2.1 — Statement Template validation procedure",
          "schema:url": "https://github.com/adlnet/xapi-profiles/blob/master/xapi-profiles-communication.md#statement-template-valid:~:text=To%20validate%20a%20Statement%20against%20the%20Statement%20Templates%20of%20a%20Profile%2C%20call%20the%20validates%20function%20described%20in%20pseudocode%20below%20with%20the%20Statement%20and%20all%20the%20Statement%20Templates%20from%20the%20Profile."
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/concepts/strategic-planning",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "strategic-planning",
      "skos:prefLabel": "Strategic planning",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A structured process for defining a desired future state, understanding current conditions, identifying priorities and constraints, and organizing actions and resources to move an organization toward its goals.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/strategic-planning-1"
      },
      "gs:editorialExplanation": "Modern learning ecosystems require long-range coordination across technology, people, policy, investment, governance, and changing organizational needs.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/enterprise-and-governance"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/practice"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/strategic-planning-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "A structured process for defining a desired future state, understanding current conditions, identifying priorities and constraints, and organizing actions and resources to move an organization toward its goals.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
      "gs:editorialStatus": "approved",
      "gs:definitionSequence": 1,
      "gs:evidence": [
        {
          "@type": "gs:Evidence",
          "dcterms:source": {
            "@id": "https://id.i2idl.org/sources/modernizing-learning",
            "dcterms:title": "Modernizing Learning: Building the Future Learning Ecosystem"
          },
          "prov:wasDerivedFrom": {
            "@id": "https://id.i2idl.org/sources/modernizing-learning"
          },
          "gs:sourceLabel": "Modernizing Learning",
          "gs:citationDetail": "Ch. 19, pp. 357-387",
          "schema:url": "https://files.eric.ed.gov/fulltext/ED603521.pdf#page=367",
          "gs:pdfPage": 367,
          "gs:pdfPrintedPage": 357,
          "gs:host": "ERIC",
          "gs:evidenceRelation": "direct"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/concepts/streaming-learning-data",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "streaming-learning-data",
      "skos:prefLabel": "Streaming learning data",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A continuous flow of activity- and event-based data generated as learners interact with digital systems, content, people, and environments.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/streaming-learning-data-1"
      },
      "gs:editorialExplanation": "Streaming data can support more continuous and contextual views of learning than isolated grades or periodic snapshots.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/data-and-instrumentation"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      },
      "skos:altLabel": [
        "Activity stream",
        "event stream"
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/streaming-learning-data-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "A continuous flow of activity- and event-based data generated as learners interact with digital systems, content, people, and environments.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
      "gs:editorialStatus": "approved",
      "gs:definitionSequence": 1,
      "gs:evidence": [
        {
          "@type": "gs:Evidence",
