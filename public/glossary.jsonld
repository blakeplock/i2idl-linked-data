    {
      "@id": "https://id.i2idl.org/concepts/human-centred-mindset",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "human-centred-mindset",
      "skos:prefLabel": "Human-centred mindset",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A values- and attitudes-based orientation toward human–AI interaction that keeps human rights, human flourishing, human agency, and human accountability central to the use of AI.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/human-centred-mindset-1"
      },
      "gs:editorialExplanation": "A human-centred mindset helps educators evaluate AI in terms of its consequences for people, learning, society, and citizenship rather than only its technical performance.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/ai-and-machine-learning"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      },
      "skos:altLabel": [
        "Human-centered mindset"
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/human-centred-mindset-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "A values- and attitudes-based orientation toward human–AI interaction that keeps human rights, human flourishing, human agency, and human accountability central to the use of AI.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
      "gs:editorialStatus": "approved",
      "gs:definitionSequence": 1,
      "gs:evidence": [
        {
