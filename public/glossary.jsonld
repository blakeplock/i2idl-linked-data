    {
      "@id": "https://id.i2idl.org/concepts/co-design",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "co-design",
      "skos:prefLabel": "Co-design",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A collaborative design approach in which researchers or designers work with practitioners, learners, partners, or other affected participants to shape questions, technologies, and practices.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/co-design-1"
      },
      "gs:editorialExplanation": "Co-design brings practical knowledge and user perspectives into the design process early enough to change the direction of the work rather than merely evaluate a finished solution.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/human-centered-design"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/method"
      },
      "skos:altLabel": "Participatory co-design"
    },
    {
      "@id": "https://id.i2idl.org/definitions/co-design-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
