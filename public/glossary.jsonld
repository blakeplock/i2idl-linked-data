    {
      "@id": "https://id.i2idl.org/concepts/worked-example",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "worked-example",
      "skos:prefLabel": "Worked example",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A step-by-step demonstration of how to perform a task or solve a problem, used to show learners how a complete solution is constructed.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/worked-example-1"
      },
      "gs:editorialExplanation": "Worked examples can reduce unnecessary problem-solving demands early in learning and can be faded as learners become more capable of completing steps independently.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-sciences"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/method"
      },
      "skos:altLabel": [
        "Worked example effect"
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/worked-example-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "A step-by-step demonstration of how to perform a task or solve a problem, used to show learners how a complete solution is constructed.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
      "gs:editorialStatus": "approved",
      "gs:definitionSequence": 1,
      "gs:evidence": [
        {
