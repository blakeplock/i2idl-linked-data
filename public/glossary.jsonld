      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An early representation of a proposed solution used to explore ideas, test assumptions, gather feedback, or reduce uncertainty.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/prototype-1"
      },
      "gs:editorialExplanation": "Prototypes make abstract ideas testable before teams commit to expensive implementation decisions.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/human-centered-design"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
