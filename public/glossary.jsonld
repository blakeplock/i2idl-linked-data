      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "Skills for using digital technologies, ranging from basic technology competencies to higher-order capabilities such as coding, computational thinking, and ethics.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/digital-skills-1"
      },
      "gs:editorialExplanation": "Access alone does not produce effective participation in digital learning. Learners and educators also need skills that let them use technology productively and responsibly.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/education"
      },
      "gs:typeCollection": {
