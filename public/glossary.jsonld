      "skos:definition": "A globally unique identifier format used throughout xAPI to identify things such as Verbs, Activities, Activity types, extensions, and other vocabulary concepts. IRIs can contain international characters and include a scheme.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/internationalized-resource-identifier-iri-1"
      },
      "gs:editorialExplanation": "IRIs let independent systems refer to the same concepts without relying on local database identifiers, which is fundamental to semantic interoperability.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      },
      "skos:altLabel": [
        "IRI"
      ]
    },
