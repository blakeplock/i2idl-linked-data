    {
      "@id": "https://id.i2idl.org/concepts/formative-assessment",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "formative-assessment",
      "skos:prefLabel": "Formative assessment",
