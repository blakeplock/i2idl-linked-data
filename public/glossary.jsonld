          },
          "prov:wasDerivedFrom": {
            "@id": "https://id.i2idl.org/sources/xapi-profiles-specification"
          },
          "gs:sourceLabel": "xAPI Profiles Specification",
          "gs:evidenceRelation": "direct",
          "gs:citationDetail": "Part Three §2.2 — Pattern validation procedure",
          "schema:url": "https://github.com/adlnet/xapi-profiles/blob/master/xapi-profiles-communication.md#pattern-valid:~:text=To%20validate%20a%20series%20of%20Statements%20sharing%20a%20registration%20%28and%2C%20if%20applicable%2C%20subregistration%29%20follows%20a%20specified%20Profile%2C%20apply%20the%20follows%20algorithm%20described%20below"
        }
      ]
    },
