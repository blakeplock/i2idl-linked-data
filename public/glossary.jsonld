    {
      "@id": "https://id.i2idl.org/concepts/deepen-ai-competency-level",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "deepen-ai-competency-level",
      "skos:prefLabel": "Deepen (AI competency level)",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The intermediate AI competency level in which teachers integrate AI into educational practice with greater attention to human accountability, safe and responsible use, ethical evaluation, and pedagogical design.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/deepen-ai-competency-level-1"
      },
      "gs:editorialExplanation": "Deepen moves beyond basic literacy toward sustained, context-aware use of AI in teaching, learning, and professional practice.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/ai-and-machine-learning"
      },
      "gs:typeCollection": {
