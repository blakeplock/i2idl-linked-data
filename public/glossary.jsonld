        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The response structure returned when an LRS query retrieves multiple Statements, containing the returned Statements and, when more results are available, a link for retrieving the next set.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/statement-result-1"
      },
      "gs:editorialExplanation": "Statement Results support paging and controlled retrieval of large bodies of xAPI data instead of requiring every matching Statement to be returned at once.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/data-and-instrumentation"
      },
