      "@id": "https://id.i2idl.org/definitions/digital-security-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "The protection of digital systems and education data from risks that can undermine confidentiality, integrity, availability, or safe use.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
      "gs:editorialStatus": "approved",
