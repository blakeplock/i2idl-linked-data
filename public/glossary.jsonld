      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An identifier used by xAPI to uniquely identify a particular Agent persona or Group, such as a mailbox, mailbox hash, OpenID, or account.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/inverse-functional-identifier-ifi-1"
      },
      "gs:editorialExplanation": "IFIs are the basis for determining when Agent or Group representations refer to the same identity, which affects querying, deduplication, and record continuity.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
