    {
      "@id": "https://id.i2idl.org/concepts/contextually-rich-learning-environment",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "contextually-rich-learning-environment",
      "skos:prefLabel": "Contextually rich learning environment",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A learning environment understood and designed in relation to the specific people, practices, technologies, constraints, and settings in which learning occurs.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/contextually-rich-learning-environment-1"
      },
      "gs:editorialExplanation": "A design that works in one setting may fail in another, so learning technologies often need to account for local context rather than assume a single common environment.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/human-centered-design"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
