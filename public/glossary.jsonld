    {
      "@id": "https://id.i2idl.org/concepts/design-build-cycle",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "design-build-cycle",
      "skos:prefLabel": "Design-build cycle",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An iterative cycle in which a learning solution is designed, built, tried with learners or stakeholders, examined through evidence, and revised rather than treated as complete after a single design pass.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/design-build-cycle-1"
      },
      "gs:editorialExplanation": "Repeated design-build cycles make learner and stakeholder feedback part of development and support faster correction of weak assumptions.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-engineering"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/method"
      },
      "skos:altLabel": [
        "Design-build iteration"
      ]
    },
