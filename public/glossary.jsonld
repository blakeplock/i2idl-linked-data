      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An isolated store of data that does not readily exchange information with other applications, systems, or organizational data sources.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/data-silo-1"
      },
      "gs:editorialExplanation": "Data silos make it harder to combine information across an education ecosystem and limit the value of data for coordinated decisions and services.",
      "gs:fieldCollection": {
