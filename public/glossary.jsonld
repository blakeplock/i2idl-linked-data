    {
      "@id": "https://id.i2idl.org/concepts/mastery-learning",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "mastery-learning",
      "skos:prefLabel": "Mastery learning",
