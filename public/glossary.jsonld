        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The systematic process of analyzing educational needs, setting goals and priorities, anticipating future requirements, and organizing resources and actions to improve an education system.",
