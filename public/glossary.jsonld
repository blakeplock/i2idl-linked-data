    {
      "@id": "https://id.i2idl.org/concepts/ai-explainability-in-education",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "ai-explainability-in-education",
      "skos:prefLabel": "AI explainability in education",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The extent to which educators can understand and critically examine how an AI system reaches outputs or conclusions sufficiently to assess its use and intervene when necessary.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/ai-explainability-in-education-1"
      },
      "gs:editorialExplanation": "Explainability supports informed human oversight, particularly when AI outputs influence teaching, learning, assessment, or decisions about learners.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/ai-and-machine-learning"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      },
      "skos:altLabel": [
        "Explainability"
      ]
    },
