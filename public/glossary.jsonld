      "dcterms:identifier": "responsible-ai",
      "skos:prefLabel": "Responsible AI",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The design, use, and governance of AI systems with attention to evidence, safety, privacy, fairness, transparency, accountability, and human consequences.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/responsible-ai-1"
      },
      "gs:editorialExplanation": "Learning contexts can affect opportunities and records about people, so AI decisions require more than technical performance alone.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/ai-and-machine-learning"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/practice"
      }
    },
