    {
      "@id": "https://id.i2idl.org/concepts/culture-change",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "culture-change",
      "skos:prefLabel": "Culture change",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The deliberate effort to shift shared assumptions, behaviors, norms, incentives, and ways of working so an organization can adopt and sustain a new model of learning.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/culture-change-1"
      },
      "gs:editorialExplanation": "Technology and policy changes can fail when organizational culture continues to reward old behaviors or resists experimentation and new forms of collaboration.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/enterprise-and-governance"
      },
