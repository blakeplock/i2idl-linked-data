    {
      "@id": "https://id.i2idl.org/concepts/xapi-persona",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "xapi-persona",
      "skos:prefLabel": "xAPI persona",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A set of one or more identity representations that uniquely describes an Actor in a particular context. The standard distinguishes personas from the broader real-world person.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/xapi-persona-1"
      },
      "gs:editorialExplanation": "The persona model recognizes that the same person may be represented differently across contexts or systems, which affects how records can safely be correlated.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      },
      "skos:altLabel": [
        "Persona"
      ]
    },
