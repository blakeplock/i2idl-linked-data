    {
      "@id": "https://id.i2idl.org/concepts/competency-based-learning",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "competency-based-learning",
      "skos:prefLabel": "Competency-based learning",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An approach in which progress is organized around demonstrated mastery of defined competencies rather than primarily around time spent in a course or program.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/competency-based-learning-1"
      },
      "gs:editorialExplanation": "Competency-based learning can connect assessment, personalization, credentials, and talent systems around evidence of what a learner can actually do.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-engineering"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/practice"
      },
      "skos:altLabel": [
        "CBL",
        "competency-based education"
      ]
    },
