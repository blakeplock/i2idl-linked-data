      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/micro-credential-1"
      },
      "gs:editorialExplanation": "Micro-credentials can make specific capabilities visible and portable, especially when tied to clear competency definitions and verifiable evidence.",
