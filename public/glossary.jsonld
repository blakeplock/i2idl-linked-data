    {
      "@id": "https://id.i2idl.org/concepts/procedural-knowledge",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "procedural-knowledge",
      "skos:prefLabel": "Procedural knowledge",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "Knowledge of how to carry out a procedure, perform a task, or solve a problem.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/procedural-knowledge-1"
      },
      "gs:editorialExplanation": "Learners need opportunities to connect procedural knowledge with conceptual understanding so they can use a procedure flexibly rather than only repeat memorized steps.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-sciences"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      },
      "skos:altLabel": [
        "Knowing how"
      ]
    },
