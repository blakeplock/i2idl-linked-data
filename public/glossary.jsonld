    {
      "@id": "https://id.i2idl.org/concepts/connectivism",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "connectivism",
      "skos:prefLabel": "Connectivism",
      "skos:inScheme": {
