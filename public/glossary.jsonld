    {
      "@id": "https://id.i2idl.org/concepts/problem-space",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "problem-space",
      "skos:prefLabel": "Problem space",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The contextual setting in which a learning challenge exists, including the conditions, constraints, learners, stakeholders, systems, and uncertainties that shape possible solutions.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/problem-space-1"
      },
      "gs:editorialExplanation": "Learning engineering may begin in either well-defined or ill-defined situations; making the problem space explicit helps teams avoid designing a solution for the wrong context.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-engineering"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
    {
