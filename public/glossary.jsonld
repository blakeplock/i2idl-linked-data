    {
      "@id": "https://id.i2idl.org/concepts/design-decision",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "design-decision",
      "skos:prefLabel": "Design decision",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A choice about what to include in a learning design and how that choice will be enacted, made in response to goals, evidence, experience, constraints, and context.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/design-decision-1"
      },
      "gs:editorialExplanation": "Learning designs are built through many such choices. Making the choices visible helps teams explain, revisit, and improve the work over time.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-engineering"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/design-decision-1",
