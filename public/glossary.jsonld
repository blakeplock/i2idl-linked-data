      },
      "skos:definition": "Differences among learners in needs, backgrounds, abilities, contexts, experiences, and ways of engaging with or using a learning system.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/learner-variability-1"
