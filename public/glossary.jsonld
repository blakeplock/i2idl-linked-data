    {
      "@id": "https://id.i2idl.org/concepts/interdisciplinary-research-identity",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "interdisciplinary-research-identity",
      "skos:prefLabel": "Interdisciplinary research identity",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A professional identity in which researchers understand their work as belonging across disciplinary boundaries and participate in collaborations, methods, and communities that span established fields.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/interdisciplinary-research-identity-1"
      },
      "gs:editorialExplanation": "A durable interdisciplinary identity can support professional growth and participation in research problems that do not fit neatly within one established discipline.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-engineering"
      },
