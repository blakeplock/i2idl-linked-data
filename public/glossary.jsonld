    {
      "@id": "https://id.i2idl.org/concepts/ieee-1484-12-1-2020-learning-object-metadata",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "ieee-1484-12-1-2020-learning-object-metadata",
      "skos:prefLabel": "IEEE 1484.12.1-2020 — Learning Object Metadata",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An IEEE standard defining the conceptual data schema for metadata that describes learning objects, including characteristics such as lifecycle, educational use, technical requirements, rights, relationships, annotations, and classifications.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/ieee-1484-12-1-2020-learning-object-metadata-1"
      },
      "gs:editorialExplanation": "LOM provides a common descriptive model that helps learning technology systems manage, locate, evaluate, exchange, and potentially automate the selection of learning resources.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
