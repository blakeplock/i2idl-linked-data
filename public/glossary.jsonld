    {
      "@id": "https://id.i2idl.org/concepts/privacy-nudging",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "privacy-nudging",
      "skos:prefLabel": "Privacy nudging",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The use of interface cues, defaults, explanations, or other design interventions to help users make more informed privacy choices.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/privacy-nudging-1"
      },
      "gs:editorialExplanation": "Privacy decisions are complex; carefully designed nudges can support better choices without requiring users to become privacy experts.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/human-centered-design"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/method"
      }
    },
