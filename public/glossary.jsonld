    {
      "@id": "https://id.i2idl.org/concepts/user-centered-design",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "user-centered-design",
      "skos:prefLabel": "User-centered design",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A design approach that begins with the needs, contexts, and experiences of end users and stakeholders and uses that understanding to shape flexible, inclusive solutions.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/user-centered-design-1"
      },
      "gs:editorialExplanation": "For EdTech, user-centered design supports equity, adaptability, and sustainability by accounting for differences in gender, disability, language, culture, and context.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/human-centered-design"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/method"
      }
    },
