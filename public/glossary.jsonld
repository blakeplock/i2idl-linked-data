          "schema:url": "https://opensource.ieee.org/xapi/xapi-base-standard-documentation/-/blob/main/9274.1.1%20xAPI%20Base%20Standard%20for%20Content.md#5223-object",
          "gs:evidenceRelation": "direct"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/concepts/activity-definition",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "activity-definition",
      "skos:prefLabel": "Activity Definition",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The optional metadata object within an xAPI Activity that can describe its human-readable name, description, type, more-information location, interaction details, and extensions.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/activity-definition-1"
      },
      "gs:editorialExplanation": "Activity Definitions add understandable metadata to stable Activity identifiers without making that metadata the identifier itself.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/data-and-instrumentation"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/activity-definition-1",
