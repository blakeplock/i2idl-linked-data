    {
      "@id": "https://id.i2idl.org/concepts/xapi-extension",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "xapi-extension",
      "skos:prefLabel": "xAPI extension",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A custom property expressed in an xAPI extensions map using an IRI as the key and any JSON value or structure as the value. Extensions can appear in Activity Definitions, Statement Context, or Statement Result.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/xapi-extension-1"
      },
      "gs:editorialExplanation": "Extensions give communities room to represent domain-specific information while keeping the core Statement model stable; interoperability is strongest when built-in properties are used whenever possible.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/xapi-extension-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "A custom property expressed in an xAPI extensions map using an IRI as the key and any JSON value or structure as the value. Extensions can appear in Activity Definitions, Statement Context, or Statement Result.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
      "gs:editorialStatus": "approved",
      "gs:definitionSequence": 1,
      "gs:evidence": [
        {
