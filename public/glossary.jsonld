    {
      "@id": "https://id.i2idl.org/concepts/external-representation",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "external-representation",
      "skos:prefLabel": "External representation",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A concrete artifact, such as a sketch, model, concept map, or prototype, that makes design thinking visible so it can support reflection, communication, collaboration, and iteration.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/external-representation-1"
      },
      "gs:editorialExplanation": "External representations move design knowledge out of an individual designer's head and give a team something persistent to examine, discuss, and revise.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/human-centered-design"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      },
