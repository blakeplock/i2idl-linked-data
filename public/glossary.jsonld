    {
      "@id": "https://id.i2idl.org/concepts/voided-statement",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "voided-statement",
      "skos:prefLabel": "Voided Statement",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A previously issued xAPI Statement that has been marked invalid through a separate voiding Statement that targets it by Statement Reference.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/voided-statement-1"
      },
      "gs:editorialExplanation": "Voiding preserves the historical record while providing a standards-defined way to indicate that an earlier Statement should no longer be treated as valid evidence.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/data-and-instrumentation"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/practice"
      }
