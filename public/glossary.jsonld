    {
      "@id": "https://id.i2idl.org/concepts/design-decision-making",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "design-decision-making",
      "skos:prefLabel": "Design decision-making",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The process of forming, enacting, communicating, revisiting, and sometimes revising choices about a learning design while accounting for learners, stakeholders, evidence, technology, and context.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/design-decision-making-1"
      },
      "gs:editorialExplanation": "Tracking decision-making makes design reasoning more transparent and supports iteration across people, project phases, and learning engineering cycles.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-engineering"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/practice"
      },
      "skos:altLabel": [
        "design decision making"
      ]
    },
