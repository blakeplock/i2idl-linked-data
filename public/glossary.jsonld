      ],
      "dcterms:identifier": "scalability",
      "skos:prefLabel": "Scalability",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The ability of a learning solution, system, or process to handle growth in users, data, complexity, scope, or demand without unacceptable degradation.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/scalability-1"
      },
      "gs:editorialExplanation": "Scaling changes architecture, support, cost, governance, and coordination requirements even when the learning design itself appears stable.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/engineering-and-systems"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
    {
