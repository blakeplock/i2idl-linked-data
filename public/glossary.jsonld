      },
      "skos:definition": "The use of computers to access training or education through synchronous or asynchronous activities delivered on networked or standalone systems.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/computer-based-learning-1"
