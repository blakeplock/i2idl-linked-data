    {
      "@id": "https://id.i2idl.org/concepts/lifelong-learning",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "lifelong-learning",
      "skos:prefLabel": "Lifelong learning",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A view of learning as continuous across the full lifespan and across formal, nonformal, informal, workplace, community, and lived experiences.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/lifelong-learning-1"
      },
      "gs:editorialExplanation": "It shifts education away from a front-loaded sequence of schooling toward ongoing development that can adapt to changing work, technology, and life circumstances.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-sciences"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
