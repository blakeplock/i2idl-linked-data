    {
      "@id": "https://id.i2idl.org/concepts/ai-literacy-for-teachers",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "ai-literacy-for-teachers",
      "skos:prefLabel": "AI literacy for teachers",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The foundational set of AI competencies teachers need to understand AI’s human-led nature, recognize benefits and risks, apply core ethical principles, understand basic AI concepts, and use appropriate AI tools in educational practice.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/ai-literacy-for-teachers-1"
      },
      "gs:editorialExplanation": "Teacher AI literacy provides the baseline needed for safe, ethical, and educationally useful engagement with AI before more advanced integration or creation.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/ai-and-machine-learning"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      },
      "skos:altLabel": [
        "Teachers’ AI literacy"
      ]
    },
