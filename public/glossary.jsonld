        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A hypermedia system that builds a model of the user and changes the information, links, or presentation shown to that user rather than presenting the same experience to everyone.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/adaptive-hypermedia-1"
      },
      "gs:editorialExplanation": "It represents an early web-based approach to personalization and helped connect intelligent tutoring ideas to online learning.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/ai-and-machine-learning"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/system"
      }
    },
