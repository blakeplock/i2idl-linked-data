    {
      "@id": "https://id.i2idl.org/concepts/future-learning-ecosystem",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "future-learning-ecosystem",
      "skos:prefLabel": "Future learning ecosystem",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A vision of learning as a connected, lifelong continuum rather than a series of disconnected episodes, with experiences tailored to individuals across locations, media, organizations, and periods of time.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/future-learning-ecosystem-1"
      },
      "gs:editorialExplanation": "It provides the organizing idea for linking learning science, technology, data, governance, policy, and human infrastructure into one evolving system.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-engineering"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
