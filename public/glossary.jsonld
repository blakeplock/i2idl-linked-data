    {
      "@id": "https://id.i2idl.org/concepts/ai-assisted-teaching",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "ai-assisted-teaching",
      "skos:prefLabel": "AI-assisted teaching",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "Teaching in which educators identify and use appropriate AI tools to support activities such as lesson planning, instruction, assessment, and learner support while mitigating associated risks.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/ai-assisted-teaching-1"
      },
      "gs:editorialExplanation": "AI-assisted teaching frames AI as a support to professional practice and requires educators to connect tool use to specific pedagogical needs.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-sciences"
      },
      "gs:typeCollection": {
