      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A condition in which earlier technology choices constrain future decisions because systems, data, or services are difficult to move, replace, or integrate.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/vendor-lock-in-1"
      },
      "gs:editorialExplanation": "Open standards and interoperability can reduce dependence on a single technology provider and preserve future choices for education systems.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/enterprise-and-governance"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      },
      "skos:altLabel": [
