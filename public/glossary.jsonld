    {
      "@id": "https://id.i2idl.org/concepts/ai-pedagogy",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "ai-pedagogy",
      "skos:prefLabel": "AI pedagogy",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The competencies and practices involved in selecting, validating, and integrating AI with pedagogical methods to support teaching, learning, social interaction, care, and assessment.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/ai-pedagogy-1"
      },
      "gs:editorialExplanation": "AI pedagogy focuses attention on when and how AI should support educational practice rather than assuming that the presence of AI creates pedagogical value.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-sciences"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/practice"
      }
    },
