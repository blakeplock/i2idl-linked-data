            "dcterms:title": "IEEE xAPI Base Standard"
          },
          "prov:wasDerivedFrom": {
            "@id": "https://id.i2idl.org/sources/ieee-xapi-base-standard"
          },
          "gs:sourceLabel": "IEEE xAPI Base Standard",
          "gs:citationDetail": "IEEE 9274.1.1-2023 §3.1 — Definitions: Client",
          "schema:url": "https://opensource.ieee.org/xapi/xapi-base-standard-documentation/-/blob/main/9274.1.1%20xAPI%20Base%20Standard%20Overview.md#31-definitions",
          "gs:evidenceRelation": "direct"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/concepts/xapi-concurrency-control",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "xapi-concurrency-control",
      "skos:prefLabel": "xAPI concurrency control",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The xAPI use of HTTP entity tags and conditional request headers to prevent State, Agent Profile, or Activity Profile updates and deletes from being based on stale data.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/xapi-concurrency-control-1"
      },
      "gs:editorialExplanation": "Concurrency control protects shared document resources from accidental overwrites when multiple clients read and modify the same data.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/engineering-and-systems"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/practice"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/xapi-concurrency-control-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "The xAPI use of HTTP entity tags and conditional request headers to prevent State, Agent Profile, or Activity Profile updates and deletes from being based on stale data.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
      "gs:editorialStatus": "approved",
