    {
      "@id": "https://id.i2idl.org/concepts/substatement",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "substatement",
      "skos:prefLabel": "SubStatement",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An xAPI Statement-like Object embedded inside another Statement. It contains an Actor, Verb, and Object and may include Result, Context, Timestamp, and Attachments, but cannot itself contain another SubStatement.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/substatement-1"
      },
      "gs:editorialExplanation": "SubStatements let a Statement describe another structured experience as its Object while preventing unbounded nesting.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/data-and-instrumentation"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      },
      "skos:altLabel": [
        "Sub-Statement"
      ]
    },
