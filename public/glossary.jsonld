      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The part of the learning engineering process in which a team creates a response to a learning challenge by designing the solution, planning and instrumenting the needed data, and iterating the design with learners and stakeholders.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/creation-phase-1"
      },
      "gs:editorialExplanation": "Treating instrumentation and iteration as part of creation helps ensure that a solution is designed to generate useful evidence from the start.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-engineering"
      },
      "gs:typeCollection": {
