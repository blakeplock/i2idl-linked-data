      "@id": "https://id.i2idl.org/definitions/education-data-integration-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "The combination and linkage of data from different education and related sources to create a more coherent view, fill information gaps, and support analysis that a single source cannot provide.",
