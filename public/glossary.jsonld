      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "Effects, uses, outcomes, or extensions of exploratory work that develop beyond what was specified or anticipated at the start of a project.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/emergent-impact-1"
      },
      "gs:editorialExplanation": "Exploratory work may create value through unexpected applications, new research directions, broader reach, or later stages of development that could not be predicted in the original proposal.",
      "gs:fieldCollection": {
