      },
      "skos:definition": "The analysis and use of data from learning environments to understand and improve learning experiences, instructional strategies, and related decisions.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/learning-analytics-1"
      },
      "gs:editorialExplanation": "Learning analytics converts event data into evidence, but its value depends on instrumentation, measurement validity, interpretation, and responsible use.",
