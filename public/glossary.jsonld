      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/building-expertise-1"
      },
      "gs:editorialExplanation": "Expertise changes how learners perceive problems, use prior knowledge, and allocate attention, which affects how instruction should be designed.",
