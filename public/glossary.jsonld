    {
      "@id": "https://id.i2idl.org/concepts/identified-group",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "identified-group",
      "skos:prefLabel": "Identified Group",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An xAPI Group that has its own Inverse Functional Identifier, allowing the Group to be recognized independently of its current member list.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/identified-group-1"
      },
      "gs:editorialExplanation": "An identified Group can remain a stable entity even as membership changes, which matters for team-based learning and organizational records.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/data-and-instrumentation"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
