    {
      "@id": "https://id.i2idl.org/concepts/mentorship",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "mentorship",
      "skos:prefLabel": "Mentorship",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A developmental relationship in which a more experienced person models knowledge or skills and gives a learner progressively more complex opportunities to participate in authentic work.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/mentorship-1"
      },
      "gs:editorialExplanation": "Mentorship can help novices build expertise by connecting explanation, modeling, guided participation, feedback, and increasing responsibility.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-sciences"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/practice"
      },
      "skos:altLabel": [
        "Mentoring"
      ]
    },
