    {
      "@id": "https://id.i2idl.org/concepts/x-experience-api-version",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "x-experience-api-version",
      "skos:prefLabel": "X-Experience-API-Version",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The HTTP header used in xAPI requests and responses to declare the xAPI version being used.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/x-experience-api-version-1"
      },
      "gs:editorialExplanation": "Explicit version negotiation helps clients and LRSs remain interoperable as the specification changes and prevents silent assumptions about incompatible versions.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/standard"
