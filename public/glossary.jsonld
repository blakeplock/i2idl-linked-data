    {
      "@id": "https://id.i2idl.org/concepts/xapi-document",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "xapi-document",
      "skos:prefLabel": "xAPI document",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "Document data stored through the xAPI State, Agent Profile, or Activity Profile Resources. These resources store state or profile information in a generic document form scoped to an Activity, Agent or Identified Group, and, for State, optionally a registration.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/xapi-document-1"
      },
      "gs:editorialExplanation": "Documents let xAPI applications persist state and profile information outside immutable Statements while keeping that information associated with the relevant Activity, Agent, Group, or registration.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/data-and-instrumentation"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
