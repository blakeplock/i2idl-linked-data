    {
      "@id": "https://id.i2idl.org/concepts/trustworthy-ai-for-education",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "trustworthy-ai-for-education",
      "skos:prefLabel": "Trustworthy AI for education",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "AI used in education that is reliable and safe, robust against manipulation, protective of privacy and sensitive data, and appropriate to learners’ ages and pedagogical needs.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/trustworthy-ai-for-education-1"
      },
      "gs:editorialExplanation": "Educational institutions need confidence that AI systems will not expose learners to avoidable harm simply because a tool is technically available or commercially popular.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/ai-and-machine-learning"
      },
      "gs:typeCollection": {
