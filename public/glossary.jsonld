    {
      "@id": "https://id.i2idl.org/concepts/xapi-authority",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "xapi-authority",
      "skos:prefLabel": "xAPI authority",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The Agent or Group represented in a Statement as asserting that the Statement is true. The LRS verifies or sets the authority based on authentication and trust relationships.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/xapi-authority-1"
      },
      "gs:editorialExplanation": "Authority distinguishes who performed an experience from who vouches for the resulting record, which is important for provenance and trust.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/enterprise-and-governance"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
