        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An instructional approach that expects learners to demonstrate a defined level of proficiency before moving on to more advanced material or competencies.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/mastery-learning-1"
      },
      "gs:editorialExplanation": "Mastery shifts progression from seat time toward evidence of capability and is a recurring foundation for adaptive and competency-based approaches.",
      "gs:fieldCollection": {
