    {
      "@id": "https://id.i2idl.org/concepts/meaningful-learning",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "meaningful-learning",
      "skos:prefLabel": "Meaningful learning",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "Learning characterized by intentional, active, constructive, authentic, and cooperative engagement that helps learners connect experiences and build usable understanding.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/meaningful-learning-1"
      },
      "gs:editorialExplanation": "The framework provides a way to design learning for deeper understanding and transfer across varied contexts rather than for passive content exposure.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-sciences"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/meaningful-learning-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "Learning characterized by intentional, active, constructive, authentic, and cooperative engagement that helps learners connect experiences and build usable understanding.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
      "gs:editorialStatus": "approved",
      "gs:definitionSequence": 1,
      "gs:evidence": [
