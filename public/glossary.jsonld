      "gs:editorialExplanation": "Pattern validation makes it possible to validate multi-Statement workflows and activity sequences rather than evaluating each Statement only in isolation.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/process"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/pattern-validation-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "The process of validating a series of Statements that share a registration, and when applicable a subregistration, to determine whether they follow a specified Profile Pattern.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
      "gs:editorialStatus": "approved",
      "gs:definitionSequence": 1,
      "gs:evidence": [
        {
          "@type": "gs:Evidence",
          "dcterms:source": {
