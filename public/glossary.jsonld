    },
    {
      "@id": "https://id.i2idl.org/concepts/xapi-client",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "xapi-client",
      "skos:prefLabel": "xAPI Client",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "Any entity that interacts with xAPI services through requests, including Learning Record Providers, Learning Record Consumers, Learning Record Stores, or other systems.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/xapi-client-1"
      },
      "gs:editorialExplanation": "The Client concept makes clear that xAPI communication is not limited to one application type; several kinds of systems can participate in the exchange of learning data.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/system"
      },
      "skos:altLabel": [
        "Client"
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/xapi-client-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "Any entity that interacts with xAPI services through requests, including Learning Record Providers, Learning Record Consumers, Learning Record Stores, or other systems.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
      "gs:editorialStatus": "approved",
      "gs:definitionSequence": 1,
      "gs:evidence": [
        {
          "@type": "gs:Evidence",
