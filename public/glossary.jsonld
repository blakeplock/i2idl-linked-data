      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A learning theory that treats knowledge as distributed across networks of connections and emphasizes continual learning, current information, and the ability to recognize connections among sources and fields.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/connectivism-1"
      },
      "gs:editorialExplanation": "Connectivism provides a conceptual basis for networked learning environments where knowledge is not confined to one instructor, course, or institution.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-sciences"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
