      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The degree to which a learner actively thinks about, applies, analyzes, and connects knowledge rather than only receiving or memorizing information.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/cognitive-engagement-1"
      },
      "gs:editorialExplanation": "Deeper cognitive engagement supports stronger understanding and more flexible application of knowledge and skills.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-sciences"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
