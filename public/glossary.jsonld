      ],
      "rdf:value": "An IEEE standard defining an ECMAScript application programming interface for communication between learning content and a runtime service, typically supplied by a Learning Management System. It standardizes common API services used to exchange runtime learning data.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
