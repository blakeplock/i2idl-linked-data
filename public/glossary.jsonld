          },
          "gs:sourceLabel": "IEEE xAPI Base Standard",
          "gs:citationDetail": "IEEE 9274.1.1-2023 §5.2.7 — Additional Requirements for Data Types: Extensions",
          "schema:url": "https://opensource.ieee.org/xapi/xapi-base-standard-documentation/-/blob/main/9274.1.1%20xAPI%20Base%20Standard%20for%20Content.md#extensions",
          "gs:evidenceRelation": "direct"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/concepts/xapi-group",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "xapi-group",
      "skos:prefLabel": "xAPI Group",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An xAPI Actor representation for a collection of Agents. A Group can be identified by its own identifier or anonymous and represented by its members.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/xapi-group-1"
      },
      "gs:editorialExplanation": "Groups allow xAPI to record team and collective activity rather than forcing every experience to be modeled as an individual event.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/data-and-instrumentation"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/xapi-group-1",
