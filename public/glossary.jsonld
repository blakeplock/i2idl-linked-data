    {
      "@id": "https://id.i2idl.org/concepts/profile-based-statement-conformance",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "profile-based-statement-conformance",
      "skos:prefLabel": "Profile-based Statement conformance",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "Conformance in which Statements follow the matching Statement Templates and Patterns described by a Profile version, with the Profile version identified as a category context activity when authored by a conformant Learning Record Provider.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/profile-based-statement-conformance-1"
      },
      "gs:editorialExplanation": "This connects a Statement to explicit, reusable domain rules and makes stronger semantic and structural interoperability possible across Learning Record Providers and validators.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/practice"
      }
    },
