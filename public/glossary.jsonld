          "schema:url": "https://lebok.wiki/en/knowledge-area-3-learning-sciences-foundations/3-3-motivational-aspects-of-learning/3-3-4-stress-and-productive-learning/a--the-yerkes-dodson-law-and-arousal"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/concepts/exploratory-research",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "exploratory-research",
      "skos:prefLabel": "Exploratory research",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "Research organized to investigate open questions, emerging possibilities, and uncertain design spaces where questions, methods, or outcomes may evolve as evidence is gathered.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/exploratory-research-1"
      },
      "gs:editorialExplanation": "In fast-changing technology contexts, exploratory research creates room to discover uses, risks, and design directions that cannot be specified fully in advance.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-engineering"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/method"
      }
    },
