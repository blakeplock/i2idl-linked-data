    {
      "@id": "https://id.i2idl.org/concepts/design-justification",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "design-justification",
      "skos:prefLabel": "Design justification",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The recorded reason, evidence, or source of influence that explains why a design decision was made or revised.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/design-justification-1"
      },
      "gs:editorialExplanation": "A decision without its reasoning is difficult for another person to interpret later. Capturing justification supports communication, continuity, and future iteration.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-engineering"
      },
      "gs:typeCollection": {
