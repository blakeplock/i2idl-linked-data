      "@id": "https://id.i2idl.org/concepts/usability-testing",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "usability-testing",
      "skos:prefLabel": "Usability testing",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "Evaluation in which representative users attempt tasks so a team can observe where an interface or experience succeeds, confuses, or creates friction.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/usability-testing-1"
      },
      "gs:editorialExplanation": "Usability affects whether learners and staff can access the intended learning experience and whether data-generating workflows work in practice.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/human-centered-design"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/method"
      }
    },
