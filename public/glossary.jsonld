    {
      "@id": "https://id.i2idl.org/concepts/creation-phase",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "creation-phase",
      "skos:prefLabel": "Creation phase",
