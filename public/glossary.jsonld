    {
      "@id": "https://id.i2idl.org/concepts/learning-environment",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "learning-environment",
      "skos:prefLabel": "Learning environment",
