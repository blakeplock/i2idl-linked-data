    {
      "@id": "https://id.i2idl.org/concepts/ieee-3527-1-2020-digital-intelligence-framework",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "ieee-3527-1-2020-digital-intelligence-framework",
      "skos:prefLabel": "IEEE 3527.1-2020 — Digital Intelligence (DQ) Framework",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An IEEE standard defining a framework for digital intelligence, including digital literacy, skills, and readiness. The framework spans eight areas of digital life — identity, use, safety, security, emotional intelligence, literacy, communication, and rights — across citizenship, creativity, and competitiveness levels.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/ieee-3527-1-2020-digital-intelligence-framework-1"
      },
      "gs:editorialExplanation": "It gives education, government, industry, and other stakeholders a shared vocabulary for describing the competencies people need to participate effectively and responsibly in digital life.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/standard"
      },
      "skos:altLabel": [
        "IEEE 3527.1",
        "DQ Framework"
      ]
    },
