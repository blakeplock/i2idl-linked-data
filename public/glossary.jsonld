        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The process through which people develop abilities, attitudes, knowledge, and forms of behavior that are valued within the society in which they live.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/unesco-education-domain-1"
      },
      "gs:editorialExplanation": "Education provides the broad frame for how people develop knowledge, skills, capabilities, values, and behaviors across formal, nonformal, and informal settings.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/education"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
