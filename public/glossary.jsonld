      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/multi-channel-remote-learning-1"
      },
      "gs:editorialExplanation": "A multi-channel approach can reduce dependence on any single form of connectivity and broaden access to learning outside school.",
