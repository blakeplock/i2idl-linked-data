    {
      "@id": "https://id.i2idl.org/concepts/contextual-factor",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "contextual-factor",
      "skos:prefLabel": "Contextual factor",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A condition surrounding a design, such as learner needs, curriculum structure, timeline, resources, or technology, that can influence what is feasible or appropriate.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/contextual-factor-1"
      },
      "gs:editorialExplanation": "Learning design is situated. Contextual factors can change over time and may cause teams to revisit decisions that were reasonable under earlier conditions.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-engineering"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      },
      "skos:altLabel": [
        "design context"
      ]
    },
    {
