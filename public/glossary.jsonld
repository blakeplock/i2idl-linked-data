    {
      "@id": "https://id.i2idl.org/concepts/xapi-timestamp",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "xapi-timestamp",
      "skos:prefLabel": "xAPI timestamp",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The time at which the event described by a Statement occurred, represented using the timestamp rules defined by xAPI, including ISO 8601 and RFC 3339 formatting.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/xapi-timestamp-1"
      },
      "gs:editorialExplanation": "Separating event time from storage time makes it possible to capture offline or delayed reporting while preserving when the experience actually happened.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/data-and-instrumentation"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
