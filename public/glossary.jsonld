      },
      "skos:definition": "Knowledge and understanding a learner already has and uses as a reference point for making sense of new ideas.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/prior-knowledge-1"
      },
      "gs:editorialExplanation": "New learning is interpreted through what a learner already knows, so sequencing and instruction should account for prerequisite knowledge and misconceptions.",
