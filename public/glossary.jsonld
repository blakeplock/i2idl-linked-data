    {
      "@id": "https://id.i2idl.org/concepts/acquire-ai-competency-level",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "acquire-ai-competency-level",
      "skos:prefLabel": "Acquire (AI competency level)",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The foundational AI competency level in which teachers develop the essential knowledge, ethical awareness, and practical skills needed to evaluate, select, and use AI tools appropriately.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/acquire-ai-competency-level-1"
      },
      "gs:editorialExplanation": "Acquire establishes basic AI literacy and a foundation for more advanced integration of AI into educational practice.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/ai-and-machine-learning"
      },
      "gs:typeCollection": {
