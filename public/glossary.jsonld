    {
      "@id": "https://id.i2idl.org/concepts/meta-adaptation",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "meta-adaptation",
      "skos:prefLabel": "Meta-adaptation",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "Adaptation across multiple learning systems or resources, where one system can use shared data to recommend or coordinate interventions beyond its own immediate instructional environment.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/meta-adaptation-1"
      },
      "gs:editorialExplanation": "Meta-adaptation is a property of connected learning ecosystems and depends on interoperable data, standardized protocols, and well-defined metadata.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/ai-and-machine-learning"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
