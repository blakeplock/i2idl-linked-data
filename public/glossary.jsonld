    {
      "@id": "https://id.i2idl.org/concepts/statement-template",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "statement-template",
      "skos:prefLabel": "Statement Template",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A set of rules describing one way Statements that use particular Concepts may be structured when following a Profile.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/statement-template-1"
      },
      "gs:editorialExplanation": "Statement Templates make domain-specific Statement formation explicit and machine-checkable rather than relying only on prose guidance or local convention.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
