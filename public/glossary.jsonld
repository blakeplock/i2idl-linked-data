      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A software development practice in which changes are integrated and tested frequently rather than accumulated into large, infrequent releases.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/continuous-integration-1"
      },
      "gs:editorialExplanation": "For learning technology teams, continuous integration can make iterative development safer and shorten the feedback loop between change and validation.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/agile-and-operations"
      },
      "gs:typeCollection": {
