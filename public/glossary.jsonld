    {
      "@id": "https://id.i2idl.org/concepts/ieee-1484-2-2024-learning-employment-record-ecosystems",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "ieee-1484-2-2024-learning-employment-record-ecosystems",
      "skos:prefLabel": "IEEE 1484.2-2024 — Learning and Employment Record Ecosystems",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An IEEE recommended practice for ecosystem-scale systems that issue, hold, present, and exchange Learning and Employment Records (LERs) representing education, skills, employment, and related achievements using interoperable digital credentials and shared services.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/ieee-1484-2-2024-learning-employment-record-ecosystems-1"
      },
      "gs:editorialExplanation": "LER ecosystems connect education and employment data across organizational boundaries, supporting portable records, skills-based hiring, career mobility, and learner-controlled exchange of verified achievements.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/standard"
      },
      "skos:altLabel": [
        "IEEE 1484.2",
        "LER Ecosystems"
      ]
    },
