    {
      "@id": "https://id.i2idl.org/concepts/equitable-co-design",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "equitable-co-design",
      "skos:prefLabel": "Equitable co-design",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "Co-design that deliberately lowers barriers to participation, includes underrepresented perspectives, accounts for intersecting identities and needs, and gives practitioners or users meaningful influence over design decisions.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/equitable-co-design-1"
      },
      "gs:editorialExplanation": "Equitable co-design treats participation, accessibility, autonomy, and representation as design conditions rather than as checks performed after a technology has been built.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/human-centered-design"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/practice"
      }
    },
