    {
      "@id": "https://id.i2idl.org/concepts/design-judgment",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "design-judgment",
      "skos:prefLabel": "Design judgment",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The reasoning used to determine why a design choice is appropriate in a particular situation, drawing on knowledge, experience, theory, and contextual factors.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/design-judgment-1"
      },
      "gs:editorialExplanation": "Design work rarely reduces to a fixed procedure. Judgment connects professional knowledge with the realities and constraints of a specific learning context.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-engineering"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
