          },
          "gs:sourceLabel": "UNESCO UIS National Education Statistical Capacity Assessment",
          "gs:evidenceRelation": "direct",
          "gs:citationDetail": "PDF p. 25 · report p. 28 — §1.1 The education data cycle — Data use",
          "schema:url": "https://tcg.uis.unesco.org/wp-content/uploads/sites/4/2025/02/LASER-2025-National-Education-Statistical-Capacity-Assessment-1.pdf#page=25"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/concepts/data-informed-decision-making",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "data-informed-decision-making",
      "skos:prefLabel": "Data-informed decision making",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A decision process that uses relevant data as evidence while also considering context, expertise, goals, and constraints.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/data-informed-decision-making-1"
      },
      "gs:editorialExplanation": "Data can improve decisions without pretending that metrics alone contain the full meaning of a learning situation.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-engineering"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/practice"
      }
    },
