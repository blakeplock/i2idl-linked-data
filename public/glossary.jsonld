          },
          "gs:sourceLabel": "The Science of Remote Learning",
          "gs:citationDetail": "How Do Learners Understand New Ideas · PDF p. 6",
          "schema:url": "https://openlearning.mit.edu/sites/default/files/inline-files/TheScienceofRemoteLearning.pdf#page=6",
          "gs:pdfPage": 6,
          "gs:host": "MIT Open Learning",
          "gs:evidenceRelation": "direct"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/concepts/working-memory",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "working-memory",
      "skos:prefLabel": "Working memory",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The limited-capacity memory system in which information is consciously processed before it may be encoded into long-term memory.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/working-memory-1"
      },
      "gs:editorialExplanation": "Because working memory is limited, excessive new information or unnecessary complexity can overwhelm learners and interfere with understanding.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-sciences"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
