        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A learning system that changes content, sequencing, support, feedback, or difficulty in response to evidence about a learner or context.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/adaptive-instructional-system-1"
      },
      "gs:editorialExplanation": "Adaptivity can make instruction more responsive, but it also increases the need for reliable data, transparent rules, and careful evaluation.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-engineering"
      },
      "gs:typeCollection": {
