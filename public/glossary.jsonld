    {
      "@id": "https://id.i2idl.org/concepts/ieee-9274-1-1-2023-xapi",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "ieee-9274-1-1-2023-xapi",
      "skos:prefLabel": "IEEE 9274.1.1-2023 — Experience API (xAPI)",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The IEEE standard for the xAPI data model and RESTful web service used to communicate learner and human-performance experience data between activities and a Learning Record Store (LRS). It standardizes the JSON-based model and service behavior derived from xAPI 1.0.3.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/ieee-9274-1-1-2023-xapi-1"
      },
      "gs:editorialExplanation": "xAPI provides a common way for heterogeneous learning, performance, simulation, mobile, and other systems to record and exchange experience data outside the boundaries of a single LMS.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/standard"
      },
