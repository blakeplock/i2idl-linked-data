          "gs:evidenceRelation": "direct"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/concepts/activity-profile-resource",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "activity-profile-resource",
      "skos:prefLabel": "Activity Profile Resource",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The xAPI resource at /activities/profile for storing and retrieving generic profile documents associated with an Activity.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/activity-profile-resource-1"
      },
      "gs:editorialExplanation": "Activity Profile documents let applications attach durable, application-specific information to an Activity without changing the Activity identifier or Statement model.",
      "gs:fieldCollection": {
