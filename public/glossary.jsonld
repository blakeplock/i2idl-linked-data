    {
      "@id": "https://id.i2idl.org/concepts/human-accountability-in-ai",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "human-accountability-in-ai",
      "skos:prefLabel": "Human accountability in AI",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The principle that people remain responsible for decisions and outcomes in human–AI decision loops and that accountability should not be transferred to an AI system.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/human-accountability-in-ai-1"
      },
      "gs:editorialExplanation": "In education, human accountability preserves teachers’ legitimate responsibility for pedagogical decisions, tool selection, assessment, and student support.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/ai-and-machine-learning"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      },
      "skos:altLabel": [
        "Human accountability"
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/human-accountability-in-ai-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "The principle that people remain responsible for decisions and outcomes in human–AI decision loops and that accountability should not be transferred to an AI system.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
      "gs:editorialStatus": "approved",
      "gs:definitionSequence": 1,
      "gs:evidence": [
        {
          "@type": "gs:Evidence",
