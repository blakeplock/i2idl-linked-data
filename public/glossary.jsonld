      ],
      "rdf:value": "The optional metadata object within an xAPI Activity that can describe its human-readable name, description, type, more-information location, interaction details, and extensions.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
