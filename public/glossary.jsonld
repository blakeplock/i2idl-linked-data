      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An IEEE standard defining an ECMAScript application programming interface for communication between learning content and a runtime service, typically supplied by a Learning Management System. It standardizes common API services used to exchange runtime learning data.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/ieee-1484-11-2-2020-ecmascript-runtime-api-1"
      },
      "gs:editorialExplanation": "The API gives browser-based learning content and LMS runtime services a common communication contract and reduces ambiguity in content-to-platform integration.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
      "gs:typeCollection": {
