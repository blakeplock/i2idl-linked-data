    {
      "@id": "https://id.i2idl.org/concepts/ai-for-professional-development",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "ai-for-professional-development",
      "skos:prefLabel": "AI for professional development",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The use of AI to support teachers’ lifelong professional learning, collaborative development, reflection, assessment of learning needs, and transformation of professional practice.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/ai-for-professional-development-1"
      },
      "gs:editorialExplanation": "AI can support professional growth when educators retain control over goals, judgement, collaboration, and the interpretation of recommendations or analytics.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/enterprise-and-governance"
      },
      "gs:typeCollection": {
