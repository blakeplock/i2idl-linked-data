      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The ability for users to adapt how a learning technology behaves or is configured to fit their needs, experience, context, or desired level of support.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/user-directed-customization-1"
      },
      "gs:editorialExplanation": "Customization can make a system useful across diverse learners and practitioners without assuming that one configuration or level of guidance will work for everyone.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/human-centered-design"
      },
