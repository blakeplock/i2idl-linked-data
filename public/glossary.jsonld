      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The stage of learning engineering in which a team frames the problem, context, stakeholders, constraints, and evidence before designing a solution.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/challenge-identification-1"
      },
      "gs:editorialExplanation": "Clear problem framing prevents teams from optimizing the wrong thing or treating a symptom as the underlying learning challenge.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-engineering"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/practice"
      }
