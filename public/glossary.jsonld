      "skos:definition": "In the xAPI Profile Server model, the RDF graph used to store a particular Profile version under that version’s URI so the version can be queried directly.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/named-graph-1"
      },
      "gs:editorialExplanation": "Profile Servers use named graphs to preserve and directly query individual historical Profile versions while keeping current versions available in the default graph.",
