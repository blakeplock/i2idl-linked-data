    {
      "@id": "https://id.i2idl.org/concepts/data-silo",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "data-silo",
      "skos:prefLabel": "Data silo",
