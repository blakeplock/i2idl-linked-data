    {
      "@id": "https://id.i2idl.org/concepts/safe-and-responsible-use-of-ai",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "safe-and-responsible-use-of-ai",
      "skos:prefLabel": "Safe and responsible use of AI",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The use of AI in ways that apply ethical rules, protect privacy and intellectual property, follow applicable legal requirements, mitigate bias and harm, and preserve human responsibility.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/safe-and-responsible-use-of-ai-1"
      },
      "gs:editorialExplanation": "Responsible educational use depends on both the characteristics of the AI system and the decisions made by the people and institutions using it.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/ai-and-machine-learning"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/practice"
      },
      "skos:altLabel": [
