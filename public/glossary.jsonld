    {
      "@id": "https://id.i2idl.org/concepts/equity",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "equity",
      "skos:prefLabel": "Equity",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The consideration of whether learning opportunities, technologies, processes, and outcomes fairly account for different needs and conditions.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/equity-1"
      },
      "gs:editorialExplanation": "A system can be technically functional while still distributing access, burden, or benefit unevenly across learners.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/enterprise-and-governance"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
