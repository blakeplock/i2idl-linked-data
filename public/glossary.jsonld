        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "A regional or international learning assessment that uses a common agreed framework and similar procedures across participating systems to produce comparable learning-outcome data.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
