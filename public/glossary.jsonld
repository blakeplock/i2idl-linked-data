      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An interdisciplinary field that studies how people learn and how learning can be supported across cognitive, social, motivational, cultural, and contextual dimensions.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/learning-sciences-1"
      },
      "gs:editorialExplanation": "Learning engineering uses findings from the learning sciences to inform design hypotheses and evaluation.",
