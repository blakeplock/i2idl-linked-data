    {
      "@id": "https://id.i2idl.org/concepts/ai-competency-framework-for-teachers-ai-cft",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "ai-competency-framework-for-teachers-ai-cft",
      "skos:prefLabel": "AI competency framework for teachers (AI CFT)",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A reference framework describing the knowledge, skills, values, and attitudes teachers need to use artificial intelligence safely, effectively, ethically, and in ways that preserve human-centred education.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/ai-competency-framework-for-teachers-ai-cft-1"
      },
      "gs:editorialExplanation": "An AI competency framework provides a structured basis for teacher preparation, professional learning, competency assessment, and the development of national or institutional expectations for AI use in education.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/ai-and-machine-learning"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/framework"
      },
      "skos:altLabel": [
        "AI CFT"
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/ai-competency-framework-for-teachers-ai-cft-1",
      "@type": [
        "prov:Entity",
