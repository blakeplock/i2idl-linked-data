    {
      "@id": "https://id.i2idl.org/concepts/adaptive-hypermedia",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "adaptive-hypermedia",
      "skos:prefLabel": "Adaptive hypermedia",
