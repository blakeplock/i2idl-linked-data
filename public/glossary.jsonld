    {
      "@id": "https://id.i2idl.org/concepts/user-tailored-privacy",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "user-tailored-privacy",
      "skos:prefLabel": "User-tailored privacy",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A privacy approach in which a system models an individual learner's privacy concerns and adapts privacy information, recommendations, or decision support to that user.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/user-tailored-privacy-1"
      },
      "gs:editorialExplanation": "It seeks a middle ground between giving learners no meaningful control and overwhelming them with too many settings and notices.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/enterprise-and-governance"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/system"
      }
    },
