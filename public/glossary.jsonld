    {
      "@id": "https://id.i2idl.org/concepts/ieee-1484-11-2-2020-ecmascript-runtime-api",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "ieee-1484-11-2-2020-ecmascript-runtime-api",
