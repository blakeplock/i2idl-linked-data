    {
      "@id": "https://id.i2idl.org/concepts/unesco-educational-planning",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "unesco-educational-planning",
      "skos:prefLabel": "Educational planning",
