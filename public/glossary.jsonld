        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An xAPI construct for storing document-style information about an Agent or Activity in name-and-document pairs meaningful to an instructional system component. It is distinct from an xAPI Profile.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/document-profile-resource-1"
      },
      "gs:editorialExplanation": "The distinction prevents confusion between profile documents used as storage and xAPI Profiles used to constrain vocabularies, templates, and patterns.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
