    {
      "@id": "https://id.i2idl.org/concepts/statement-result",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "statement-result",
      "skos:prefLabel": "Statement Result",
