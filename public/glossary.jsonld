      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "In the xAPI standard, an IRL is an IRI that can be translated to a URI that functions as a URL.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/internationalized-resource-locator-irl-1"
      },
      "gs:editorialExplanation": "xAPI distinguishes identifiers from locators because some identifiers merely name concepts while others can also be used to retrieve resources or metadata.",
