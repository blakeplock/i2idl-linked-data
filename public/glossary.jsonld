    {
      "@id": "https://id.i2idl.org/concepts/human-systems-integration-hsi",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "human-systems-integration-hsi",
      "skos:prefLabel": "Human-Systems Integration (HSI)",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A philosophy and set of processes for addressing human performance at the system level throughout design, development, operation, and the broader system lifecycle.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/human-systems-integration-hsi-1"
      },
      "gs:editorialExplanation": "HSI helps multidisciplinary teams treat people as integral system components and balance human needs with technology, organizational constraints, cost, and lifecycle risk.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/engineering-and-systems"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/practice"
      },
      "skos:altLabel": [
