    {
      "@id": "https://id.i2idl.org/concepts/ai-foundations-and-applications",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "ai-foundations-and-applications",
      "skos:prefLabel": "AI foundations and applications",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The conceptual knowledge and transferable operational skills needed to understand how AI works and to evaluate, select, use, adapt, or customize AI tools for appropriate purposes.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/ai-foundations-and-applications-1"
      },
      "gs:editorialExplanation": "AI competence requires more than operating a tool; it includes understanding technologies well enough to judge their capabilities, limitations, and appropriateness for context.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/ai-and-machine-learning"
      },
      "gs:typeCollection": {
