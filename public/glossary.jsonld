        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An IEEE standard defining a W3C XML Schema binding for the Learning Object Metadata (LOM) data model so LOM metadata instances can be encoded in XML and exchanged consistently between systems.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/ieee-1484-12-3-2020-xml-binding-learning-object-metadata-1"
      },
      "gs:editorialExplanation": "The binding turns the abstract LOM model into an interoperable XML representation that software can validate, exchange, and process consistently.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
