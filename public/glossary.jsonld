          "gs:citationDetail": "PDF p. 32 · report p. 33 — §4.2, competency 1.2 Human accountability",
          "schema:url": "https://www.unesco.org/en/articles/ai-competency-framework-teachers"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/concepts/human-agency-in-ai",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "human-agency-in-ai",
      "skos:prefLabel": "Human agency in AI",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The capacity of people to retain meaningful autonomy, judgement, and control when evaluating and using AI systems rather than allowing AI to displace human decision-making.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/human-agency-in-ai-1"
      },
      "gs:editorialExplanation": "Protecting human agency is especially important in education because AI can influence teaching, assessment, knowledge construction, and learner autonomy.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/ai-and-machine-learning"
      },
      "gs:typeCollection": {
