      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/data-ownership-1"
      },
      "gs:editorialExplanation": "As education systems collect more digital data, decisions about who controls that data and how it may be used become central governance questions.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/enterprise-and-governance"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
