    {
      "@id": "https://id.i2idl.org/concepts/whole-of-government-approach",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "whole-of-government-approach",
      "skos:prefLabel": "Whole-of-government approach",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An approach in which multiple government ministries and authorities coordinate around a shared policy or implementation challenge rather than treating it as the responsibility of a single agency.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/whole-of-government-approach-1"
      },
      "gs:editorialExplanation": "EdTech depends on issues such as education, telecommunications, finance, infrastructure, procurement, and data governance that cross institutional boundaries.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/enterprise-and-governance"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/practice"
      }
    },
    {
