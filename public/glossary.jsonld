      },
      "skos:definition": "An event associated with learning, broadly interpreted to include formal and informal experiences such as courses, reading, field experiences, self-directed work, or receiving a certificate.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/learning-experience-1"
      },
      "gs:editorialExplanation": "xAPI is intentionally designed to track learning beyond a single delivery system or course, so the broad meaning of “learning experience” sets the scope for what can be recorded.",
