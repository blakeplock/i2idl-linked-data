    {
      "@id": "https://id.i2idl.org/concepts/ieee-1484-20-3-2022-shareable-competency-definitions",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "ieee-1484-20-3-2022-shareable-competency-definitions",
      "skos:prefLabel": "IEEE 1484.20.3-2022 — Shareable Competency Definitions",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An IEEE standard defining a data model for describing, referencing, and sharing competency definitions, competency frameworks, and rubrics across learning, credentialing, workforce, and employment systems.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/ieee-1484-20-3-2022-shareable-competency-definitions-1"
      },
      "gs:editorialExplanation": "Common competency identifiers and structures let different systems refer to the same skills, knowledge, abilities, behaviors, and learning outcomes with consistent meaning.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/standard"
      },
      "skos:altLabel": [
