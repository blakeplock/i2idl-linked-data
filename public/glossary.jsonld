    {
      "@id": "https://id.i2idl.org/concepts/ieee-1484-20-2-2022-defining-competencies",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "ieee-1484-20-2-2022-defining-competencies",
      "skos:prefLabel": "IEEE 1484.20.2-2022 — Defining Competencies",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An IEEE recommended practice for defining competencies and competency frameworks, including the information needed to describe skills, knowledge, abilities, attitudes, habits of practice, behaviors, and learning outcomes in ways that can support interoperable data.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/ieee-1484-20-2-2022-defining-competencies-1"
      },
      "gs:editorialExplanation": "Technical interoperability depends on more than a data format. Organizations also need disciplined, understandable practices for deciding what competencies mean and how they should be defined and reused.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/standard"
      },
      "skos:altLabel": [
        "IEEE 1484.20.2",
        "Defining Competencies"
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/ieee-1484-20-2-2022-defining-competencies-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "An IEEE recommended practice for defining competencies and competency frameworks, including the information needed to describe skills, knowledge, abilities, attitudes, habits of practice, behaviors, and learning outcomes in ways that can support interoperable data.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
      "gs:editorialStatus": "approved",
