      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "The application of data and analytical findings to policy and programme development, resource allocation, planning, implementation, and other decisions intended to improve education.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
      "gs:editorialStatus": "approved",
      "gs:definitionSequence": 1,
      "gs:evidence": [
        {
          "@type": "gs:Evidence",
          "dcterms:source": {
            "@id": "https://id.i2idl.org/sources/unesco-uis-national-education-statistical-capacity-assessment",
            "dcterms:title": "UNESCO UIS National Education Statistical Capacity Assessment"
          },
          "prov:wasDerivedFrom": {
