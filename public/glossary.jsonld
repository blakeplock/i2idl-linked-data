        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/concepts/xapi-profile",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "xapi-profile",
      "skos:prefLabel": "xAPI Profile",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "Human- and/or machine-readable documentation of application-specific Concepts, Statement Templates, Patterns, and extensions used when implementing xAPI in a particular context.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
