    {
      "@id": "https://id.i2idl.org/concepts/xapi-duration",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "xapi-duration",
      "skos:prefLabel": "xAPI duration",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A duration value used in xAPI to represent elapsed time for an experience or result, formatted according to the ISO 8601 duration rules referenced by the standard.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/xapi-duration-1"
      },
      "gs:editorialExplanation": "Standardized duration values allow systems to exchange elapsed-time data without inventing incompatible local formats.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/data-and-instrumentation"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
