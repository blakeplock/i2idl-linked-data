          "gs:citationDetail": "Part Two §8.0 — Statement Template structural definition",
          "schema:url": "https://github.com/adlnet/xapi-profiles/blob/master/xapi-profiles-structure.md#statment-templates:~:text=A%20Statement%20Template%20describes%20one%20way%20Statements%20following%20the%20Profile%20may%20be%20structured."
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/concepts/statement-template-rule",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "statement-template-rule",
      "skos:prefLabel": "Statement Template rule",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A restriction in a Statement Template that identifies one or more Statement locations with JSONPath and constrains the values or presence allowed there.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/statement-template-rule-1"
      },
      "gs:editorialExplanation": "Template rules provide the fine-grained mechanism for expressing what a conformant Statement must include, exclude, or restrict.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/statement-template-rule-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "A restriction in a Statement Template that identifies one or more Statement locations with JSONPath and constrains the values or presence allowed there.",
