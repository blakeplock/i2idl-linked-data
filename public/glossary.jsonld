    {
      "@id": "https://id.i2idl.org/concepts/learning-engineering-team",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "learning-engineering-team",
      "skos:prefLabel": "Learning engineering team",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The person or interdisciplinary group assembled to address a learning challenge, with the mix of skills and knowledge determined by the problem, context, learners, stakeholders, and technical needs.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/learning-engineering-team-1"
      },
      "gs:editorialExplanation": "Learning engineering problems often cross disciplinary boundaries, so team composition should follow the challenge rather than a fixed job-title template.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-engineering"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      },
