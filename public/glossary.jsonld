      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An approach in which privacy protections are incorporated into a system's architecture and development process from the beginning rather than added after deployment.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/privacy-by-design-1"
      },
      "gs:editorialExplanation": "It helps learning systems avoid privacy becoming an afterthought represented only by complicated settings or policies that users cannot realistically manage.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/enterprise-and-governance"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/practice"
