    {
      "@id": "https://id.i2idl.org/concepts/continuous-improvement",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "continuous-improvement",
      "skos:prefLabel": "Continuous improvement",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An ongoing practice of using evidence and feedback to refine learning experiences, systems, processes, and operations over time.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/continuous-improvement-1"
      },
      "gs:editorialExplanation": "Learning conditions change, so effective systems need mechanisms for learning from use rather than assuming the first release is final.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-engineering"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/practice"
      }
    },
