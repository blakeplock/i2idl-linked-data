      },
      "skos:definition": "The system of memory that supports durable storage and later retrieval of knowledge and skills over extended periods.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/long-term-memory-1"
