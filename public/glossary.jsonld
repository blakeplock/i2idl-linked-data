    },
    {
      "@id": "https://id.i2idl.org/concepts/education-data-cycle",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "education-data-cycle",
      "skos:prefLabel": "Education data cycle",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A recurring sequence in which education data is produced and made available, reported and shared, analyzed, and then used to inform decisions and further data needs.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/education-data-cycle-1"
      },
      "gs:editorialExplanation": "The cycle emphasizes that collecting data is only one stage of an effective data system; value emerges when data moves through reporting, analysis, and use.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/data-and-instrumentation"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/education-data-cycle-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "A recurring sequence in which education data is produced and made available, reported and shared, analyzed, and then used to inform decisions and further data needs.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
      "gs:editorialStatus": "approved",
      "gs:definitionSequence": 1,
      "gs:evidence": [
        {
          "@type": "gs:Evidence",
          "dcterms:source": {
            "@id": "https://id.i2idl.org/sources/unesco-uis-national-education-statistical-capacity-assessment",
            "dcterms:title": "UNESCO UIS National Education Statistical Capacity Assessment"
          },
          "prov:wasDerivedFrom": {
            "@id": "https://id.i2idl.org/sources/unesco-uis-national-education-statistical-capacity-assessment"
          },
          "gs:sourceLabel": "UNESCO UIS National Education Statistical Capacity Assessment",
          "gs:evidenceRelation": "direct",
          "gs:citationDetail": "PDF p. 24 · report p. 27 — §1.1 The education data cycle — Figure 1.1 and four-component description",
          "schema:url": "https://tcg.uis.unesco.org/wp-content/uploads/sites/4/2025/02/LASER-2025-National-Education-Statistical-Capacity-Assessment-1.pdf#page=24"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/concepts/education-data-ecosystem",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "education-data-ecosystem",
      "skos:prefLabel": "Education data ecosystem",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The interconnected set of data sources, production and reporting processes, analytical practices, institutions, and uses that together support evidence-based decision-making in an education system.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/education-data-ecosystem-1"
      },
      "gs:editorialExplanation": "Viewing education data as an ecosystem shifts attention from isolated datasets to the relationships among production, sharing, analysis, governance, and policy use.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/data-and-instrumentation"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/system"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/education-data-ecosystem-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "The interconnected set of data sources, production and reporting processes, analytical practices, institutions, and uses that together support evidence-based decision-making in an education system.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
      "gs:editorialStatus": "approved",
      "gs:definitionSequence": 1,
