    {
      "@id": "https://id.i2idl.org/concepts/cognitive-engagement",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "cognitive-engagement",
      "skos:prefLabel": "Cognitive engagement",
