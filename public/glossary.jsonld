    {
      "@id": "https://id.i2idl.org/concepts/ethics-by-design",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "ethics-by-design",
      "skos:prefLabel": "Ethics by design",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An approach in which ethical requirements are intentionally built into the design and validation of AI systems rather than addressed only after deployment.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/ethics-by-design-1"
      },
      "gs:editorialExplanation": "Embedding ethical requirements before adoption can reduce risks to human rights, safety, privacy, inclusion, and accountability in educational settings.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/ai-and-machine-learning"
      },
