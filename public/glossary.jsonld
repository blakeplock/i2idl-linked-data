      "skos:definition": "A persistent networked environment in which people are represented through avatars and interact with one another and the environment through computers.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/virtual-world-1"
      },
      "gs:editorialExplanation": "Virtual worlds expand digital learning beyond content delivery into social, spatial, and experiential environments.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/engineering-and-systems"
      },
