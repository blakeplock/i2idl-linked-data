    {
      "@id": "https://id.i2idl.org/concepts/privacy-by-design",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "privacy-by-design",
      "skos:prefLabel": "Privacy by design",
