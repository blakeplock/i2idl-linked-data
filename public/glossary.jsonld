    {
      "@id": "https://id.i2idl.org/concepts/maturity-model",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "maturity-model",
      "skos:prefLabel": "Maturity model",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A staged framework used to assess current capability and guide incremental improvement over time rather than treating compliance with the highest level as the sole objective.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/maturity-model-1"
      },
      "gs:editorialExplanation": "Maturity models provide a structured way to identify current strengths and weaknesses, prioritize investment, and plan progressive capability development.",
      "gs:fieldCollection": {
