    {
      "@id": "https://id.i2idl.org/concepts/accessibility-and-inclusivity-testing",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "accessibility-and-inclusivity-testing",
      "skos:prefLabel": "Accessibility and inclusivity testing",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "Testing that checks whether a learning solution can be used by people with different abilities, access needs, contexts, and constraints.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/accessibility-and-inclusivity-testing-1"
      },
      "gs:editorialExplanation": "It helps teams identify barriers before they become embedded in production systems or learning programs.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/human-centered-design"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/method"
      }
    },
