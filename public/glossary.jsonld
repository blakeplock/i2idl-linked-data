    {
      "@id": "https://id.i2idl.org/concepts/ieee-2955-2025-self-learning-tutorials-side-by-side-learning",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "ieee-2955-2025-self-learning-tutorials-side-by-side-learning",
      "skos:prefLabel": "IEEE 2955-2025 — Self-Learning Tutorials and Side-by-Side Learning",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An IEEE recommended practice describing methods for creating self-learning tutorials, including screencast-based and spoken tutorials, with guidance for side-by-side learning techniques.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/ieee-2955-2025-self-learning-tutorials-side-by-side-learning-1"
      },
      "gs:editorialExplanation": "It gives tutorial creators a common, standards-based methodology for designing instructional experiences that learners can follow independently while working alongside the demonstrated task.",
      "gs:fieldCollection": {
