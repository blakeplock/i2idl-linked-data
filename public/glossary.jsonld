    {
      "@id": "https://id.i2idl.org/concepts/account-object",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "account-object",
      "skos:prefLabel": "Account Object",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An xAPI identity structure that represents an Agent or Group through an account on an existing system using a home page for the account system and a unique account name.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/account-object-1"
      },
      "gs:editorialExplanation": "Account Objects provide a way to identify Actors when an email address or OpenID is not appropriate, while keeping the identity tied to a known account namespace.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/data-and-instrumentation"
      },
