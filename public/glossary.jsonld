    {
      "@id": "https://id.i2idl.org/concepts/ieee-1589-2020-ar-learning-experience-model",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "ieee-1589-2020-ar-learning-experience-model",
      "skos:prefLabel": "IEEE 1589-2020 — Augmented Reality Learning Experience Model",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An IEEE standard for interoperable augmented-reality learning systems. It defines a conceptual model for relationships among the physical world, the learner, digital information, learning activities, and the environment, along with data models and XML/JSON bindings for representing activities and context.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/ieee-1589-2020-ar-learning-experience-model-1"
      },
      "gs:editorialExplanation": "A common AR learning model supports reusable content, interchangeable components, experience repositories, and learning experiences that can move across otherwise proprietary AR platforms.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/standard"
      },
