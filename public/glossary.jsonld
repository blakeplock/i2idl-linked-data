        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The advanced AI competency level in which teachers critically and creatively configure, adapt, or co-create AI-enabled approaches, tools, policies, and pedagogical practices for educational transformation.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/create-ai-competency-level-1"
      },
      "gs:editorialExplanation": "Create emphasizes expert judgement, innovation, ethical co-creation, and adaptation to local educational needs rather than simple tool proficiency.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/ai-and-machine-learning"
      },
      "gs:typeCollection": {
