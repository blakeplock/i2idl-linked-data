      },
      "skos:definition": "An xAPI representation of an individual Actor, identified through one of the identity properties defined by the standard and optionally accompanied by a name.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/xapi-agent-1"
      },
      "gs:editorialExplanation": "Agents are the basic individual identity object in xAPI and are used as Actors, Objects, Authorities, and contextual participants.",
