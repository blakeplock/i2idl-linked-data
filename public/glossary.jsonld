    },
    {
      "@id": "https://id.i2idl.org/concepts/statement-immutability",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "statement-immutability",
      "skos:prefLabel": "Statement immutability",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The xAPI principle that key semantic parts of a Statement are not changed after the Statement has been stored. The standard identifies specific properties that are immutable and others that may differ without changing the Statement’s essential meaning.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/statement-immutability-1"
      },
      "gs:editorialExplanation": "Immutability allows Statements to be shared between LRSs while preserving the evidence they represent and reduces ambiguity about whether two copies describe the same event.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/data-and-instrumentation"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/practice"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/statement-immutability-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "The xAPI principle that key semantic parts of a Statement are not changed after the Statement has been stored. The standard identifies specific properties that are immutable and others that may differ without changing the Statement’s essential meaning.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
      "gs:editorialStatus": "approved",
      "gs:definitionSequence": 1,
      "gs:evidence": [
        {
          "@type": "gs:Evidence",
          "dcterms:source": {
            "@id": "https://id.i2idl.org/sources/ieee-xapi-base-standard",
            "dcterms:title": "IEEE xAPI Base Standard"
