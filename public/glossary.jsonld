    {
      "@id": "https://id.i2idl.org/concepts/leed-tracker",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "leed-tracker",
      "skos:prefLabel": "Learning Engineering Evidence and Decision (LEED) tracker",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A learning-engineering documentation structure for recording design decisions, related justifications, sources of influence, and revisions in connection with the learning engineering process.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/leed-tracker-1"
      },
      "gs:editorialExplanation": "The tracker externalizes design reasoning so teams can communicate, revisit decisions, support iteration, and study authentic design work without relying only on retrospective recall.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-engineering"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/system"
      },
      "skos:altLabel": [
        "LEED tracker"
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/leed-tracker-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "A learning-engineering documentation structure for recording design decisions, related justifications, sources of influence, and revisions in connection with the learning engineering process.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
      "gs:editorialStatus": "approved",
      "gs:definitionSequence": 1,
      "gs:evidence": [
        {
          "@type": "gs:Evidence",
          "dcterms:source": {
            "@id": "https://id.i2idl.org/sources/learning-engineering-design-decision-tracking",
            "dcterms:title": "Exploring Learning Engineering Design Decision Tracking"
          },
          "prov:wasDerivedFrom": {
            "@id": "https://id.i2idl.org/sources/learning-engineering-design-decision-tracking"
          },
          "gs:sourceLabel": "Learning Engineering Design Decision Tracking",
          "gs:citationDetail": "Introduction and Implications; structure and purpose of the LEED tracker; PDF pp. 2-3, 12",
          "schema:url": "https://link.springer.com/content/pdf/10.1007/s11528-025-01076-y.pdf#page=2",
          "gs:pdfPage": 2,
          "gs:host": "Springer",
          "gs:evidenceRelation": "direct"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/concepts/learning-engineering-process",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "learning-engineering-process",
      "skos:prefLabel": "Learning engineering process",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An iterative, concurrent process for addressing learning challenges by framing the context and stakeholders, creating and instrumenting a solution, implementing it in authentic settings, investigating outcomes with data, and refining the work continuously.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/learning-engineering-process-1"
      },
      "gs:editorialExplanation": "It organizes learning engineering as an evidence-producing cycle rather than a one-way sequence, so design, implementation, and investigation can inform one another throughout the work.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-engineering"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/method"
      },
      "skos:altLabel": [
        "LE process"
      ]
    },
