    {
      "@id": "https://id.i2idl.org/concepts/human-centred-approach-to-ai",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "human-centred-approach-to-ai",
      "skos:prefLabel": "Human-centred approach to AI",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An approach to AI that places human capacities, rights, inclusion, safety, accountability, and sustainable development at the centre of the design, selection, use, and monitoring of AI systems.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/human-centred-approach-to-ai-1"
      },
      "gs:editorialExplanation": "In education, a human-centred approach keeps AI subordinate to educational and human purposes rather than allowing technical capability alone to determine practice.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/ai-and-machine-learning"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/practice"
      },
      "skos:altLabel": [
        "Human-centered approach to AI"
      ]
    },
