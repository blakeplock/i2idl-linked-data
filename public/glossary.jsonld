      "skos:definition": "The optional xAPI Statement component used to add surrounding information about an experience, such as registration, related activities, relevant Agents or Groups, language, platform, another Statement, or extensions.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/context-object-1"
      },
      "gs:editorialExplanation": "Context lets the same core Actor-Verb-Object event be interpreted within a broader learning, organizational, technical, or situational setting.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/data-and-instrumentation"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
