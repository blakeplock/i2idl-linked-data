    {
      "@id": "https://id.i2idl.org/concepts/adaptive-instructional-system",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "adaptive-instructional-system",
      "skos:prefLabel": "Adaptive instructional system",
