      "skos:definition": "Learning delivered beyond a single physical classroom through distributed technologies and environments, including distance education, online learning, simulations, mobile learning, and other network-enabled experiences.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/distributed-learning-1"
