    {
      "@id": "https://id.i2idl.org/concepts/experiential-learning",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "experiential-learning",
      "skos:prefLabel": "Experiential learning",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "Learning in which knowledge is created through experience and reflection, often described as a recursive process of experiencing, reflecting, thinking, and acting.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/experiential-learning-1"
      },
      "gs:editorialExplanation": "It provides a foundation for designing practice-rich learning that connects action to interpretation and transfer.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-sciences"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
