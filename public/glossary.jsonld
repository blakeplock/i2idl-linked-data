      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "Learning delivered in small, focused units that are often self-paced, flexible, and designed for use near the moment of need.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/microlearning-1"
      },
      "gs:editorialExplanation": "Microlearning is useful when learners need targeted refreshers or short learning episodes that fit into work and daily activity.",
