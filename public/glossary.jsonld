    {
      "@id": "https://id.i2idl.org/concepts/yerkes-dodson-law",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "yerkes-dodson-law",
      "skos:prefLabel": "Yerkes-Dodson law",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A principle describing how performance can vary with arousal or stress, often represented as an inverted-U relationship whose optimal level depends on task characteristics.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/yerkes-dodson-law-1"
      },
      "gs:editorialExplanation": "It is a reminder that too little or too much stress can affect performance and that difficulty should be designed with context in mind.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-sciences"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/yerkes-dodson-law-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "A principle describing how performance can vary with arousal or stress, often represented as an inverted-U relationship whose optimal level depends on task characteristics.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
      "gs:editorialStatus": "approved",
      "gs:definitionSequence": 1,
      "gs:evidence": [
        {
          "@type": "gs:Evidence",
          "dcterms:source": {
            "@id": "https://id.i2idl.org/sources/lebok",
            "dcterms:title": "Learning Engineering Body of Knowledge (LeBOK)"
          },
          "prov:wasDerivedFrom": {
            "@id": "https://id.i2idl.org/sources/lebok"
          },
