    },
    {
      "@id": "https://id.i2idl.org/concepts/education-data-integration",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "education-data-integration",
      "skos:prefLabel": "Education data integration",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The combination and linkage of data from different education and related sources to create a more coherent view, fill information gaps, and support analysis that a single source cannot provide.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/education-data-integration-1"
      },
      "gs:editorialExplanation": "Integrated data can connect administrative records, assessments, surveys, finance, and other sources to answer policy questions that span institutional and data boundaries.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/data-and-instrumentation"
