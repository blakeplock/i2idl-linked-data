    {
      "@id": "https://id.i2idl.org/concepts/whole-person-development",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "whole-person-development",
      "skos:prefLabel": "Whole-person development",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An approach to development that treats cognitive, social, emotional, and physical capabilities as interconnected parts of learning across a person's life.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/whole-person-development-1"
      },
      "gs:editorialExplanation": "Whole-person development broadens learning goals beyond academic knowledge and recognizes capabilities such as resilience, self-regulation, communication, and physical readiness.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-sciences"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
