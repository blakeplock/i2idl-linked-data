        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/concepts/xapi-pattern",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "xapi-pattern",
      "skos:prefLabel": "xAPI Pattern",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A description of groups of xAPI Statements that match particular Statement Templates and are arranged according to specified ordering structures.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/xapi-pattern-1"
      },
      "gs:editorialExplanation": "Patterns let a Profile describe how multiple Statements relate over time, such as the sequence of interactions that make up a larger learning or performance process.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
      "gs:typeCollection": {
