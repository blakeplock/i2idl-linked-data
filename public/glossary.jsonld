    {
      "@id": "https://id.i2idl.org/concepts/ieee-1484-11-1-2022-content-object-communication",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "ieee-1484-11-1-2022-content-object-communication",
      "skos:prefLabel": "IEEE 1484.11.1-2022 — Data Model for Content Object Communication",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An IEEE standard defining the data model used to exchange learner, interaction, objective, status, timing, preference, and score information between a learning content object and a runtime service, typically within an LMS environment.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/ieee-1484-11-1-2022-content-object-communication-1"
      },
      "gs:editorialExplanation": "The standard provides a common runtime data model for LMS-delivered content and forms part of the technical foundation associated with SCORM-style content-to-platform communication.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
