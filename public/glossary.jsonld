    {
      "@id": "https://id.i2idl.org/concepts/ai-competency-progression",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "ai-competency-progression",
      "skos:prefLabel": "AI competency progression",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A scaffolded reference pathway for developing AI competency across increasing levels of capability without assuming that development is strictly linear or identical across competency areas.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/ai-competency-progression-1"
      },
      "gs:editorialExplanation": "Progression models help organizations plan development and assess growth while recognizing that people can be more advanced in some aspects of AI competency than others.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/enterprise-and-governance"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/framework"
      },
      "skos:altLabel": [
        "AI CFT progression"
      ]
    },
