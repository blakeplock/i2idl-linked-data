          "schema:url": "https://github.com/adlnet/xapi-profiles/blob/master/xapi-profiles-structure.md#using-prof-statements:~:text=Learning%20Record%20Providers%20authoring%20Statements%20that%20conform%20to%20matching%20Profile-described%20Statement%20Templates%20and%20Patterns%20SHOULD%20include%20the%20most%20up-to-date%20conformant%20Profile%20version"
        }
