      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The core xAPI data structure used to represent an experience, typically centered on an actor, verb, and object with optional context, result, authority, and attachments.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/xapi-statement-1"
      },
      "gs:editorialExplanation": "Statements provide a shared event model that can represent learning and performance activity across many systems.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/standard"
