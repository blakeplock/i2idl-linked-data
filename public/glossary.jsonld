    {
      "@id": "https://id.i2idl.org/concepts/design-revision",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "design-revision",
      "skos:prefLabel": "Design revision",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A change to something previously decided or to an existing element of a learning design.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/design-revision-1"
      },
      "gs:editorialExplanation": "Revisions make iteration visible. Tracking them connects changes to the evidence, experience, requirements, technology, or context that prompted reconsideration.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/learning-engineering"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/practice"
      },
      "skos:altLabel": [
        "revision decision"
      ]
    },
