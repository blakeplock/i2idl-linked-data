    {
      "@id": "https://id.i2idl.org/concepts/activity",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "activity",
      "skos:prefLabel": "Activity",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "In xAPI, an Activity is something an Actor interacts with or experiences and that can serve as the object of a tracked Statement. Activities can represent instruction, performance, experiences, resources, events, or even physical or virtual objects.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/activity-1"
      },
      "gs:editorialExplanation": "Activities are the primary way xAPI identifies what an experience was about, allowing the same model to describe learning across courses, simulations, work, media, and real-world events.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/concept"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/activity-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "In xAPI, an Activity is something an Actor interacts with or experiences and that can serve as the object of a tracked Statement. Activities can represent instruction, performance, experiences, resources, events, or even physical or virtual objects.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
      "gs:editorialStatus": "approved",
      "gs:definitionSequence": 1,
      "gs:evidence": [
        {
          "@type": "gs:Evidence",
          "dcterms:source": {
            "@id": "https://id.i2idl.org/sources/ieee-xapi-base-standard",
            "dcterms:title": "IEEE xAPI Base Standard"
          },
          "prov:wasDerivedFrom": {
            "@id": "https://id.i2idl.org/sources/ieee-xapi-base-standard"
          },
          "gs:sourceLabel": "IEEE xAPI Base Standard",
          "gs:citationDetail": "IEEE 9274.1.1-2023 §3.1 — Definitions: Activity",
          "schema:url": "https://opensource.ieee.org/xapi/xapi-base-standard-documentation/-/blob/main/9274.1.1%20xAPI%20Base%20Standard%20Overview.md#31-definitions",
          "gs:evidenceRelation": "direct"
        },
        {
          "@type": "gs:Evidence",
          "dcterms:source": {
            "@id": "https://id.i2idl.org/sources/ieee-xapi-base-standard",
            "dcterms:title": "IEEE xAPI Base Standard"
          },
          "prov:wasDerivedFrom": {
            "@id": "https://id.i2idl.org/sources/ieee-xapi-base-standard"
          },
