    {
      "@id": "https://id.i2idl.org/concepts/human-controlled-ai-in-education",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "human-controlled-ai-in-education",
      "skos:prefLabel": "Human-controlled AI in education",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The principle that the selection, use, monitoring, and consequential decisions involving AI remain under meaningful human control and human accountability.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/human-controlled-ai-in-education-1"
      },
      "gs:editorialExplanation": "Human control helps prevent AI systems from displacing legitimate educational judgement or obscuring responsibility for decisions affecting learners.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/ai-and-machine-learning"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/principle"
      },
      "skos:altLabel": [
        "Human-controlled AI"
      ]
    },
