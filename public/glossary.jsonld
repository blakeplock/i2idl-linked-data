          "schema:url": "https://github.com/adlnet/xapi-profiles/blob/master/xapi-profiles-structure.md#statement-template-rules:~:text=Statement%20Template%20Rules%20describe%20a%20location%20or%20locations%20within%20Statements%20using%20JSONPath%2C%20then%20describe%20the%20restrictions%20on%20the%20value%28s%29%20there"
        }
      ]
    },
    {
      "@id": "https://id.i2idl.org/concepts/statement-template-validation",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "statement-template-validation",
      "skos:prefLabel": "Statement Template validation",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "The process of validating a Statement against a Profile’s Statement Templates to determine which templates match and whether the matching templates’ rules are satisfied.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/statement-template-validation-1"
      },
      "gs:editorialExplanation": "Template validation provides a repeatable way to verify that Statement structure follows the interoperability rules expressed by a Profile.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/process"
      }
