      },
      "skos:definition": "Mental effort caused by features of a task or presentation that do not directly support the learning goal.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/extraneous-cognitive-load-1"
      },
      "gs:editorialExplanation": "Reducing unnecessary complexity can preserve cognitive resources for understanding, practice, and problem solving.",
