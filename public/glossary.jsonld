      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/learner-privacy-1"
      },
      "gs:editorialExplanation": "Digital learning systems can observe detailed behavior across contexts, so privacy affects trust, adoption, personalization, and the legitimacy of data use.",
