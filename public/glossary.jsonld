    {
      "@id": "https://id.i2idl.org/concepts/ieee-2881-2025-learning-metadata-terms",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "ieee-2881-2025-learning-metadata-terms",
      "skos:prefLabel": "IEEE 2881-2025 — Learning Metadata Terms",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "An IEEE learning technology standard that defines an extensible set of metadata classes and properties for describing learning resources and learning events. Its model is designed to align with Resource Description Framework (RDF) approaches and can be represented in graph-oriented and other formats.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/ieee-2881-2025-learning-metadata-terms-1"
      },
      "gs:editorialExplanation": "Shared metadata terms make learning resources and events easier to describe, discover, exchange, connect, and reuse across systems without forcing every platform to invent its own vocabulary.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/standards-and-interoperability"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/standard"
      },
      "skos:altLabel": [
        "IEEE 2881",
        "Learning Metadata"
      ]
    },
    {
      "@id": "https://id.i2idl.org/definitions/ieee-2881-2025-learning-metadata-terms-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "An IEEE learning technology standard that defines an extensible set of metadata classes and properties for describing learning resources and learning events. Its model is designed to align with Resource Description Framework (RDF) approaches and can be represented in graph-oriented and other formats.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
      "gs:editorialStatus": "approved",
      "gs:definitionSequence": 1,
