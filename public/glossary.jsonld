    {
      "@id": "https://id.i2idl.org/concepts/a-b-testing",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm"
      ],
      "dcterms:identifier": "a-b-testing",
      "skos:prefLabel": "A/B testing",
      "skos:inScheme": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "schema:inDefinedTermSet": {
        "@id": "https://id.i2idl.org/scheme"
      },
      "skos:definition": "A controlled comparison in which two versions of a learning experience, interface, message, or intervention are presented to different groups so their effects can be compared.",
      "gs:editorialStatus": "approved",
      "gs:activeDefinition": {
        "@id": "https://id.i2idl.org/definitions/a-b-testing-1"
      },
      "gs:editorialExplanation": "It gives learning teams a practical way to test design assumptions with evidence instead of relying only on preference or intuition.",
      "gs:fieldCollection": {
        "@id": "https://id.i2idl.org/collections/field/human-centered-design"
      },
      "gs:typeCollection": {
        "@id": "https://id.i2idl.org/collections/type/method"
      }
    },
    {
      "@id": "https://id.i2idl.org/definitions/a-b-testing-1",
      "@type": [
        "prov:Entity",
        "gs:Definition"
      ],
      "rdf:value": "A controlled comparison in which two versions of a learning experience, interface, message, or intervention are presented to different groups so their effects can be compared.",
      "dcterms:language": "en",
      "dcterms:creator": {
        "@id": "https://www.i2idl.org/"
      },
      "gs:editorialStatus": "approved",
      "gs:definitionSequence": 1,
      "gs:evidence": [
        {
          "@type": "gs:Evidence",
          "dcterms:source": {
            "@id": "https://id.i2idl.org/sources/lebok",
            "dcterms:title": "Learning Engineering Body of Knowledge (LeBOK)"
          },
          "prov:wasDerivedFrom": {
            "@id": "https://id.i2idl.org/sources/lebok"
          },
          "gs:sourceLabel": "LeBOK",
          "gs:evidenceRelation": "direct",
